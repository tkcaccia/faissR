#!/bin/sh

set -eu

. ./src/build-faiss.sh
faissr_source_mode "$@"
faiss_bundled=0
faiss_cppflags=""
faiss_windows=1
faiss_r_bin="${R_HOME:?R_HOME must identify the active R}/bin${R_ARCH:-}/R.exe"
if [ ! -x "$faiss_r_bin" ]; then faiss_r_bin="$R_HOME/bin/R.exe"; fi

write_diagnostic_makevars() {
  cat > src/Makevars.win <<EOF
CXX_STD = CXX20
PKG_CXXFLAGS = \$(SHLIB_OPENMP_CXXFLAGS)
PKG_CPPFLAGS = -DFAISSR_WINDOWS_NO_FAISS -DFAISSR_NO_FORTRAN_NN
PKG_LIBS = \$(SHLIB_OPENMP_CXXFLAGS)
OBJECTS = RcppExports.o embedding_utils.o nn.o nn_auto_select.o nn_faiss_bridge.o nn_faiss_stub.o nn_cuvs_bridge.o nn_cuvs_stub.o nn_cuda_bridge.o nn_cuda_stub.o
EOF
}

faiss_prefix=${FAISS_HOME:-${CONDA_PREFIX:-}}
faiss_include=${INCLUDE_DIR:-}
faiss_libdir=${LIB_DIR:-}

if [ "$faiss_source_mode" = none ]; then
  echo "Explicit diagnostic-only Windows build: FAISS is disabled." >&2
  write_diagnostic_makevars
  exit 0
fi
faissr_configure_openmp
if [ "$faiss_source_mode" = bundled ]; then
  faiss_prefix=""
  faiss_include=""
  faiss_libdir=""
fi

if { [ -n "$faiss_include" ] && [ -z "$faiss_libdir" ]; } || \
   { [ -z "$faiss_include" ] && [ -n "$faiss_libdir" ]; }; then
  echo "INCLUDE_DIR and LIB_DIR must be supplied together." >&2
  exit 1
fi

if [ -z "$faiss_include" ] && [ -z "$faiss_libdir" ] && \
   [ -n "$faiss_prefix" ]; then
  for candidate in "$faiss_prefix/include" "$faiss_prefix/Library/include"; do
    if [ -f "$candidate/faiss/IndexFlat.h" ]; then
      faiss_include=$candidate
      break
    fi
  done

  for candidate in \
    "$faiss_prefix/lib" \
    "$faiss_prefix/lib64" \
    "$faiss_prefix/Library/lib"; do
    if [ -f "$candidate/libfaiss.a" ]; then
      faiss_libdir=$candidate
      break
    fi
  done
fi

if [ -n "$faiss_include" ] && [ -n "$faiss_libdir" ]; then
  faiss_cppflags="-I\"$faiss_include\""
  faiss_libs="\"$faiss_libdir/libfaiss.a\""
  if ! faissr_probe_library; then
    if [ "$faiss_source_mode" = system ] || \
       [ -n "${FAISSR_NUMERICAL_LIBS:-}" ]; then
      echo "The requested installed FAISS/numerical libraries are unusable." >&2
      exit 1
    fi
    echo "Installed FAISS is unsuitable; trying the bundled CPU source."
    faiss_include=""
    faiss_libdir=""
  fi
fi
if [ -z "$faiss_include" ] || [ -z "$faiss_libdir" ]; then
  if [ "$faiss_source_mode" != system ]; then
    faissr_build_bundled
    faiss_include="$faiss_source_dir"
    faiss_libdir="$faiss_source_dir"
    if ! faissr_probe_library; then
      echo "Complete Rtools-compatible LP64 BLAS/LAPACK are required." >&2
      echo "Set FAISSR_NUMERICAL_LIBS for a nonstandard prefix; see config.log." >&2
      exit 1
    fi
  else
    echo "No Rtools-compatible static FAISS was found (--with-faiss=system)." >&2
    echo "Use --with-faiss=auto or bundled to compile the included CPU source." >&2
    exit 1
  fi
fi

if [ -n "$faiss_include" ] && [ -n "$faiss_libdir" ]; then
  cat > src/Makevars.win <<EOF
CXX_STD = CXX20
PKG_CXXFLAGS = \$(SHLIB_OPENMP_CXXFLAGS) $extra_cxxflags
PKG_CPPFLAGS = -DFAISSR_HAS_FAISS -DFAISSR_NO_FORTRAN_NN -I"$faiss_include" $faiss_cppflags
PKG_LIBS = \$(SHLIB_OPENMP_CXXFLAGS) $faiss_openmp_flags $faiss_libs $faiss_numerical_libs \$(LAPACK_LIBS) \$(BLAS_LIBS) \$(FLIBS)
OBJECTS = RcppExports.o embedding_utils.o nn.o nn_auto_select.o faissr_console.o nn_faiss_bridge.o nn_faiss_impl.o nn_cuvs_bridge.o nn_cuvs_stub.o nn_cuda_bridge.o nn_cuda_stub.o
EOF
  echo "Windows CPU FAISS build enabled from $faiss_libdir." >&2
  exit 0
fi
