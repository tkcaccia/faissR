#!/bin/sh

set -eu

# System-library metadata follows the common R "anticonf" convention. These
# names are used only in diagnostics; configure never invokes a package manager.
PKG_CONFIG_NAME="faiss"
PKG_DEB_NAME="libfaiss-dev libblas-dev liblapack-dev"
PKG_RPM_NAME="faiss-devel blas-devel lapack-devel"
PKG_APK_NAME="no generally available FAISS development package"
PKG_TEST_HEADER="<faiss/IndexFlat.h>"
PKG_LIBS="-lfaiss"
PKG_CFLAGS=""

wasm_build=0
require_faiss=${FAISSR_REQUIRE_FAISS:-0}
for arg in "$@"; do
  case "$arg" in
    --host=wasm32-*|--host=*emscripten*)
      wasm_build=1
      ;;
  esac
done

write_diagnostic_makevars() {
  diagnostic_cppflags=$1
  {
    echo "CXX_STD = CXX20"
    echo "PKG_CXXFLAGS ="
    echo "PKG_CPPFLAGS = $diagnostic_cppflags"
    echo "PKG_LIBS ="
    echo "OBJECTS = RcppExports.o embedding_utils.o nn.o nn_auto_select.o nn_fortran.o nn_faiss_bridge.o nn_faiss_stub.o nn_cuvs_bridge.o nn_cuvs_stub.o nn_cuda_bridge.o nn_cuda_stub.o"
  } > src/Makevars
}

if [ "$wasm_build" = "1" ]; then
  if [ "$require_faiss" = "1" ]; then
    echo "FAISSR_REQUIRE_FAISS=1, but FAISS is unavailable for webR/WebAssembly." >&2
    exit 1
  fi
  echo "WebAssembly target detected: building faissR with diagnostic stubs." >&2
  echo "Native FAISS/CUDA/cuVS libraries are not available for webR/WebAssembly;" >&2
  echo "native Linux/macOS builds still require FAISS." >&2
  write_diagnostic_makevars "-DFAISSR_WASM_UNSUPPORTED"
  exit 0
fi

config_log="$(pwd)/config.log"
printf '%s\n' 'faissR native configuration probes' > "$config_log"

require_cuda=${FAISSR_REQUIRE_CUDA:-0}
skip_cuda_runtime_check=${FAISSR_SKIP_CUDA_RUNTIME_CHECK:-0}
case "$skip_cuda_runtime_check" in
  0|1) ;;
  *)
    echo "FAISSR_SKIP_CUDA_RUNTIME_CHECK must be 0 or 1." >&2
    exit 1
    ;;
esac
if [ "${FAISSR_REQUIRE_CUDA_RUNTIME+x}" = "x" ]; then
  echo "FAISSR_REQUIRE_CUDA_RUNTIME is deprecated." >&2
  echo "FAISSR_REQUIRE_CUDA=1 now includes CUDA runtime validation." >&2
  if [ "${FAISSR_REQUIRE_CUDA_RUNTIME:-0}" = "1" ]; then
    if [ "$skip_cuda_runtime_check" = "1" ]; then
      echo "The deprecated runtime requirement conflicts with FAISSR_SKIP_CUDA_RUNTIME_CHECK=1." >&2
      exit 1
    fi
    require_cuda=1
  fi
fi

use_cuda=${FAISSR_USE_CUDA:-}
if [ -z "$use_cuda" ]; then use_cuda=auto; fi
if [ "$require_cuda" = "1" ]; then use_cuda=1; fi
cuda_home=${CUDA_HOME:-}
nvcc=${NVCC:-}
if [ -z "$nvcc" ]; then
  if [ -n "$cuda_home" ] && [ -x "$cuda_home/bin/nvcc" ]; then
    nvcc="$cuda_home/bin/nvcc"
  else
    nvcc=$(command -v nvcc 2>/dev/null || true)
  fi
fi

if [ -z "$cuda_home" ] && [ -n "$nvcc" ]; then
  cuda_bin=$(dirname "$nvcc")
  cuda_home=$(dirname "$cuda_bin")
fi

if [ "$use_cuda" = "1" ] && [ -z "$nvcc" ]; then
  echo "A CUDA build was requested (FAISSR_USE_CUDA=1 or FAISSR_REQUIRE_CUDA=1), but nvcc was not found." >&2
  echo "Set CUDA_HOME or NVCC, or use FAISSR_USE_CUDA=0 for a non-CUDA build." >&2
  exit 1
fi

if [ "$use_cuda" = "1" ] && [ -z "$cuda_home" ]; then
  echo "A CUDA build was requested (FAISSR_USE_CUDA=1 or FAISSR_REQUIRE_CUDA=1), but CUDA_HOME could not be resolved." >&2
  echo "Set CUDA_HOME to the CUDA toolkit root." >&2
  exit 1
fi

cuda_version=""
if [ -n "$nvcc" ]; then
  cuda_version=$(
    "$nvcc" --version 2>/dev/null |
      sed -n 's/.*release \([0-9][0-9]*\)\.\([0-9][0-9]*\).*/\1.\2/p' |
      sed -n '1p'
  )
  if [ -z "$cuda_version" ] && [ "$use_cuda" = "1" ]; then
    echo "CUDA was requested, but the toolkit version could not be read from '$nvcc --version'." >&2
    exit 1
  fi
fi

cppflags=""
libs="-pthread"
extra_cxxflags=""

faiss_home=${FAISS_HOME:-}
faiss_objects="nn_faiss_bridge.o nn_faiss_impl.o"
faiss_cppflags=""
faiss_libs=""
faiss_libdir=""
libomp_home=${LIBOMP_HOME:-${FAISSR_LIBOMP_HOME:-}}
libomp_cppflags=""
libomp_libs=""
macos_recipe_prefix=""

if { [ -n "${INCLUDE_DIR:-}" ] && [ -z "${LIB_DIR:-}" ]; } || \
   { [ -z "${INCLUDE_DIR:-}" ] && [ -n "${LIB_DIR:-}" ]; }; then
  echo "INCLUDE_DIR and LIB_DIR must be supplied together." >&2
  exit 1
fi

if [ "$(uname -s 2>/dev/null || echo unknown)" = "Darwin" ]; then
  macos_arch=$(uname -m 2>/dev/null || true)
  if [ -n "$macos_arch" ] && [ -d "/opt/R/$macos_arch" ]; then
    macos_recipe_prefix="/opt/R/$macos_arch"
  fi
fi

runiverse_macos_diagnostic_stubs_allowed() {
  if [ "$(uname -s 2>/dev/null || echo unknown)" != "Darwin" ]; then
    return 1
  fi
  if [ "${FAISSR_RUNIVERSE_MACOS_STUBS:-1}" = "0" ]; then
    return 1
  fi
  if [ "$require_faiss" = "1" ]; then
    return 1
  fi
  if [ -n "${UNIVERSE_NAME:-}" ] || [ -n "${MY_UNIVERSE:-}" ]; then
    return 0
  fi
  return 1
}

try_libomp_prefix() {
  libomp_prefix=$1
  if [ -n "$libomp_prefix" ] && [ -f "$libomp_prefix/include/omp.h" ]; then
    if [ -d "$libomp_prefix/lib64" ]; then
      candidate_libomp_libdir="$libomp_prefix/lib64"
    else
      candidate_libomp_libdir="$libomp_prefix/lib"
    fi
    candidate_libomp_file=""
    if [ -f "$candidate_libomp_libdir/libomp.dylib" ]; then
      candidate_libomp_file="$candidate_libomp_libdir/libomp.dylib"
    elif [ -f "$candidate_libomp_libdir/libomp.so" ]; then
      candidate_libomp_file="$candidate_libomp_libdir/libomp.so"
    elif [ -f "$candidate_libomp_libdir/libomp.a" ]; then
      candidate_libomp_file="$candidate_libomp_libdir/libomp.a"
    fi
    if [ -n "$candidate_libomp_file" ]; then
      libomp_cppflags="-I$libomp_prefix/include"
      libomp_libs="-Wl,-rpath,$candidate_libomp_libdir $candidate_libomp_file"
      return 0
    fi
  fi
  return 1
}

try_faiss_dirs() {
  faiss_include_dir=$1
  candidate_faiss_libdir=$2
  if [ -z "$faiss_include_dir" ] || [ -z "$candidate_faiss_libdir" ] || \
     [ ! -f "$faiss_include_dir/faiss/IndexFlat.h" ]; then
    return 1
  fi
  candidate_faiss_file=""
  candidate_faiss_rpath=""
  if [ -f "$candidate_faiss_libdir/libfaiss.dylib" ]; then
    candidate_faiss_file="$candidate_faiss_libdir/libfaiss.dylib"
    candidate_faiss_rpath="-Wl,-rpath,$candidate_faiss_libdir"
  elif [ -f "$candidate_faiss_libdir/libfaiss.so" ]; then
    candidate_faiss_file="$candidate_faiss_libdir/libfaiss.so"
    candidate_faiss_rpath="-Wl,-rpath,$candidate_faiss_libdir"
  elif [ -f "$candidate_faiss_libdir/libfaiss.a" ]; then
    candidate_faiss_file="$candidate_faiss_libdir/libfaiss.a"
  fi
  if [ -n "$candidate_faiss_file" ]; then
    faiss_cppflags="-I$faiss_include_dir"
    faiss_libdir="$candidate_faiss_libdir"
    faiss_libs="-L$faiss_libdir $candidate_faiss_rpath $PKG_LIBS"
    return 0
  fi
  return 1
}

try_faiss_prefix() {
  faiss_prefix=$1
  if [ -z "$faiss_prefix" ]; then
    return 1
  fi
  for candidate_faiss_libdir in "$faiss_prefix/lib64" "$faiss_prefix/lib"; do
    if try_faiss_dirs "$faiss_prefix/include" "$candidate_faiss_libdir"; then
      return 0
    fi
  done
  return 1
}

try_faiss_system() {
  if [ -f /usr/include/faiss/IndexFlat.h ]; then
    for candidate_faiss_libdir in /usr/lib /usr/lib/* /lib /lib/*; do
      if try_faiss_dirs /usr/include "$candidate_faiss_libdir"; then
        return 0
      fi
    done
  fi
  return 1
}

if try_faiss_prefix "$faiss_home"; then
  :
elif [ -n "${INCLUDE_DIR:-}" ] && [ -n "${LIB_DIR:-}" ] && \
     try_faiss_dirs "$INCLUDE_DIR" "$LIB_DIR"; then
  :
elif command -v pkg-config >/dev/null 2>&1 && \
     pkg-config --exists "$PKG_CONFIG_NAME" 2>/dev/null; then
  faiss_cppflags=$(pkg-config --cflags "$PKG_CONFIG_NAME")
  faiss_libs=$(pkg-config --libs "$PKG_CONFIG_NAME")
elif try_faiss_prefix "$macos_recipe_prefix"; then
  :
elif [ -n "${CONDA_PREFIX:-}" ] && try_faiss_prefix "$CONDA_PREFIX"; then
  :
elif try_faiss_prefix /opt/homebrew; then
  :
elif try_faiss_prefix /usr/local; then
  :
elif try_faiss_system; then
  :
fi

if [ -z "$faiss_cppflags" ] || [ -z "$faiss_libs" ]; then
  if runiverse_macos_diagnostic_stubs_allowed; then
    echo "r-universe/BiocStaging macOS binary worker detected without FAISS." >&2
    echo "Building diagnostic stubs because this worker does not provide FAISS." >&2
    echo "Linux and user macOS source builds still require real FAISS." >&2
    write_diagnostic_makevars "-DFAISSR_MACOS_CI_NO_FAISS"
    exit 0
  fi
  echo "FAISS is required to build faissR, but FAISS headers/library were not found." >&2
  if [ "$(uname -s 2>/dev/null || echo unknown)" = "Darwin" ]; then
    echo "Bioconductor/macOS binaries should use the static FAISS dependency supplied" >&2
    echo "through the R-macos recipes system. For a source build, set FAISS_HOME" >&2
    echo "or INCLUDE_DIR and LIB_DIR to a compatible FAISS installation." >&2
  elif [ -f /etc/debian_version ]; then
    echo "On Debian/Ubuntu, install: $PKG_DEB_NAME" >&2
  elif command -v dnf >/dev/null 2>&1 || command -v rpm >/dev/null 2>&1; then
    echo "On RPM-based systems, install when available: $PKG_RPM_NAME" >&2
  elif command -v apk >/dev/null 2>&1; then
    echo "On Alpine, $PKG_APK_NAME; build FAISS and set FAISS_HOME." >&2
  else
    echo "Install FAISS or set FAISS_HOME to a prefix containing include/faiss and lib/libfaiss." >&2
  fi
  echo "Alternatively use R CMD INSTALL --configure-vars='INCLUDE_DIR=... LIB_DIR=...'." >&2
  echo "NVIDIA CUDA/cuVS libraries are not required for a CPU-only FAISS build." >&2
  echo "For a NVIDIA GPU build, set FAISSR_REQUIRE_CUDA=1 and, if needed, FAISSR_REQUIRE_CUVS=1 so missing GPU libraries are fatal." >&2
  exit 1
fi

if [ "$(uname -s 2>/dev/null || echo unknown)" = "Darwin" ]; then
  if try_libomp_prefix "$libomp_home"; then
    :
  elif try_libomp_prefix "$macos_recipe_prefix"; then
    :
  elif try_libomp_prefix "${R_HOME:-}"; then
    :
  elif [ -n "${CONDA_PREFIX:-}" ] && try_libomp_prefix "$CONDA_PREFIX"; then
    :
  elif try_libomp_prefix /opt/homebrew/opt/libomp; then
    :
  elif try_libomp_prefix /usr/local/opt/libomp; then
    :
  elif try_libomp_prefix /opt/homebrew; then
    :
  elif try_libomp_prefix /usr/local; then
    :
  fi

  if [ -z "$libomp_cppflags" ] || [ -z "$libomp_libs" ]; then
    echo "FAISS was found, but macOS OpenMP headers/library were not found." >&2
    echo "Use the OpenMP runtime supplied with the R-macos recipe/toolchain, or set" >&2
    echo "LIBOMP_HOME to a prefix containing include/omp.h and lib/libomp.*." >&2
    exit 1
  fi

  extra_cxxflags="$extra_cxxflags -Xpreprocessor -fopenmp"
fi

cppflags="$cppflags -DFAISSR_HAS_FAISS $faiss_cppflags $libomp_cppflags"
libs="$libs $faiss_libs $libomp_libs"

cuda_objects="nn_cuda_stub.o"
cuda_rule=""
if [ "$use_cuda" != "0" ] && [ -n "$nvcc" ] && [ -n "$cuda_home" ]; then
  cuda_cppflags="-I$cuda_home/include"
  cuda_ldflags="-L$cuda_home/lib64 -L$cuda_home/lib"
  cuda_runtime_lib_path="$cuda_home/lib64:$cuda_home/lib"
  for cuda_target_include in "$cuda_home"/targets/*/include; do
    if [ -d "$cuda_target_include" ]; then
      cuda_cppflags="$cuda_cppflags -I$cuda_target_include"
    fi
  done
  for cuda_target_lib in "$cuda_home"/targets/*/lib; do
    if [ -d "$cuda_target_lib" ]; then
      cuda_ldflags="$cuda_ldflags -L$cuda_target_lib"
      cuda_runtime_lib_path="$cuda_runtime_lib_path:$cuda_target_lib"
    fi
  done
  cuda_arch_setting=${FAISSR_CUDA_ARCH:-auto}
  case "$cuda_arch_setting" in
    auto) ;;
    *)
      for arch in $cuda_arch_setting; do
        case "$arch" in
          *[!0-9]*|'')
            echo "FAISSR_CUDA_ARCH must be 'auto' or contain space-separated numeric compute capabilities, for example '80 90 120'." >&2
            exit 1
            ;;
        esac
      done
      ;;
  esac
  cuda_ptx_setting=${FAISSR_CUDA_PTX_ARCH:-auto}
  case "$cuda_ptx_setting" in
    auto|none) ;;
    *[!0-9]*|'')
      echo "FAISSR_CUDA_PTX_ARCH must be 'auto', a numeric compute capability, or 'none'." >&2
      exit 1
      ;;
  esac
  cuda_extra_flags=${FAISSR_CUDA_FLAGS:-}
  cuda_probe_dir=$(mktemp -d "${TMPDIR:-/tmp}/faissR-cuda-XXXXXX")
  cat > "$cuda_probe_dir/conftest.cu" <<'EOF'
#include <cuda_runtime_api.h>
#include <cstdio>

int main() {
  int driver = 0;
  int runtime = 0;
  int count = 0;
  const cudaError_t driver_status = cudaDriverGetVersion(&driver);
  const cudaError_t runtime_status = cudaRuntimeGetVersion(&runtime);
  const cudaError_t device_status = cudaGetDeviceCount(&count);
  std::printf(
    "compiled=%d driver_status=%d driver=%d runtime_status=%d "
    "runtime=%d device_status=%d devices=%d\n",
    CUDART_VERSION,
    static_cast<int>(driver_status),
    driver,
    static_cast<int>(runtime_status),
    runtime,
    static_cast<int>(device_status),
    count
  );
  if (device_status == cudaSuccess) {
    for (int device = 0; device < count; ++device) {
      int compute_major = -1;
      int compute_minor = -1;
      cudaDeviceProp property{};
      const cudaError_t property_status =
        cudaGetDeviceProperties(&property, device);
      if (property_status == cudaSuccess) {
        compute_major = property.major;
        compute_minor = property.minor;
      }
      std::printf(
        "device=%d property_status=%d capability=%d.%d\n",
        device,
        static_cast<int>(property_status),
        compute_major,
        compute_minor
      );
    }
  }
  return 0;
}
EOF
  {
    printf '\nCUDA toolkit probe\n'
    printf 'NVCC: %s\n' "$nvcc"
    printf 'CUDA_HOME: %s\n' "$cuda_home"
    printf 'Reported toolkit: %s\n' "${cuda_version:-unknown}"
  } >> "$config_log"

  cuda_detection_output=""
  if "$nvcc" -std=c++17 $cuda_extra_flags \
      "$cuda_probe_dir/conftest.cu" \
      $cuda_ldflags -lcudart \
      -o "$cuda_probe_dir/conftest-detect" >> "$config_log" 2>&1; then
    cuda_detection_output=$(
      LD_LIBRARY_PATH="$cuda_runtime_lib_path${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
        "$cuda_probe_dir/conftest-detect" 2>> "$config_log" || true
    )
  fi
  printf 'Architecture detection probe: %s\n' \
    "${cuda_detection_output:-unavailable}" >> "$config_log"

  cuda_arch_source=explicit
  cuda_archs=$cuda_arch_setting
  if [ "$cuda_arch_setting" = "auto" ]; then
    cuda_arch_source=runtime
    cuda_archs=$(
      printf '%s\n' "$cuda_detection_output" |
        sed -n 's/.*capability=\([0-9][0-9]*\)\.\([0-9][0-9]*\).*/\1\2/p' |
        sort -n -u |
        tr '\n' ' ' |
        sed 's/[[:space:]]*$//'
    )
    if [ -z "$cuda_archs" ]; then
      cuda_arch_source=nvcc-default
      if [ "$require_cuda" = "1" ]; then
        rm -rf "$cuda_probe_dir"
        if [ "$skip_cuda_runtime_check" = "1" ]; then
          echo "CUDA architecture auto-detection requires a visible GPU." >&2
          echo "On an intentional build-only host, set FAISSR_CUDA_ARCH explicitly." >&2
        else
          echo "FAISSR_REQUIRE_CUDA=1, but no usable CUDA device was available for architecture detection." >&2
          echo "Probe: ${cuda_detection_output:-unavailable}" >&2
        fi
        exit 1
      fi
      echo "CUDA architecture auto-detection was unavailable; using the nvcc default." >&2
      echo "Set FAISSR_CUDA_ARCH explicitly on a build-only host." >&2
    fi
  fi

  cuda_arch_flags=""
  cuda_max_arch=""
  for arch in $cuda_archs; do
    cuda_arch_flags="$cuda_arch_flags -gencode=arch=compute_$arch,code=sm_$arch"
    if [ -z "$cuda_max_arch" ] || [ "$arch" -gt "$cuda_max_arch" ]; then
      cuda_max_arch=$arch
    fi
  done
  cuda_ptx_arch=$cuda_ptx_setting
  if [ "$cuda_ptx_arch" = "auto" ]; then
    cuda_ptx_arch=$cuda_max_arch
  fi
  if [ -n "$cuda_ptx_arch" ] && [ "$cuda_ptx_arch" != "none" ]; then
    cuda_arch_flags="$cuda_arch_flags -gencode=arch=compute_$cuda_ptx_arch,code=compute_$cuda_ptx_arch"
  fi

  cuda_arch_supported=1
  cuda_supported_codes=$(
    "$nvcc" --list-gpu-code 2>> "$config_log" |
      sed 's/^[[:space:]]*//;s/[[:space:]]*$//' || true
  )
  if [ -n "$cuda_supported_codes" ]; then
    for arch in $cuda_archs; do
      if ! printf '%s\n' "$cuda_supported_codes" |
          grep -qx "sm_$arch"; then
        echo "The selected nvcc does not support native architecture sm_$arch." >&2
        cuda_arch_supported=0
      fi
    done
  fi
  cuda_supported_arches=$(
    "$nvcc" --list-gpu-arch 2>> "$config_log" |
      sed 's/^[[:space:]]*//;s/[[:space:]]*$//' || true
  )
  if [ -n "$cuda_supported_arches" ] &&
      [ -n "$cuda_ptx_arch" ] && [ "$cuda_ptx_arch" != "none" ]; then
    if ! printf '%s\n' "$cuda_supported_arches" |
        grep -qx "compute_$cuda_ptx_arch"; then
      echo "The selected nvcc does not support PTX architecture compute_$cuda_ptx_arch." >&2
      cuda_arch_supported=0
    fi
  fi
  {
    printf 'Architecture source: %s\n' "$cuda_arch_source"
    printf 'Selected native architectures: %s\n' "${cuda_archs:-nvcc-default}"
    printf 'Selected PTX architecture: %s\n' "${cuda_ptx_arch:-nvcc-default}"
    printf 'Architecture flags: %s\n' "${cuda_arch_flags:-nvcc-default}"
  } >> "$config_log"

  cuda_probe_ok=1
  if [ "$cuda_arch_supported" = "0" ]; then
    cuda_probe_ok=0
  elif ! "$nvcc" -std=c++17 $cuda_arch_flags $cuda_extra_flags \
      "$cuda_probe_dir/conftest.cu" \
      $cuda_ldflags -lcudart \
      -o "$cuda_probe_dir/conftest" >> "$config_log" 2>&1; then
    cuda_probe_ok=0
  fi
  cuda_probe_output=""
  if [ "$cuda_probe_ok" = "1" ]; then
    cuda_probe_output=$(
      LD_LIBRARY_PATH="$cuda_runtime_lib_path${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
        "$cuda_probe_dir/conftest" 2>> "$config_log" || true
    )
    printf 'Runtime probe: %s\n' "${cuda_probe_output:-unavailable}" >> "$config_log"
  fi
  rm -rf "$cuda_probe_dir"

  if [ "$cuda_probe_ok" = "0" ]; then
    if [ "$use_cuda" = "1" ]; then
      echo "CUDA was requested, but a CUDA compiler/linker probe failed." >&2
      echo "Check CUDA_HOME, NVCC, FAISSR_CUDA_ARCH, and config.log." >&2
      exit 1
    fi
    echo "A CUDA compiler was found, but its compile/link probe failed; building without CUDA." >&2
    echo "Set FAISSR_REQUIRE_CUDA=1 to make this condition fatal. See config.log." >&2
  else
    if [ "$require_cuda" = "1" ] && [ "$skip_cuda_runtime_check" != "1" ]; then
      case "$cuda_probe_output" in
        *"device_status=0 devices="[1-9]*) ;;
        *)
          echo "FAISSR_REQUIRE_CUDA=1, but no usable CUDA device was visible during configuration." >&2
          echo "Runtime probe: ${cuda_probe_output:-unavailable}" >&2
          echo "For an intentional build-only host, set FAISSR_SKIP_CUDA_RUNTIME_CHECK=1." >&2
          exit 1
          ;;
      esac
    fi
    echo "CUDA compile/link probe passed (toolkit ${cuda_version:-unknown})."
    echo "CUDA architectures: native ${cuda_archs:-nvcc-default}; PTX ${cuda_ptx_arch:-nvcc-default} ($cuda_arch_source)."
    if [ -n "$cuda_probe_output" ]; then
      echo "CUDA runtime probe: $cuda_probe_output"
    fi
    cuda_objects="nn_cuda_impl.o nn_cuda_kernels.o"
    cppflags="$cppflags -DFAISSR_HAS_CUDA $cuda_cppflags"
    libs="$libs $cuda_ldflags -lcudart"
    cuda_rule="
all: \$(SHLIB)

CUDA_NVCCFLAGS = -std=c++17 -x cu -Xcompiler -fPIC$cuda_arch_flags $cuda_extra_flags

nn_cuda_kernels.o: nn_cuda_kernels.cpp
	\$(NVCC) \$(CUDA_NVCCFLAGS) -c \$< -o \$@
"
  fi
fi

use_cuvs=${FAISSR_USE_CUVS:-}
if [ -z "$use_cuvs" ]; then use_cuvs=auto; fi
if [ "${FAISSR_REQUIRE_CUVS:-0}" = "1" ]; then use_cuvs=1; fi
cuvs_home=${CUVS_HOME:-}
cuvs_objects="nn_cuvs_bridge.o nn_cuvs_stub.o"
cuvs_cppflags=""
cuvs_libs=""

append_cuvs_include_dir() {
  if [ -d "$1" ]; then
    cuvs_cppflags="$cuvs_cppflags -I$1"
  fi
}

append_cuvs_lib_dir() {
  if [ -d "$1" ]; then
    cuvs_libs="$cuvs_libs -L$1 -Wl,-rpath,$1"
  fi
}

if [ "$use_cuvs" != "0" ]; then
  if [ "$cuda_objects" = "nn_cuda_stub.o" ]; then
    if [ "$use_cuvs" = "1" ]; then
      echo "cuVS was requested (FAISSR_USE_CUVS=1 or FAISSR_REQUIRE_CUVS=1), but faissR is not being built with CUDA." >&2
      echo "Set FAISSR_USE_CUDA=1 and CUDA_HOME/NVCC, or use FAISSR_USE_CUVS=0." >&2
      exit 1
    fi
  else
    if [ -z "$cuvs_home" ] && [ -n "${CONDA_PREFIX:-}" ] && \
       [ -f "$CONDA_PREFIX/include/cuvs/neighbors/cagra.h" ]; then
      cuvs_home=$CONDA_PREFIX
    fi

    if [ -n "$cuvs_home" ] && [ ! -f "$cuvs_home/include/cuvs/neighbors/cagra.h" ] && \
       [ -f "$cuvs_home/libcuvs/include/cuvs/neighbors/cagra.h" ]; then
      cuvs_home="$cuvs_home/libcuvs"
    fi

    if [ -n "$cuvs_home" ] && [ -f "$cuvs_home/include/cuvs/neighbors/cagra.h" ]; then
      cuvs_cppflags="-I. -I$cuvs_home/include"
      cuvs_parent=$(dirname "$cuvs_home")
      append_cuvs_include_dir "$cuvs_parent/libraft/include"
      append_cuvs_include_dir "$cuvs_parent/librmm/include"
      if [ -d "$cuvs_home/lib64" ]; then
        append_cuvs_lib_dir "$cuvs_home/lib64"
      else
        append_cuvs_lib_dir "$cuvs_home/lib"
      fi
      append_cuvs_lib_dir "$cuvs_parent/libraft/lib64"
      append_cuvs_lib_dir "$cuvs_parent/libraft/lib"
      append_cuvs_lib_dir "$cuvs_parent/librmm/lib64"
      append_cuvs_lib_dir "$cuvs_parent/librmm/lib"
      for cuvs_component_lib in "$cuvs_parent"/*/lib64 "$cuvs_parent"/*/lib; do
        append_cuvs_lib_dir "$cuvs_component_lib"
      done
      if [ -d "$cuvs_parent/nvidia" ]; then
        for cuvs_dep_lib in "$cuvs_parent"/nvidia/*/lib; do
          append_cuvs_lib_dir "$cuvs_dep_lib"
        done
      fi
      if [ -f "$cuvs_home/lib64/libcuvs_c.so" ] || \
         [ -f "$cuvs_home/lib/libcuvs_c.so" ]; then
        cuvs_libs="$cuvs_libs -lcuvs_c"
      fi
      cuvs_libs="$cuvs_libs -lcuvs"
      if [ -f "$cuvs_parent/libraft/lib64/libraft.so" ] || \
         [ -f "$cuvs_parent/libraft/lib/libraft.so" ]; then
        cuvs_libs="$cuvs_libs -lraft"
      fi
      if [ -f "$cuvs_parent/librmm/lib64/librmm.so" ] || \
         [ -f "$cuvs_parent/librmm/lib/librmm.so" ]; then
        cuvs_libs="$cuvs_libs -lrmm"
      fi
      if [ -f "$cuvs_parent/rapids_logger/lib64/librapids_logger.so" ] || \
         [ -f "$cuvs_parent/rapids_logger/lib/librapids_logger.so" ]; then
        cuvs_libs="$cuvs_libs -lrapids_logger"
      fi
    elif command -v pkg-config >/dev/null 2>&1 && pkg-config --exists cuvs 2>/dev/null; then
      cuvs_cppflags=$(pkg-config --cflags cuvs)
      cuvs_libs=$(pkg-config --libs cuvs)
    elif [ -f /usr/local/include/cuvs/neighbors/cagra.h ] && \
         { [ -f /usr/local/lib/libcuvs.so ] || [ -f /usr/local/lib/libcuvs.a ]; }; then
      cuvs_cppflags="-I/usr/local/include"
      cuvs_libs="-L/usr/local/lib -Wl,-rpath,/usr/local/lib -lcuvs"
    fi

    if [ -n "$cuvs_cppflags" ] && [ -n "$cuvs_libs" ]; then
      cuvs_objects="nn_cuvs_bridge.o nn_cuvs_impl.o"
      cppflags="$cppflags -DFAISSR_HAS_CUVS $cuvs_cppflags"
      libs="$libs $cuvs_libs"
    elif [ "$use_cuvs" = "1" ]; then
      echo "cuVS was requested (FAISSR_USE_CUVS=1 or FAISSR_REQUIRE_CUVS=1), but RAPIDS cuVS headers/library were not found." >&2
      echo "Set CUVS_HOME to a prefix containing include/cuvs and lib/libcuvs, or install a pkg-config cuvs file." >&2
      exit 1
    fi
  fi
fi

faiss_numerical_libs=${FAISSR_NUMERICAL_LIBS:-}
if [ "$(uname -s 2>/dev/null || echo unknown)" = "Linux" ]; then
  # R's bundled BLAS/LAPACK omit single-precision routines used by FAISS.
  # A shared-library link alone permits unresolved symbols, so also load it
  # in a fresh R process with immediate symbol resolution.
  if [ -n "${R_HOME:-}" ]; then
    r_bin="$R_HOME/bin/R"
  else
    r_bin=$(command -v R || true)
  fi
  if [ ! -x "$r_bin" ]; then
    echo "R was not found for the FAISS numerical-library check." >&2
    exit 1
  fi
  probe_dir=$(mktemp -d "${TMPDIR:-/tmp}/faissR-link-XXXXXX")
  trap 'rm -rf "$probe_dir"' 0
  trap 'exit 1' HUP INT QUIT TERM
  probe_log="$config_log"
  printf '\n%s\n' 'FAISS numerical-library compile/load probes' >> "$probe_log"
  cat > "$probe_dir/conftest.cpp" <<'EOF'
#include <faiss/IndexFlat.h>
extern "C" {
void sgemm_(); void ssyrk_(); void sgeqrf_(); void sorgqr_();
void sgesvd_(); void sgelsd_(); void sgetrf_(); void sgetri_();
void dgemm_(); void dsyev_(); void dgesvd_(); void dgetrf_(); void dgetri_();
void (*volatile faissr_numerical_symbols[])() = {
    sgemm_, ssyrk_, sgeqrf_, sorgqr_, sgesvd_, sgelsd_, sgetrf_, sgetri_,
    dgemm_, dsyev_, dgesvd_, dgetrf_, dgetri_
};
void *faissr_link_probe() { return new faiss::IndexFlatL2(2); }
}
EOF

  try_numerical_libs() {
    probe_libs=$1
    {
      echo 'CXX_STD = CXX20'
      echo "PKG_CPPFLAGS = $cppflags"
      printf '%s%s\n' 'PKG_CXXFLAGS = -pthread $(SHLIB_OPENMP_CXXFLAGS)' "$extra_cxxflags"
      printf '%s%s\n' 'PKG_LIBS = $(SHLIB_OPENMP_CXXFLAGS) ' \
        "$libs $probe_libs \$(LAPACK_LIBS) \$(BLAS_LIBS) \$(FLIBS)"
    } > "$probe_dir/Makevars"
    rm -f "$probe_dir/conftest.o" "$probe_dir/conftest.so"
    printf '\nExtra numerical libraries: %s\n' "${probe_libs:-(none)}" >> "$probe_log"
    if (cd "$probe_dir" && "$r_bin" CMD SHLIB conftest.cpp && \
        LD_BIND_NOW=1 "$r_bin" --vanilla --slave -e \
        'dyn.load("conftest.so", local = TRUE, now = TRUE)') >> "$probe_log" 2>&1; then
      faiss_numerical_libs=$probe_libs
      return 0
    fi
    return 1
  }

  numerical_ok=0
  if [ -n "$faiss_numerical_libs" ]; then
    if try_numerical_libs "$faiss_numerical_libs"; then numerical_ok=1; fi
  elif try_numerical_libs ""; then
    numerical_ok=1
  else
    for numerical_pc in 'lapack blas' openblas; do
      if command -v pkg-config >/dev/null 2>&1 && \
          pkg-config --exists $numerical_pc; then
        numerical_candidate=$(pkg-config --libs $numerical_pc)
        if try_numerical_libs "$numerical_candidate"; then
          numerical_ok=1
          break
        fi
      fi
    done
    if [ "$numerical_ok" = "0" ]; then
      for numerical_candidate in '-llapack -lblas' '-lopenblas'; do
        if try_numerical_libs "$numerical_candidate"; then
          numerical_ok=1
          break
        fi
      done
    fi
  fi
  if [ "$numerical_ok" = "0" ]; then
    echo "FAISS was found, but its numerical-library compile/load check failed." >&2
    echo "FAISS needs complete, ABI-compatible LP64 BLAS and LAPACK, including single precision." >&2
    echo "On Debian/Ubuntu: apt-get install libfaiss-dev libblas-dev liblapack-dev" >&2
    echo "For a custom provider, set FAISSR_NUMERICAL_LIBS (for example '-llapack -lblas')." >&2
    echo "Do not replace R's libRblas/libRlapack. See config.log for the compiler/loader error." >&2
    exit 1
  fi
  echo "FAISS compile/load check passed; extra numerical libraries: ${faiss_numerical_libs:-(none)}"
  rm -rf "$probe_dir"
  trap - 0 HUP INT QUIT TERM
fi

{
  echo "CXX_STD = CXX20"
  printf '%s%s\n' 'PKG_CXXFLAGS = -pthread $(SHLIB_OPENMP_CXXFLAGS)' "$extra_cxxflags"
  if [ -n "$cppflags" ]; then
    echo "PKG_CPPFLAGS = $cppflags"
  fi
  printf '%s%s\n' 'PKG_LIBS = $(SHLIB_OPENMP_CXXFLAGS) ' \
    "$libs $faiss_numerical_libs \$(LAPACK_LIBS) \$(BLAS_LIBS) \$(FLIBS)"
  if [ "$cuda_objects" != "nn_cuda_stub.o" ]; then
    echo "NVCC = $nvcc"
    printf "%s" "$cuda_rule"
  fi
    echo "OBJECTS = RcppExports.o embedding_utils.o nn.o nn_auto_select.o nn_fortran.o $faiss_objects $cuvs_objects nn_cuda_bridge.o $cuda_objects"
} > src/Makevars
