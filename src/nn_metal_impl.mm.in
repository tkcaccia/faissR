namespace {

constexpr int kMaxP = faissr_metal::kMaxIvfDimensions;
constexpr int kMaxGlobalP = 16384;
constexpr int kMaxLists = 1024;
// Keep enough local top-k storage for compact t-SNE and UMAP neighborhoods
// without routing an explicit Metal request through a host fallback.
constexpr int kMaxK = 128;
constexpr int kMaxProbe = 512;
constexpr int kMaxShortlistPerGroup = 128;
constexpr int kInitialShortlistPerGroup = 72;
constexpr int kProjectionDim = 128;
constexpr int kMetalSimdGroups = 4;

const char* kMetalSource = R"METAL(
#include <metal_stdlib>
using namespace metal;

constant uint NSG = 4;
constant uint SIMD_WIDTH = 32;
constant uint MAX_P = 1024;
constant uint MAX_Q = 128;
constant uint MAX_K = 128;
constant uint MAX_PROBE = 512;
constant uint MAX_SHORTLIST = 128;

struct ProjectParams {
  uint n;
  uint p;
  uint qdim;
};

struct IndexParams {
  uint n;
  uint p;
  uint qdim;
  uint nlist;
};

struct SearchParams {
  uint n;
  uint p;
  uint qdim;
  uint nlist;
  uint nprobe;
  uint k;
  uint query_offset;
  uint shortlist_per_group;
};

struct QuerySearchParams {
  uint n_reference;
  uint n_query;
  uint p;
  uint k;
  uint tile_rows;
};

struct QueryIvfParams {
  uint n_reference;
  uint n_query;
  uint p;
  uint qdim;
  uint nlist;
  uint nprobe;
  uint k;
};

constexpr size_t flat_offset(uint row, uint stride) {
  return size_t(row) * stride;
}

static_assert(flat_offset(4194304u, 1024u) == 4294967296ull,
              "Metal reference offsets must support more than 2^32 elements");
static_assert(flat_offset(100000000u, 96u) == 9600000000ull,
              "Metal reference offsets must support wide Deep1B inputs");

inline bool better_pair(float da, int ia, float db, int ib) {
  return da < db || (da == db && ia < ib);
}

inline void insert_sorted(
    threadgroup float* values,
    threadgroup int* ids,
    uint base,
    uint count,
    float value,
    int id) {
  if (count == 0 || !better_pair(value, id, values[base + count - 1], ids[base + count - 1])) return;
  uint pos = count - 1;
  while (pos > 0 && better_pair(value, id, values[base + pos - 1], ids[base + pos - 1])) {
    values[base + pos] = values[base + pos - 1];
    ids[base + pos] = ids[base + pos - 1];
    --pos;
  }
  values[base + pos] = value;
  ids[base + pos] = id;
}

inline void sift_shortlist(threadgroup float* values, threadgroup int* ids,
    uint count, uint pos, float value, int id) {
  for (uint child = 2 * pos + 1; child < count; child = 2 * pos + 1) {
    if (child + 1 < count &&
        better_pair(values[child], ids[child],
                    values[child + 1], ids[child + 1])) {
      ++child;
    }
    if (!better_pair(value, id, values[child], ids[child])) break;
    values[pos] = values[child];
    ids[pos] = ids[child];
    pos = child;
  }
  values[pos] = value;
  ids[pos] = id;
}

// A max heap retains the same shortlist with logarithmic replacement cost.
inline void offer_shortlist(threadgroup float* values, threadgroup int* ids,
    uint count, float value, int id) {
  if (better_pair(value, id, values[0], ids[0]))
    sift_shortlist(values, ids, count, 0u, value, id);
}

inline void sort_shortlist_heap(threadgroup float* ds, threadgroup int* ids,
    uint count) {
  for (uint end = count - 1; end > 0; --end) {
    const float largest = ds[0], value = ds[end];
    const int largest_id = ids[0], id = ids[end];
    sift_shortlist(ds, ids, end, 0u, value, id);
    ds[end] = largest;
    ids[end] = largest_id;
  }
}

kernel void signed_hash_project(
    device const float* data [[buffer(0)]],
    device const uint* feature_offsets [[buffer(1)]],
    device const uint* feature_ids [[buffer(2)]],
    device const char* feature_signs [[buffer(3)]],
    device float* projected [[buffer(4)]],
    constant ProjectParams& params [[buffer(5)]],
    uint row [[threadgroup_position_in_grid]],
    uint tid [[thread_position_in_threadgroup]]) {
  if (row >= params.n || tid >= params.qdim) return;
  float value = 0.0f;
  uint begin = feature_offsets[tid];
  uint end = feature_offsets[tid + 1];
  for (uint pos = begin; pos < end; ++pos) {
    value = fma(float(feature_signs[pos]), data[flat_offset(row, params.p) + feature_ids[pos]], value);
  }
  projected[flat_offset(row, params.qdim) + tid] = value;
}

kernel void assign_centroid(
    device const float* projected [[buffer(0)]],
    device const float* centroids [[buffer(1)]],
    device int* assignment [[buffer(2)]],
    constant IndexParams& params [[buffer(3)]],
    uint row [[threadgroup_position_in_grid]],
    uint tid [[thread_position_in_threadgroup]],
    uint lane [[thread_index_in_simdgroup]],
    uint sg [[simdgroup_index_in_threadgroup]]) {
  threadgroup float query[MAX_Q];
  threadgroup float best_dist[NSG];
  threadgroup int best_id[NSG];
  if (row >= params.n) return;
  for (uint d = tid; d < params.qdim; d += NSG * SIMD_WIDTH) query[d] = projected[flat_offset(row, params.qdim) + d];
  if (tid < NSG) { best_dist[tid] = INFINITY; best_id[tid] = -1; }
  threadgroup_barrier(mem_flags::mem_threadgroup);

  for (uint c = sg; c < params.nlist; c += NSG) {
    float partial = 0.0f;
    for (uint d = lane; d < params.qdim; d += SIMD_WIDTH) {
      float delta = query[d] - centroids[c * params.qdim + d];
      partial = fma(delta, delta, partial);
    }
    float distance = simd_sum(partial);
    if (lane == 0 && better_pair(distance, int(c), best_dist[sg], best_id[sg])) {
      best_dist[sg] = distance;
      best_id[sg] = int(c);
    }
  }
  threadgroup_barrier(mem_flags::mem_threadgroup);
  if (tid == 0) {
    float distance = best_dist[0];
    int id = best_id[0];
    for (uint g = 1; g < NSG; ++g) {
      if (better_pair(best_dist[g], best_id[g], distance, id)) {
        distance = best_dist[g];
        id = best_id[g];
      }
    }
    assignment[row] = id;
  }
}

kernel void clear_centroid_accumulators(
    device atomic_float* sums [[buffer(0)]],
    device atomic_uint* counts [[buffer(1)]],
    constant IndexParams& params [[buffer(2)]],
    uint gid [[thread_position_in_grid]]) {
  uint total = params.nlist * params.qdim;
  if (gid < total) atomic_store_explicit(&sums[gid], 0.0f, memory_order_relaxed);
  if (gid < params.nlist) atomic_store_explicit(&counts[gid], 0u, memory_order_relaxed);
}

kernel void accumulate_centroids(
    device const float* projected [[buffer(0)]],
    device const int* assignment [[buffer(1)]],
    device atomic_float* sums [[buffer(2)]],
    device atomic_uint* counts [[buffer(3)]],
    constant IndexParams& params [[buffer(4)]],
    uint gid [[thread_position_in_grid]]) {
  uint total = params.n * params.qdim;
  if (gid >= total) return;
  uint row = gid / params.qdim;
  uint dimension = gid - row * params.qdim;
  int centroid = assignment[row];
  if (centroid < 0 || uint(centroid) >= params.nlist) return;
  atomic_fetch_add_explicit(
    &sums[uint(centroid) * params.qdim + dimension],
    projected[gid],
    memory_order_relaxed
  );
  if (dimension == 0) atomic_fetch_add_explicit(&counts[centroid], 1u, memory_order_relaxed);
}

kernel void finalize_centroids(
    device const atomic_float* sums [[buffer(0)]],
    device const atomic_uint* counts [[buffer(1)]],
    device float* centroids [[buffer(2)]],
    constant IndexParams& params [[buffer(3)]],
    uint gid [[thread_position_in_grid]]) {
  uint total = params.nlist * params.qdim;
  if (gid >= total) return;
  uint centroid = gid / params.qdim;
  uint count = atomic_load_explicit(&counts[centroid], memory_order_relaxed);
  if (count > 0) {
    centroids[gid] = atomic_load_explicit(&sums[gid], memory_order_relaxed) / float(count);
  }
}

kernel void exact_topk_simd(
    device const float* data [[buffer(0)]],
    device int* out_ids [[buffer(1)]],
    device float* out_dist [[buffer(2)]],
    constant SearchParams& params [[buffer(3)]],
    uint qlocal [[threadgroup_position_in_grid]],
    uint tid [[thread_position_in_threadgroup]],
    uint lane [[thread_index_in_simdgroup]],
    uint sg [[simdgroup_index_in_threadgroup]]) {
  threadgroup float query[MAX_P];
  threadgroup float local_dist[NSG * MAX_K];
  threadgroup int local_id[NSG * MAX_K];
  uint q = params.query_offset + qlocal;
  if (q >= params.n) return;
  const device float* query_data = data + flat_offset(q, params.p);
  for (uint d = tid; d < params.p; d += NSG * SIMD_WIDTH) {
    query[d] = query_data[d];
  }
  for (uint i = tid; i < NSG * params.k; i += NSG * SIMD_WIDTH) {
    local_dist[i] = INFINITY;
    local_id[i] = -1;
  }
  threadgroup_barrier(mem_flags::mem_threadgroup);

  uint base = sg * params.k;
  for (uint candidate = sg; candidate < params.n; candidate += NSG) {
    if (candidate == q) continue;
    float partial = 0.0f;
    const device float* point = data + flat_offset(candidate, params.p);
    for (uint d = lane; d < params.p; d += SIMD_WIDTH) {
      float delta = query[d] - point[d];
      partial = fma(delta, delta, partial);
    }
    float distance = simd_sum(partial);
    if (lane == 0) insert_sorted(local_dist, local_id, base, params.k, distance, int(candidate));
  }
  threadgroup_barrier(mem_flags::mem_threadgroup);

  if (tid == 0) {
    uint heads[NSG];
    for (uint g = 0; g < NSG; ++g) heads[g] = 0;
    for (uint rank = 0; rank < params.k; ++rank) {
      float best_d = INFINITY;
      int best_i = -1;
      uint best_g = 0;
      for (uint g = 0; g < NSG; ++g) {
        uint h = heads[g];
        if (h < params.k) {
          uint pos = g * params.k + h;
          if (better_pair(local_dist[pos], local_id[pos], best_d, best_i)) {
            best_d = local_dist[pos]; best_i = local_id[pos]; best_g = g;
          }
        }
      }
      size_t output = flat_offset(qlocal, params.k);
      out_dist[output + rank] = best_d;
      out_ids[output + rank] = best_i;
      ++heads[best_g];
    }
  }
}

// High-dimensional exact search avoids a fixed threadgroup query cache. This
// preserves the same L2 calculation for inputs that would exceed Metal's
// threadgroup-memory budget, at the cost of rereading the query from device
// memory for each candidate.
kernel void exact_topk_simd_global_query(
    device const float* data [[buffer(0)]],
    device int* out_ids [[buffer(1)]],
    device float* out_dist [[buffer(2)]],
    constant SearchParams& params [[buffer(3)]],
    uint qlocal [[threadgroup_position_in_grid]],
    uint tid [[thread_position_in_threadgroup]],
    uint lane [[thread_index_in_simdgroup]],
    uint sg [[simdgroup_index_in_threadgroup]]) {
  threadgroup float local_dist[NSG * MAX_K];
  threadgroup int local_id[NSG * MAX_K];
  uint q = params.query_offset + qlocal;
  if (q >= params.n) return;
  for (uint i = tid; i < NSG * params.k; i += NSG * SIMD_WIDTH) {
    local_dist[i] = INFINITY;
    local_id[i] = -1;
  }
  threadgroup_barrier(mem_flags::mem_threadgroup);

  uint base = sg * params.k;
  const device float* query = data + flat_offset(q, params.p);
  for (uint candidate = sg; candidate < params.n; candidate += NSG) {
    if (candidate == q) continue;
    float partial = 0.0f;
    const device float* point = data + flat_offset(candidate, params.p);
    for (uint d = lane; d < params.p; d += SIMD_WIDTH) {
      float delta = query[d] - point[d];
      partial = fma(delta, delta, partial);
    }
    float distance = simd_sum(partial);
    if (lane == 0) {
      insert_sorted(
        local_dist, local_id, base, params.k, distance, int(candidate)
      );
    }
  }
  threadgroup_barrier(mem_flags::mem_threadgroup);

  if (tid == 0) {
    uint heads[NSG];
    for (uint g = 0; g < NSG; ++g) heads[g] = 0;
    for (uint rank = 0; rank < params.k; ++rank) {
      float best_d = INFINITY;
      int best_i = -1;
      uint best_g = 0;
      for (uint g = 0; g < NSG; ++g) {
        uint h = heads[g];
        if (h < params.k) {
          uint pos = g * params.k + h;
          if (better_pair(local_dist[pos], local_id[pos], best_d, best_i)) {
            best_d = local_dist[pos];
            best_i = local_id[pos];
            best_g = g;
          }
        }
      }
      size_t output = flat_offset(qlocal, params.k);
      out_dist[output + rank] = best_d;
      out_ids[output + rank] = best_i;
      ++heads[best_g];
    }
  }
}

kernel void exact_query_topk_simd(
    device const float* reference [[buffer(0)]],
    device const float* query [[buffer(1)]],
    device int* out_ids [[buffer(2)]],
    device float* out_dist [[buffer(3)]],
    constant QuerySearchParams& params [[buffer(4)]],
    uint group [[threadgroup_position_in_grid]],
    uint tid [[thread_position_in_threadgroup]],
    uint lane [[thread_index_in_simdgroup]],
    uint sg [[simdgroup_index_in_threadgroup]]) {
  threadgroup float query_row[MAX_P];
  threadgroup float local_dist[NSG * MAX_K];
  threadgroup int local_id[NSG * MAX_K];
  uint q = group % params.n_query;
  uint tile = group / params.n_query;
  uint first = tile * params.tile_rows;
  uint end = min(first + params.tile_rows, params.n_reference);
  const device float* query_data = query + flat_offset(q, params.p);
  for (uint d = tid; d < params.p; d += NSG * SIMD_WIDTH) {
    query_row[d] = query_data[d];
  }
  for (uint i = tid; i < NSG * params.k; i += NSG * SIMD_WIDTH) {
    local_dist[i] = INFINITY;
    local_id[i] = -1;
  }
  threadgroup_barrier(mem_flags::mem_threadgroup);

  uint base = sg * params.k;
  for (uint candidate = first + sg; candidate < end; candidate += NSG) {
    float partial = 0.0f;
    const device float* point = reference + flat_offset(candidate, params.p);
    for (uint d = lane; d < params.p; d += SIMD_WIDTH) {
      float delta = query_row[d] - point[d];
      partial = fma(delta, delta, partial);
    }
    float distance = simd_sum(partial);
    if (lane == 0) {
      insert_sorted(
        local_dist, local_id, base, params.k, distance, int(candidate)
      );
    }
  }
  threadgroup_barrier(mem_flags::mem_threadgroup);

  if (tid == 0) {
    uint heads[NSG];
    for (uint g = 0; g < NSG; ++g) heads[g] = 0;
    for (uint rank = 0; rank < params.k; ++rank) {
      float best_d = INFINITY;
      int best_i = -1;
      uint best_g = 0;
      for (uint g = 0; g < NSG; ++g) {
        uint h = heads[g];
        if (h < params.k) {
          uint pos = g * params.k + h;
          if (better_pair(local_dist[pos], local_id[pos], best_d, best_i)) {
            best_d = local_dist[pos];
            best_i = local_id[pos];
            best_g = g;
          }
        }
      }
      size_t output = size_t(group) * params.k;
      out_dist[output + rank] = best_d;
      out_ids[output + rank] = best_i;
      ++heads[best_g];
    }
  }
}

kernel void exact_query_topk_simd_global_query(
    device const float* reference [[buffer(0)]],
    device const float* query [[buffer(1)]],
    device int* out_ids [[buffer(2)]],
    device float* out_dist [[buffer(3)]],
    constant QuerySearchParams& params [[buffer(4)]],
    uint group [[threadgroup_position_in_grid]],
    uint tid [[thread_position_in_threadgroup]],
    uint lane [[thread_index_in_simdgroup]],
    uint sg [[simdgroup_index_in_threadgroup]]) {
  threadgroup float local_dist[NSG * MAX_K];
  threadgroup int local_id[NSG * MAX_K];
  uint q = group % params.n_query;
  uint tile = group / params.n_query;
  uint first = tile * params.tile_rows;
  uint end = min(first + params.tile_rows, params.n_reference);
  for (uint i = tid; i < NSG * params.k; i += NSG * SIMD_WIDTH) {
    local_dist[i] = INFINITY;
    local_id[i] = -1;
  }
  threadgroup_barrier(mem_flags::mem_threadgroup);

  uint base = sg * params.k;
  const device float* query_row = query + flat_offset(q, params.p);
  for (uint candidate = first + sg; candidate < end; candidate += NSG) {
    float partial = 0.0f;
    const device float* point = reference + flat_offset(candidate, params.p);
    for (uint d = lane; d < params.p; d += SIMD_WIDTH) {
      float delta = query_row[d] - point[d];
      partial = fma(delta, delta, partial);
    }
    float distance = simd_sum(partial);
    if (lane == 0) {
      insert_sorted(
        local_dist, local_id, base, params.k, distance, int(candidate)
      );
    }
  }
  threadgroup_barrier(mem_flags::mem_threadgroup);

  if (tid == 0) {
    uint heads[NSG];
    for (uint g = 0; g < NSG; ++g) heads[g] = 0;
    for (uint rank = 0; rank < params.k; ++rank) {
      float best_d = INFINITY;
      int best_i = -1;
      uint best_g = 0;
      for (uint g = 0; g < NSG; ++g) {
        uint h = heads[g];
        if (h < params.k) {
          uint pos = g * params.k + h;
          if (better_pair(local_dist[pos], local_id[pos], best_d, best_i)) {
            best_d = local_dist[pos];
            best_i = local_id[pos];
            best_g = g;
          }
        }
      }
      size_t output = size_t(group) * params.k;
      out_dist[output + rank] = best_d;
      out_ids[output + rank] = best_i;
      ++heads[best_g];
    }
  }
}

kernel void ivf_query_topk_fused(
    device const float* reference [[buffer(0)]],
    device const float* query [[buffer(1)]],
    device const float* query_projected [[buffer(2)]],
    device const float* centroids [[buffer(3)]],
    device const uint* list_offsets [[buffer(4)]],
    device const int* list_ids [[buffer(5)]],
    device int* out_ids [[buffer(6)]],
    device float* out_dist [[buffer(7)]],
    constant QueryIvfParams& params [[buffer(8)]],
    uint q [[threadgroup_position_in_grid]],
    uint tid [[thread_position_in_threadgroup]],
    uint lane [[thread_index_in_simdgroup]],
    uint sg [[simdgroup_index_in_threadgroup]]) {
  threadgroup float query_row[MAX_P];
  threadgroup float query_low[MAX_Q];
  threadgroup float coarse_dist[NSG * MAX_PROBE];
  threadgroup int coarse_id[NSG * MAX_PROBE];
  threadgroup int probes[MAX_PROBE];
  threadgroup float local_dist[NSG * MAX_K];
  threadgroup int local_id[NSG * MAX_K];
  if (q >= params.n_query || params.nprobe > MAX_PROBE) return;

  for (uint d = tid; d < params.p; d += NSG * SIMD_WIDTH) {
    query_row[d] = query[flat_offset(q, params.p) + d];
  }
  for (uint d = tid; d < params.qdim; d += NSG * SIMD_WIDTH) {
    query_low[d] = query_projected[flat_offset(q, params.qdim) + d];
  }
  for (uint i = tid; i < NSG * params.nprobe; i += NSG * SIMD_WIDTH) {
    coarse_dist[i] = INFINITY;
    coarse_id[i] = -1;
  }
  for (uint i = tid; i < NSG * params.k; i += NSG * SIMD_WIDTH) {
    local_dist[i] = INFINITY;
    local_id[i] = -1;
  }
  threadgroup_barrier(mem_flags::mem_threadgroup);

  uint coarse_base = sg * params.nprobe;
  for (uint c = sg; c < params.nlist; c += NSG) {
    float partial = 0.0f;
    const device float* centroid = centroids + c * params.qdim;
    for (uint d = lane; d < params.qdim; d += SIMD_WIDTH) {
      float delta = query_low[d] - centroid[d];
      partial = fma(delta, delta, partial);
    }
    float distance = simd_sum(partial);
    if (lane == 0) {
      insert_sorted(
        coarse_dist, coarse_id, coarse_base, params.nprobe, distance, int(c)
      );
    }
  }
  threadgroup_barrier(mem_flags::mem_threadgroup);

  if (tid == 0) {
    uint heads[NSG];
    for (uint g = 0; g < NSG; ++g) heads[g] = 0;
    for (uint rank = 0; rank < params.nprobe; ++rank) {
      float best_d = INFINITY;
      int best_i = -1;
      uint best_g = 0;
      for (uint g = 0; g < NSG; ++g) {
        uint h = heads[g];
        if (h < params.nprobe) {
          uint pos = g * params.nprobe + h;
          if (better_pair(coarse_dist[pos], coarse_id[pos], best_d, best_i)) {
            best_d = coarse_dist[pos];
            best_i = coarse_id[pos];
            best_g = g;
          }
        }
      }
      probes[rank] = best_i;
      ++heads[best_g];
    }
  }
  threadgroup_barrier(mem_flags::mem_threadgroup);

  uint fine_base = sg * params.k;
  for (uint probe = 0; probe < params.nprobe; ++probe) {
    int list = probes[probe];
    if (list < 0 || uint(list) >= params.nlist) continue;
    uint begin = list_offsets[list];
    uint end = list_offsets[list + 1];
    for (uint pos = begin + sg; pos < end; pos += NSG) {
      int candidate = list_ids[pos];
      if (candidate < 0 || uint(candidate) >= params.n_reference) continue;
      float partial = 0.0f;
      const device float* point =
        reference + flat_offset(uint(candidate), params.p);
      for (uint d = lane; d < params.p; d += SIMD_WIDTH) {
        float delta = query_row[d] - point[d];
        partial = fma(delta, delta, partial);
      }
      float distance = simd_sum(partial);
      if (lane == 0) {
        insert_sorted(
          local_dist, local_id, fine_base, params.k, distance, candidate
        );
      }
    }
  }
  threadgroup_barrier(mem_flags::mem_threadgroup);

  if (tid == 0) {
    uint heads[NSG];
    for (uint g = 0; g < NSG; ++g) heads[g] = 0;
    for (uint rank = 0; rank < params.k; ++rank) {
      float best_d = INFINITY;
      int best_i = -1;
      uint best_g = 0;
      for (uint g = 0; g < NSG; ++g) {
        uint h = heads[g];
        if (h < params.k) {
          uint pos = g * params.k + h;
          if (better_pair(local_dist[pos], local_id[pos], best_d, best_i)) {
            best_d = local_dist[pos];
            best_i = local_id[pos];
            best_g = g;
          }
        }
      }
      out_dist[flat_offset(q, params.k) + rank] = best_d;
      out_ids[flat_offset(q, params.k) + rank] = best_i;
      ++heads[best_g];
    }
  }
}

kernel void ivf_topk_fused(
    device const float* data [[buffer(0)]],
    device const float* projected [[buffer(1)]],
    device const float* centroids [[buffer(2)]],
    device const uint* list_offsets [[buffer(3)]],
    device const int* list_ids [[buffer(4)]],
    device int* out_ids [[buffer(5)]],
    device float* out_dist [[buffer(6)]],
    constant SearchParams& params [[buffer(7)]],
    uint qlocal [[threadgroup_position_in_grid]],
    uint tid [[thread_position_in_threadgroup]],
    uint lane [[thread_index_in_simdgroup]],
    uint sg [[simdgroup_index_in_threadgroup]]) {
  threadgroup float query[MAX_P];
  threadgroup float coarse_dist[NSG * MAX_PROBE];
  threadgroup int coarse_id[NSG * MAX_PROBE];
  threadgroup int probes[MAX_PROBE];
  threadgroup float local_dist[NSG * MAX_K];
  threadgroup int local_id[NSG * MAX_K];
  uint q = params.query_offset + qlocal;
  if (q >= params.n) return;

  for (uint d = tid; d < params.p; d += NSG * SIMD_WIDTH) query[d] = data[flat_offset(q, params.p) + d];
  for (uint i = tid; i < NSG * params.nprobe; i += NSG * SIMD_WIDTH) {
    coarse_dist[i] = INFINITY;
    coarse_id[i] = -1;
  }
  for (uint i = tid; i < NSG * params.k; i += NSG * SIMD_WIDTH) {
    local_dist[i] = INFINITY;
    local_id[i] = -1;
  }
  threadgroup_barrier(mem_flags::mem_threadgroup);

  uint coarse_base = sg * params.nprobe;
  const device float* qproj = projected + flat_offset(q, params.qdim);
  for (uint c = sg; c < params.nlist; c += NSG) {
    float partial = 0.0f;
    const device float* centroid = centroids + c * params.qdim;
    for (uint d = lane; d < params.qdim; d += SIMD_WIDTH) {
      float delta = qproj[d] - centroid[d];
      partial = fma(delta, delta, partial);
    }
    float distance = simd_sum(partial);
    if (lane == 0) insert_sorted(coarse_dist, coarse_id, coarse_base, params.nprobe, distance, int(c));
  }
  threadgroup_barrier(mem_flags::mem_threadgroup);

  if (tid == 0) {
    uint heads[NSG];
    for (uint g = 0; g < NSG; ++g) heads[g] = 0;
    for (uint rank = 0; rank < params.nprobe; ++rank) {
      float best_d = INFINITY;
      int best_i = -1;
      uint best_g = 0;
      for (uint g = 0; g < NSG; ++g) {
        uint h = heads[g];
        if (h < params.nprobe) {
          uint pos = g * params.nprobe + h;
          if (better_pair(coarse_dist[pos], coarse_id[pos], best_d, best_i)) {
            best_d = coarse_dist[pos]; best_i = coarse_id[pos]; best_g = g;
          }
        }
      }
      probes[rank] = best_i;
      ++heads[best_g];
    }
  }
  threadgroup_barrier(mem_flags::mem_threadgroup);

  uint fine_base = sg * params.k;
  for (uint probe = 0; probe < params.nprobe; ++probe) {
    int list = probes[probe];
    if (list < 0 || uint(list) >= params.nlist) continue;
    uint begin = list_offsets[list];
    uint end = list_offsets[list + 1];
    for (uint pos = begin + sg; pos < end; pos += NSG) {
      int candidate = list_ids[pos];
      if (candidate < 0 || uint(candidate) == q) continue;
      float partial = 0.0f;
      const device float* point = data + flat_offset(uint(candidate), params.p);
      for (uint d = lane; d < params.p; d += SIMD_WIDTH) {
        float delta = query[d] - point[d];
        partial = fma(delta, delta, partial);
      }
      float distance = simd_sum(partial);
      if (lane == 0) insert_sorted(local_dist, local_id, fine_base, params.k, distance, candidate);
    }
  }
  threadgroup_barrier(mem_flags::mem_threadgroup);

  if (tid == 0) {
    uint heads[NSG];
    for (uint g = 0; g < NSG; ++g) heads[g] = 0;
    for (uint rank = 0; rank < params.k; ++rank) {
      float best_d = INFINITY;
      int best_i = -1;
      uint best_g = 0;
      for (uint g = 0; g < NSG; ++g) {
        uint h = heads[g];
        if (h < params.k) {
          uint pos = g * params.k + h;
          if (better_pair(local_dist[pos], local_id[pos], best_d, best_i)) {
            best_d = local_dist[pos]; best_i = local_id[pos]; best_g = g;
          }
        }
      }
      out_dist[flat_offset(qlocal, params.k) + rank] = best_d;
      out_ids[flat_offset(qlocal, params.k) + rank] = best_i;
      ++heads[best_g];
    }
  }
}

kernel void ivf_projected_shortlist(
    device const float* projected [[buffer(0)]],
    device const float* centroids [[buffer(1)]],
    device const uint* list_offsets [[buffer(2)]],
    device const int* list_ids [[buffer(3)]],
    device int* candidate_ids [[buffer(4)]],
    constant SearchParams& params [[buffer(5)]],
    threadgroup uint* scratch [[threadgroup(0)]],
    uint qlocal [[threadgroup_position_in_grid]],
    uint tid [[thread_position_in_threadgroup]],
    uint lane [[thread_index_in_simdgroup]],
    uint sg [[simdgroup_index_in_threadgroup]]) {
  threadgroup float query[MAX_Q];
  uint q = params.query_offset + qlocal;
  if (q >= params.n || params.nprobe == 0 || params.nprobe > MAX_PROBE ||
      params.shortlist_per_group == 0 ||
      params.shortlist_per_group > MAX_SHORTLIST) return;
  const uint coarse_count = NSG * params.nprobe;
  const uint shortlist_count = NSG * params.shortlist_per_group;
  auto coarse_dist = reinterpret_cast<threadgroup float*>(scratch);
  auto coarse_id = reinterpret_cast<threadgroup int*>(scratch + coarse_count);
  auto probes = coarse_id + coarse_count;
  auto candidate_dist =
    reinterpret_cast<threadgroup float*>(probes + params.nprobe);
  auto candidate_local_id =
    reinterpret_cast<threadgroup int*>(candidate_dist + shortlist_count);

  for (uint d = tid; d < params.qdim; d += NSG * SIMD_WIDTH) {
    query[d] = projected[flat_offset(q, params.qdim) + d];
  }
  for (uint i = tid; i < NSG * params.nprobe; i += NSG * SIMD_WIDTH) {
    coarse_dist[i] = INFINITY;
    coarse_id[i] = -1;
  }
  for (uint i = tid; i < NSG * params.shortlist_per_group; i += NSG * SIMD_WIDTH) {
    candidate_dist[i] = INFINITY;
    candidate_local_id[i] = -1;
  }
  threadgroup_barrier(mem_flags::mem_threadgroup);

  uint coarse_base = sg * params.nprobe;
  for (uint c = sg; c < params.nlist; c += NSG) {
    float partial = 0.0f;
    const device float* centroid = centroids + c * params.qdim;
    for (uint d = lane; d < params.qdim; d += SIMD_WIDTH) {
      float delta = query[d] - centroid[d];
      partial = fma(delta, delta, partial);
    }
    float distance = simd_sum(partial);
    if (lane == 0) {
      insert_sorted(coarse_dist, coarse_id, coarse_base, params.nprobe,
                    distance, int(c));
    }
  }
  threadgroup_barrier(mem_flags::mem_threadgroup);

  if (tid == 0) {
    uint heads[NSG];
    for (uint g = 0; g < NSG; ++g) heads[g] = 0;
    for (uint rank = 0; rank < params.nprobe; ++rank) {
      float best_d = INFINITY;
      int best_i = -1;
      uint best_g = 0;
      for (uint g = 0; g < NSG; ++g) {
        uint h = heads[g];
        if (h < params.nprobe) {
          uint pos = g * params.nprobe + h;
          if (better_pair(coarse_dist[pos], coarse_id[pos], best_d, best_i)) {
            best_d = coarse_dist[pos];
            best_i = coarse_id[pos];
            best_g = g;
          }
        }
      }
      probes[rank] = best_i;
      ++heads[best_g];
    }
  }
  threadgroup_barrier(mem_flags::mem_threadgroup);

  uint candidate_base = sg * params.shortlist_per_group;
  for (uint probe = 0; probe < params.nprobe; ++probe) {
    int list = probes[probe];
    if (list < 0 || uint(list) >= params.nlist) continue;
    uint begin = list_offsets[list];
    uint end = list_offsets[list + 1];
    for (uint pos = begin + sg; pos < end; pos += NSG) {
      int candidate = list_ids[pos];
      if (candidate < 0 || uint(candidate) == q) continue;
      float partial = 0.0f;
      const device float* point = projected + flat_offset(uint(candidate), params.qdim);
      for (uint d = lane; d < params.qdim; d += SIMD_WIDTH) {
        float delta = query[d] - point[d];
        partial = fma(delta, delta, partial);
      }
      float distance = simd_sum(partial);
      if (lane == 0) {
        offer_shortlist(candidate_dist + candidate_base,
          candidate_local_id + candidate_base, params.shortlist_per_group,
          distance, candidate);
      }
    }
  }
  threadgroup_barrier(mem_flags::mem_threadgroup);

  uint shortlist_size = NSG * params.shortlist_per_group;
  uint output_base = qlocal * shortlist_size;
  for (uint i = tid; i < shortlist_size; i += NSG * SIMD_WIDTH) {
    candidate_ids[output_base + i] = candidate_local_id[i];
  }
}

kernel void ivf_exact_rerank_shortlist(
    device const float* data [[buffer(0)]],
    device const int* candidate_ids [[buffer(1)]],
    device int* out_ids [[buffer(2)]],
    device float* out_dist [[buffer(3)]],
    constant SearchParams& params [[buffer(4)]],
    uint qlocal [[threadgroup_position_in_grid]],
    uint tid [[thread_position_in_threadgroup]],
    uint lane [[thread_index_in_simdgroup]],
    uint sg [[simdgroup_index_in_threadgroup]]) {
  threadgroup float query[MAX_P];
  threadgroup float local_dist[NSG * MAX_K];
  threadgroup int local_id[NSG * MAX_K];
  uint q = params.query_offset + qlocal;
  if (q >= params.n || params.shortlist_per_group > MAX_SHORTLIST) return;

  for (uint d = tid; d < params.p; d += NSG * SIMD_WIDTH) {
    query[d] = data[flat_offset(q, params.p) + d];
  }
  for (uint i = tid; i < NSG * params.k; i += NSG * SIMD_WIDTH) {
    local_dist[i] = INFINITY;
    local_id[i] = -1;
  }
  threadgroup_barrier(mem_flags::mem_threadgroup);

  uint shortlist_size = NSG * params.shortlist_per_group;
  uint candidate_base = qlocal * shortlist_size;
  uint local_base = sg * params.k;
  for (uint pos = sg; pos < shortlist_size; pos += NSG) {
    int candidate = candidate_ids[candidate_base + pos];
    if (candidate < 0 || uint(candidate) == q) continue;
    float partial = 0.0f;
    const device float* point = data + flat_offset(uint(candidate), params.p);
    for (uint d = lane; d < params.p; d += SIMD_WIDTH) {
      float delta = query[d] - point[d];
      partial = fma(delta, delta, partial);
    }
    float distance = simd_sum(partial);
    if (lane == 0) {
      insert_sorted(local_dist, local_id, local_base, params.k,
                    distance, candidate);
    }
  }
  threadgroup_barrier(mem_flags::mem_threadgroup);

  if (tid == 0) {
    uint heads[NSG];
    for (uint g = 0; g < NSG; ++g) heads[g] = 0;
    for (uint rank = 0; rank < params.k; ++rank) {
      float best_d = INFINITY;
      int best_i = -1;
      uint best_g = 0;
      for (uint g = 0; g < NSG; ++g) {
        uint h = heads[g];
        if (h < params.k) {
          uint pos = g * params.k + h;
          if (better_pair(local_dist[pos], local_id[pos], best_d, best_i)) {
            best_d = local_dist[pos];
            best_i = local_id[pos];
            best_g = g;
          }
        }
      }
      out_dist[flat_offset(qlocal, params.k) + rank] = best_d;
      out_ids[flat_offset(qlocal, params.k) + rank] = best_i;
      ++heads[best_g];
    }
  }
}
constant uint CAGRA_POOL = 512;
constant uint CAGRA_INITIAL = 128;
constant uint CAGRA_RANK_HASH = 512;

constant uint NND_NEW = 0x80000000u;
constant uint NND_ID = 0x7fffffffu;
constant uint NND_REVERSE = 4;
constant uint NND_MAX_PIVOTS = 16;

struct NndParams {
  uint n, p, degree, offset;
  uint round, pivots, last;
  uint multiplier, inverse, shift;
  uint claim_slots, partition_ranked;
};

inline uint nnd_hash(uint key) {
  key ^= key >> 16;
  key *= 0x7feb352du;
  key ^= key >> 15;
  return key;
}

// Hash random projections into buckets before comparing nearby seed rows.
// One SIMD group computes a signature for each row.
kernel void cagra_nnd_seed_signature(
    device const float* data [[buffer(0)]],
    device const float* planes [[buffer(1)]],
    device const float* centers [[buffer(2)]],
    device uint* signatures [[buffer(3)]],
    constant uint4& spec [[buffer(4)]],
    uint group [[threadgroup_position_in_grid]],
    uint sg [[simdgroup_index_in_threadgroup]],
    uint lane [[thread_index_in_simdgroup]]) {
  const uint row = spec.w + group * NSG + sg;
  if (row >= spec.x) return;
  const device float* point = data + flat_offset(row, spec.y);
  float values[4];
  for (uint d = lane, block = 0; d < spec.y; d += SIMD_WIDTH, ++block)
    values[block] = point[d];
  uint code = 0;
  for (uint bit = 0; bit < spec.z; ++bit) {
    const device float* plane = planes + flat_offset(bit, spec.y);
    float projected = 0;
    for (uint d = lane, block = 0; d < spec.y; d += SIMD_WIDTH, ++block)
      projected = fma(values[block], plane[d], projected);
    const float score = simd_sum(projected);
    code |= uint(score >= centers[bit]) << bit;
  }
  if (lane == 0) signatures[row] = code;
}

// Each round reads a complete snapshot. Keep bounded reciprocal hints for
// new edges, with stable conflict resolution even when many rows target a hub.
kernel void cagra_nnd_reverse(
    device const uint* graph [[buffer(0)]],
    device atomic_uint* reverse [[buffer(1)]],
    constant NndParams& params [[buffer(2)]],
    uint2 item [[thread_position_in_grid]]) {
  const uint row = item.y + params.offset;
  const uint edge = graph[flat_offset(row, params.degree) + item.x];
  const uint to = edge & NND_ID;
  if ((edge & NND_NEW) == 0 || to >= params.n) return;
  const uint key = row ^ params.shift;
  const uint slot = nnd_hash(key) & (NND_REVERSE - 1u);
  atomic_fetch_min_explicit(reverse + flat_offset(to, NND_REVERSE) + slot,
    key, memory_order_relaxed);
}

inline bool nnd_claim(threadgroup atomic_uint* keys, uint slots, uint id,
    bool retained) {
  const uint key = id + 1u;
  const uint value = retained ? key | NND_NEW : key;
  uint slot = nnd_hash(key) & (slots - 1u);
  for (uint probe = 0; probe < slots; ++probe) {
    threadgroup atomic_uint* entry = keys + slot;
    uint old = atomic_load_explicit(entry, memory_order_relaxed);
    while (old == 0) {
      if (atomic_compare_exchange_weak_explicit(entry, &old, value,
          memory_order_relaxed, memory_order_relaxed)) return true;
    }
    if ((old & NND_ID) == key) return false;
    slot = (slot + 1u) & (slots - 1u);
  }
  return false;
}

inline bool nnd_retained(threadgroup atomic_uint* keys, uint slots, uint id) {
  const uint key = id + 1u;
  uint slot = nnd_hash(key) & (slots - 1u);
  for (uint probe = 0; probe < slots; ++probe) {
    const uint value = atomic_load_explicit(keys + slot, memory_order_relaxed);
    if (value == 0) return false;
    if ((value & NND_ID) == key) return (value & NND_NEW) != 0;
    slot = (slot + 1u) & (slots - 1u);
  }
  return false;
}

inline void nnd_choose_pivots(device const uint* prior,
    threadgroup uint* pivots, uint n, uint degree, uint slots, uint begin) {
  const uint fresh_limit = (slots + 1u) / 2u;
  const uint old_limit = slots - fresh_limit;
  uint fresh = 0, old = 0;
  ulong used[2] = {0, 0};
  for (uint j = 0; j < slots; ++j) pivots[j] = n;
  for (uint j = 0; j < degree &&
      (fresh < fresh_limit || old < old_limit); ++j) {
    const uint rank = (begin + j) % degree;
    const uint edge = prior[rank];
    const uint id = edge & NND_ID;
    if (id >= n) continue;
    if ((edge & NND_NEW) != 0) {
      if (fresh == fresh_limit) continue;
      pivots[fresh++] = id;
    } else {
      if (old == old_limit) continue;
      pivots[fresh_limit + old++] = id;
    }
    used[rank >> 6u] |= ulong(1) << (rank & 63u);
  }
  if (fresh + old == slots) return;

  // When a class runs out, fill its vacancies from the closest unchosen rows.
  uint rank = 0;
  for (uint j = 0; j < slots && rank < degree; ++j) {
    if (pivots[j] < n) continue;
    while (rank < degree) {
      const uint id = prior[rank] & NND_ID;
      const bool picked = (used[rank >> 6u] & (ulong(1) << (rank & 63u))) != 0;
      ++rank;
      if (id >= n || picked) continue;
      pivots[j] = id;
      break;
    }
  }
}

// Seeding compares a handful of deterministic random blocks in float32.
// Refinement visits old edges and the neighbors of sampled new/old pivots
// and reciprocal hints. A threadgroup owns each output row.
kernel void cagra_nnd_update(
    device const float* data [[buffer(0)]],
    device const uint* prior [[buffer(1)]],
    device uint* next [[buffer(2)]],
    device const uint* reverse [[buffer(3)]],
    constant NndParams& params [[buffer(4)]],
    device const uint* seed_order [[buffer(5)]],
    device const uint* seed_position [[buffer(6)]],
    threadgroup atomic_uint* claims [[threadgroup(0)]],
    threadgroup float* query [[threadgroup(1)]],
    uint group [[threadgroup_position_in_grid]],
    uint tid [[thread_position_in_threadgroup]],
    uint lane [[thread_index_in_simdgroup]],
    uint sg [[simdgroup_index_in_threadgroup]]) {
  const uint row = params.offset + group;
  const bool seed = params.pivots == 0;
  const bool has_prior = !seed || params.round > 0;
  const uint degree = params.degree;
  const uint threads = NSG * SIMD_WIDTH;
  const device uint* previous = prior + flat_offset(row, degree);
  device uint* output = next + flat_offset(row, degree);
  const device float* point = data + flat_offset(row, params.p);
  threadgroup float ds[NSG * CAGRA_INITIAL];
  threadgroup int ids[NSG * CAGRA_INITIAL];
  threadgroup uint pivots[NND_MAX_PIVOTS + NND_REVERSE];
  threadgroup uint selected[CAGRA_INITIAL];
  for (uint d = tid; d < params.p; d += threads) query[d] = point[d];
  for (uint i = tid; i < params.claim_slots; i += threads) {
    atomic_store_explicit(claims + i, 0u, memory_order_relaxed);
  }
  for (uint i = tid; i < NSG * degree; i += threads) {
    ds[i] = INFINITY;
    ids[i] = -1;
  }
  if (!seed && tid == 0) {
    const uint begin = nnd_hash(row ^ params.shift) % degree;
    nnd_choose_pivots(previous, pivots, params.n, degree, params.pivots, begin);
    for (uint j = 0; j < NND_REVERSE; ++j) {
      const uint key = reverse[flat_offset(row, NND_REVERSE) + j];
      pivots[params.pivots + j] = key == 0xffffffffu ? params.n : key ^ params.shift;
    }
  }
  threadgroup_barrier(mem_flags::mem_threadgroup);
  if (!seed) {
    // First tag the stored neighbors in the same table used for deduplication.
    // Later we can test freshness without scanning the previous row per edge.
    if (tid < degree) {
      const uint id = previous[tid] & NND_ID;
      if (id < params.n && id != row) nnd_claim(claims, params.claim_slots, id, true);
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
  }
  const uint block = seed ? min(params.n, 256u) : 0u;
  uint block_first = 0;
  if (seed) {
    const uint unshifted = (row + params.n - params.shift) % params.n;
    const uint position = params.partition_ranked != 0 ? seed_position[row] :
      uint(size_t(unshifted) * params.inverse % params.n);
    block_first = position / block * block;
  }
  const uint retained = has_prior ? degree : 0u;
  const uint work = seed ? block : (params.pivots + NND_REVERSE) * (degree + 1u);
  for (uint i = sg; i < retained + work; i += NSG) {
    uint id = params.n;
    if (lane == 0) {
      if (i < retained) {
        id = previous[i] & NND_ID;
      } else if (seed) {
        const uint pos = (block_first + i - retained) % params.n;
        id = params.partition_ranked != 0 ? seed_order[pos] :
          uint((size_t(pos) * params.multiplier + params.shift) % params.n);
      } else {
        const uint entry = i - retained;
        const uint pivot = pivots[entry / (degree + 1u)];
        const uint rank = entry % (degree + 1u);
        if (pivot < params.n) {
          id = rank == degree ? pivot :
            prior[flat_offset(pivot, degree) + rank] & NND_ID;
        }
      }
      const bool preclaimed = !seed && i < retained;
      if (id >= params.n || id == row ||
          (!preclaimed && !nnd_claim(claims, params.claim_slots, id, false))) id = params.n;
    }
    id = simd_broadcast_first(id);
    if (id < params.n) {
      const device float* candidate = data + flat_offset(id, params.p);
      float partial = 0.0f;
      for (uint d = lane; d < params.p; d += SIMD_WIDTH) {
        const float delta = query[d] - candidate[d];
        partial = fma(delta, delta, partial);
      }
      const float distance = simd_sum(partial);
      if (lane == 0) offer_shortlist(ds + sg * degree, ids + sg * degree,
        degree, distance, int(id));
    }
  }
  if (lane == 0) sort_shortlist_heap(ds + sg * degree, ids + sg * degree, degree);
  threadgroup_barrier(mem_flags::mem_threadgroup);
  if (tid == 0) {
    uint heads[NSG] = {0, 0, 0, 0};
    for (uint rank = 0; rank < degree; ++rank) {
      float best_distance = INFINITY;
      int best_id = -1;
      uint best_group = 0;
      for (uint g = 0; g < NSG; ++g) {
        if (heads[g] == degree) continue;
        const uint pos = g * degree + heads[g];
        if (better_pair(ds[pos], ids[pos], best_distance, best_id)) {
          best_distance = ds[pos];
          best_id = ids[pos];
          best_group = g;
        }
      }
      selected[rank] = best_id < 0 ? params.n : uint(best_id);
      if (best_id >= 0) ++heads[best_group];
    }
  }
  threadgroup_barrier(mem_flags::mem_threadgroup);
  if (tid < degree) {
    uint id = selected[tid];
    if (params.last == 0 && id < params.n &&
        (seed || !nnd_retained(claims, params.claim_slots, id)))
      id |= NND_NEW;
    output[tid] = id;
  }
}

// A rank batch packs the reference rank and source row into one uint.
kernel void cagra_reverse_select(
    device const uint* graph [[buffer(0)]],
    device atomic_uint* keys [[buffer(1)]],
    device const uint* counts [[buffer(2)]],
    constant uint4& spec [[buffer(3)]],
    uint2 item [[thread_position_in_grid]]) {
  const uint n = spec.x, degree = spec.y;
  const uint row = item.y + spec.w;
  const uint target = graph[flat_offset(row, degree) + spec.z + item.x];
  if (target >= n || target == row) return;
  const uint half_degree = degree / 2u;
  const uint first = counts[target];
  if (first == half_degree) return;
  device atomic_uint* slots = keys + flat_offset(target, half_degree);
  uint key = item.x * n + row;
  if (key >= atomic_load_explicit(slots + half_degree - 1,
      memory_order_relaxed)) return;
  for (uint j = first; j < half_degree; ++j) {
    const uint prior = atomic_fetch_min_explicit(slots + j, key,
      memory_order_relaxed);
    if (prior == 0xffffffffu) return;
    key = max(prior, key);
  }
}

kernel void cagra_reverse_collect(
    device const uint* keys [[buffer(0)]],
    device uint* incoming [[buffer(1)]],
    device uint* counts [[buffer(2)]],
    constant uint4& spec [[buffer(3)]],
    uint2 item [[thread_position_in_grid]]) {
  const uint row = item.y + spec.w, half_degree = spec.y / 2u;
  const size_t base = flat_offset(row, half_degree);
  uint count = counts[row];
  for (; count < half_degree; ++count) {
    const uint key = keys[base + count];
    if (key == 0xffffffffu) break;
    incoming[base + count] = key % spec.x;
  }
  counts[row] = count;
}

inline void cagra_reverse_append(device uint* output, thread uint& filled,
    uint id, uint n, uint row, uint degree) {
  if (filled == degree || id >= n || id == row) return;
  for (uint j = 0; j < filled; ++j) {
    if (output[j] == id) return;
  }
  output[filled++] = id;
}

kernel void cagra_reverse_merge(
    device uint* graph [[buffer(0)]],
    device const uint* incoming [[buffer(1)]],
    device const uint* counts [[buffer(2)]],
    constant uint4& spec [[buffer(3)]],
    uint2 item [[thread_position_in_grid]]) {
  const uint n = spec.x, degree = spec.y, row = item.y + spec.w;
  const uint half_degree = degree / 2u;
  device uint* output = graph + flat_offset(row, degree);
  device const uint* reverse = incoming + flat_offset(row, half_degree);
  uint forward[64];
  for (uint j = 0; j < degree; ++j) forward[j] = output[j];
  uint filled = 0;
  for (uint j = 0; j < half_degree; ++j) {
    cagra_reverse_append(output, filled, forward[j], n, row, degree);
  }
  for (uint j = 0; j < counts[row]; ++j) {
    cagra_reverse_append(output, filled, reverse[j], n, row, degree);
  }
  for (uint j = half_degree; j < degree; ++j) {
    cagra_reverse_append(output, filled, forward[j], n, row, degree);
  }
  for (uint j = filled; j < degree; ++j) output[j] = n;
}

struct CagraPruneParams {
  uint n;
  uint initial_degree;
  uint degree;
  uint offset;
};

// A two-hop path through an earlier neighbor is a detour when both of
// its edge ranks are below the direct edge's rank. Prefer edges with
// fewer detours, using the original rank to break ties.
kernel void cagra_rank_prune(
    device const uint* initial [[buffer(0)]],
    device uint* graph [[buffer(1)]],
    constant CagraPruneParams& params [[buffer(2)]],
    uint group [[threadgroup_position_in_grid]],
    uint tid [[thread_position_in_threadgroup]]) {
  const uint row = group + params.offset;
  if (row >= params.n) return;
  threadgroup uint keys[CAGRA_RANK_HASH];
  threadgroup uint ranks[CAGRA_RANK_HASH];
  threadgroup atomic_uint detours[CAGRA_INITIAL];
  threadgroup uint order[CAGRA_INITIAL];
  for (uint slot = tid; slot < CAGRA_RANK_HASH; slot += CAGRA_INITIAL) {
    keys[slot] = 0;
  }
  atomic_store_explicit(detours + tid, 0u, memory_order_relaxed);
  threadgroup_barrier(mem_flags::mem_threadgroup);
  const device uint* rank_row = initial + flat_offset(row, params.initial_degree);
  if (tid == 0) {
    for (uint rank = 0; rank < params.initial_degree; ++rank) {
      if (rank_row[rank] >= params.n) continue;
      const uint key = rank_row[rank] + 1u;
      uint slot = (key * 2654435761u) >> 23;
      while (keys[slot] != 0) slot = (slot + 1u) & (CAGRA_RANK_HASH - 1u);
      keys[slot] = key;
      ranks[slot] = rank;
    }
  }
  threadgroup_barrier(mem_flags::mem_threadgroup);
  const bool valid = tid < params.initial_degree && rank_row[tid] < params.n;
  if (valid) {
    const device uint* through =
      initial + flat_offset(rank_row[tid], params.initial_degree);
    for (uint other_rank = 0; other_rank < params.initial_degree; ++other_rank) {
      if (through[other_rank] >= params.n) continue;
      const uint key = through[other_rank] + 1u;
      uint slot = (key * 2654435761u) >> 23;
      while (keys[slot] != 0 && keys[slot] != key) {
        slot = (slot + 1u) & (CAGRA_RANK_HASH - 1u);
      }
      if (keys[slot] == key && max(tid, other_rank) < ranks[slot]) {
        atomic_fetch_add_explicit(detours + ranks[slot], 1u, memory_order_relaxed);
      }
    }
  }
  threadgroup_barrier(mem_flags::mem_threadgroup);
  order[tid] = valid ?
    (atomic_load_explicit(detours + tid, memory_order_relaxed) << 8) | tid :
    0xffffffffu;
  threadgroup_barrier(mem_flags::mem_threadgroup);
  for (uint span = 2; span <= CAGRA_INITIAL; span <<= 1) {
    for (uint offset = span >> 1; offset > 0; offset >>= 1) {
      const uint peer = tid ^ offset;
      if (tid < peer) {
        const uint left = order[tid], right = order[peer];
        const bool up = (tid & span) == 0;
        order[tid] = up ? min(left, right) : max(left, right);
        order[peer] = up ? max(left, right) : min(left, right);
      }
      threadgroup_barrier(mem_flags::mem_threadgroup);
    }
  }
  if (tid < params.degree) {
    graph[flat_offset(row, params.degree) + tid] = order[tid] == 0xffffffffu ?
      params.n : rank_row[order[tid] & 255u];
  }
}

struct CagraSearchParams {
  uint n;
  uint p;
  uint k;
  uint degree;
  uint queue;
  uint width;
  uint steps;
  uint query_offset;
  uint visit_slots;
};

inline bool cagra_visit(device atomic_uint* visited, uint id, uint slots) {
  const uint value = id + 1;
  uint offset = (value * 2654435761u) >> 18;
  for (uint probe = 0; probe < slots; ++probe) {
    device atomic_uint* slot = visited + offset;
    uint previous = atomic_load_explicit(slot, memory_order_relaxed);
    if (previous == value) return false;
    while (previous == 0) {
      if (atomic_compare_exchange_weak_explicit(slot, &previous, value,
            memory_order_relaxed, memory_order_relaxed)) return true;
      if (previous == value) return false;
    }
    offset = (offset + 1u) & (slots - 1u);
  }
  return false;
}

// Merge once per frontier instead of shifting the queue for each new edge.
inline uint cagra_merge_candidates(threadgroup uint* ids, threadgroup float* ds,
    threadgroup bool* expanded, uint size, uint capacity,
    threadgroup int* candidates, threadgroup float* distances,
    uint work, uint n) {
  uint accepted = 0;
  for (uint i = 0; i < work; ++i) {
    if (candidates[i] >= int(n)) continue;
    if (size == capacity && !better_pair(distances[i], candidates[i],
        ds[size - 1u], int(ids[size - 1u]))) continue;
    candidates[accepted] = candidates[i];
    distances[accepted++] = distances[i];
  }
  if (accepted == 0) return size;
  for (uint i = accepted / 2u; i > 0; --i) {
    const uint parent = i - 1u;
    sift_shortlist(distances, candidates, accepted, parent,
      distances[parent], candidates[parent]);
  }
  sort_shortlist_heap(distances, candidates, accepted);

  // Find the two prefixes that will fit, then merge them from the end.
  const uint total = min(size + accepted, capacity);
  uint low = total > accepted ? total - accepted : 0u;
  uint high = min(size, total);
  while (low < high) {
    const uint old_rank = low + (high - low) / 2u;
    const uint new_rank = total - old_rank - 1u;
    if (!better_pair(distances[new_rank], candidates[new_rank],
        ds[old_rank], int(ids[old_rank]))) low = old_rank + 1u;
    else high = old_rank;
  }
  uint old_count = low;
  uint new_count = total - old_count;
  for (uint write = total; new_count > 0;) {
    const uint slot = --write;
    const uint next = new_count - 1u;
    const bool use_old = old_count > 0 && better_pair(
      distances[next], candidates[next], ds[old_count - 1u],
      int(ids[old_count - 1u]));
    if (use_old) {
      const uint from = --old_count;
      ids[slot] = ids[from];
      ds[slot] = ds[from];
      expanded[slot] = expanded[from];
    } else {
      ids[slot] = uint(candidates[next]);
      ds[slot] = distances[next];
      expanded[slot] = false;
      --new_count;
    }
  }
  return total;
}

// Self search starts at the query vertex, then expands the best unvisited
// vertices in a bounded working set. A SIMD group scores one neighbor at
// a time with direct squared L2. Each query owns its visited table.
kernel void cagra_search_self(
    device const float* data [[buffer(0)]],
    device const uint* graph [[buffer(1)]],
    device int* out_ids [[buffer(2)]],
    device float* out_dist [[buffer(3)]],
    device atomic_uint* visit_tables [[buffer(4)]],
    constant CagraSearchParams& params [[buffer(5)]],
    threadgroup uint* edge_storage [[threadgroup(0)]],
    uint group [[threadgroup_position_in_grid]],
    uint tid [[thread_position_in_threadgroup]],
    uint lane [[thread_index_in_simdgroup]],
    uint sg [[simdgroup_index_in_threadgroup]]) {
  const uint q = group + params.query_offset;
  const device float* point = data + flat_offset(q, params.p);
  device atomic_uint* visited =
    visit_tables + size_t(group) * params.visit_slots;
  threadgroup uint ids[CAGRA_POOL];
  threadgroup float ds[CAGRA_POOL];
  threadgroup bool expanded[CAGRA_POOL];
  threadgroup uint heads[NSG];
  threadgroup int* candidates = reinterpret_cast<threadgroup int*>(edge_storage);
  threadgroup float* distances = reinterpret_cast<threadgroup float*>(
    edge_storage + params.width * params.degree);
  threadgroup uint size;
  threadgroup uint frontier;
  for (uint i = tid; i < params.visit_slots; i += NSG * SIMD_WIDTH) {
    atomic_store_explicit(visited + i, 0, memory_order_relaxed);
  }
  threadgroup_barrier(mem_flags::mem_threadgroup | mem_flags::mem_device);
  if (tid == 0) {
    cagra_visit(visited, q, params.visit_slots);
    ids[0] = q;
    ds[0] = 0;
    expanded[0] = false;
    size = 1;
  }
  threadgroup_barrier(mem_flags::mem_threadgroup);

  for (uint step = 0; step < params.steps; ++step) {
    if (tid == 0) {
      frontier = 0;
      for (uint i = 0; i < size && frontier < params.width; ++i) {
        if (!expanded[i]) {
          expanded[i] = true;
          heads[frontier++] = ids[i];
        }
      }
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    const uint work = frontier * params.degree;
    if (work == 0) break;
    // SIMD groups score this frontier before merging into the sorted queue.
    for (uint edge = sg; edge < work; edge += NSG) {
      uint id = params.n;
      if (lane == 0) {
        id = graph[flat_offset(heads[edge / params.degree], params.degree) +
            edge % params.degree];
        if (id < params.n && !cagra_visit(visited, id, params.visit_slots)) {
          id = params.n;
        }
        candidates[edge] = int(id);
      }
      id = simd_broadcast_first(id);
      if (id >= params.n) continue;
      float partial = 0;
      const device float* current = data + flat_offset(id, params.p);
      for (uint d = lane; d < params.p; d += SIMD_WIDTH) {
        const float diff = point[d] - current[d];
        partial = fma(diff, diff, partial);
      }
      const float distance = simd_sum(partial);
      if (lane == 0) distances[edge] = distance;
    }
    threadgroup_barrier(mem_flags::mem_threadgroup | mem_flags::mem_device);
    if (tid == 0) {
      size = cagra_merge_candidates(ids, ds, expanded, size, params.queue,
        candidates, distances, work, params.n);
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
  }

  if (tid == 0) {
    const size_t base = flat_offset(group, params.k);
    uint found = 0;
    for (uint i = 0; i < size && found < params.k; ++i) {
      if (ids[i] == q) continue;
      out_ids[base + found] = int(ids[i]);
      out_dist[base + found++] = ds[i];
    }
    while (found < params.k) {
      out_ids[base + found] = -1;
      out_dist[base + found++] = INFINITY;
    }
  }
}
)METAL";

struct ProjectParamsHost { std::uint32_t n, p, qdim; };
struct IndexParamsHost { std::uint32_t n, p, qdim, nlist; };
struct SearchParamsHost {
  std::uint32_t n, p, qdim, nlist, nprobe, k, query_offset, shortlist_per_group;
};

std::size_t projected_shortlist_scratch(const SearchParamsHost& params) {
  // The shader lays out probe indices and two distance/ID workspaces.
  constexpr std::size_t alignment = 16;
  const std::size_t words = params.nprobe +
    2 * kMetalSimdGroups * (params.nprobe + params.shortlist_per_group);
  const auto bytes = words * sizeof(std::uint32_t);
  return (bytes + alignment - 1) & ~(alignment - 1);
}

struct QuerySearchParamsHost {
  std::uint32_t n_reference, n_query, p, k, tile_rows;
};
struct QueryIvfParamsHost {
  std::uint32_t n_reference, n_query, p, qdim, nlist, nprobe, k;
};

id<MTLComputePipelineState> make_pipeline(id<MTLDevice> device, id<MTLLibrary> library, NSString* name) {
  id<MTLFunction> function = [library newFunctionWithName:name];
  if (!function) Rcpp::stop("missing Metal function %s", [name UTF8String]);
  NSError* error = nil;
  id<MTLComputePipelineState> result = [device newComputePipelineStateWithFunction:function error:&error];
  [function release];
  if (!result) {
    Rcpp::stop("failed to build Metal pipeline `%s`: %s",
      [name UTF8String],
      error ? [[error description] UTF8String] : "unknown");
  }
  return result;
}

struct MetalKnnState {
  id<MTLDevice> device = nil;
  id<MTLCommandQueue> queue = nil;
  id<MTLLibrary> library = nil;
  id<MTLComputePipelineState> project_pipeline = nil;
  id<MTLComputePipelineState> assign_pipeline = nil;
  id<MTLComputePipelineState> clear_centroids_pipeline = nil;
  id<MTLComputePipelineState> accumulate_centroids_pipeline = nil;
  id<MTLComputePipelineState> finalize_centroids_pipeline = nil;
  id<MTLComputePipelineState> exact_pipeline = nil;
  id<MTLComputePipelineState> exact_global_pipeline = nil;
  id<MTLComputePipelineState> exact_query_pipeline = nil;
  id<MTLComputePipelineState> exact_query_global_pipeline = nil;
  id<MTLComputePipelineState> ivf_query_pipeline = nil;
  id<MTLComputePipelineState> ivf_pipeline = nil;
  id<MTLComputePipelineState> shortlist_pipeline = nil;
  id<MTLComputePipelineState> rerank_pipeline = nil;
};

MTLCompileOptions* metal_knn_compile_options() {
  MTLCompileOptions* options = [[MTLCompileOptions alloc] init];
#if defined(__MAC_OS_X_VERSION_MAX_ALLOWED) && __MAC_OS_X_VERSION_MAX_ALLOWED >= 150000
  if (@available(macOS 15.0, *)) {
    options.mathMode = MTLMathModeFast;
  }
#else
  options.fastMathEnabled = YES;
#endif
#if defined(__MAC_OS_X_VERSION_MAX_ALLOWED) && __MAC_OS_X_VERSION_MAX_ALLOWED >= 140000
  if (@available(macOS 14.0, *)) {
    options.languageVersion = MTLLanguageVersion3_1;
    return options;
  }
#endif
#if defined(__MAC_OS_X_VERSION_MAX_ALLOWED) && __MAC_OS_X_VERSION_MAX_ALLOWED >= 130000
  if (@available(macOS 13.0, *)) {
    options.languageVersion = MTLLanguageVersion3_0;
    return options;
  }
#endif
#if defined(__MAC_OS_X_VERSION_MAX_ALLOWED) && __MAC_OS_X_VERSION_MAX_ALLOWED >= 120000
  if (@available(macOS 12.0, *)) {
    options.languageVersion = MTLLanguageVersion2_4;
    return options;
  }
#endif
  options.languageVersion = MTLLanguageVersion2_3;
  return options;
}

MetalKnnState& metal_knn_state() {
  static MetalKnnState state;
  if (state.device != nil && state.queue != nil && state.library != nil &&
      state.project_pipeline != nil && state.assign_pipeline != nil &&
      state.clear_centroids_pipeline != nil &&
      state.accumulate_centroids_pipeline != nil &&
      state.finalize_centroids_pipeline != nil &&
      state.exact_pipeline != nil && state.exact_global_pipeline != nil &&
      state.exact_query_pipeline != nil &&
      state.exact_query_global_pipeline != nil &&
      state.ivf_query_pipeline != nil &&
      state.ivf_pipeline != nil &&
      state.shortlist_pipeline != nil && state.rerank_pipeline != nil) {
    return state;
  }
  state.device = MTLCreateSystemDefaultDevice();
  if (state.device == nil) Rcpp::stop("No Metal device is available.");
  state.queue = [state.device newCommandQueue];
  MTLCompileOptions* options = metal_knn_compile_options();
  NSError* error = nil;
  state.library = [state.device
    newLibraryWithSource:[NSString stringWithUTF8String:kMetalSource]
    options:options
    error:&error];
  [options release];
  if (state.library == nil) {
    Rcpp::stop(
      "Failed to compile native Metal KNN kernels: %s",
      error ? [[error localizedDescription] UTF8String] : "unknown"
    );
  }
  state.project_pipeline = make_pipeline(state.device, state.library, @"signed_hash_project");
  state.assign_pipeline = make_pipeline(state.device, state.library, @"assign_centroid");
  state.clear_centroids_pipeline = make_pipeline(state.device, state.library, @"clear_centroid_accumulators");
  state.accumulate_centroids_pipeline = make_pipeline(state.device, state.library, @"accumulate_centroids");
  state.finalize_centroids_pipeline = make_pipeline(state.device, state.library, @"finalize_centroids");
  state.exact_pipeline = make_pipeline(state.device, state.library, @"exact_topk_simd");
  state.exact_global_pipeline = make_pipeline(
    state.device, state.library, @"exact_topk_simd_global_query"
  );
  state.exact_query_pipeline = make_pipeline(
    state.device, state.library, @"exact_query_topk_simd"
  );
  state.exact_query_global_pipeline = make_pipeline(
    state.device, state.library, @"exact_query_topk_simd_global_query"
  );
  state.ivf_query_pipeline = make_pipeline(
    state.device, state.library, @"ivf_query_topk_fused"
  );
  state.ivf_pipeline = make_pipeline(state.device, state.library, @"ivf_topk_fused");
  state.shortlist_pipeline = make_pipeline(state.device, state.library, @"ivf_projected_shortlist");
  state.rerank_pipeline = make_pipeline(state.device, state.library, @"ivf_exact_rerank_shortlist");
  return state;
}

void run_and_wait(id<MTLCommandBuffer> command) {
  [command commit];
  [command waitUntilCompleted];
  if (command.status == MTLCommandBufferStatusError) {
    Rcpp::stop("Metal KNN command failed: %s", command.error ? [[command.error localizedDescription] UTF8String] : "unknown");
  }
}

double recall_at_k(const int* truth, const int* approx, int rows, int k) {
  double hits = 0.0;
  for (int i = 0; i < rows; ++i) {
    for (int a = 0; a < k; ++a) {
      int id = approx[static_cast<std::size_t>(i) * k + a];
      for (int t = 0; t < k; ++t) {
        if (id == truth[static_cast<std::size_t>(i) * k + t]) { hits += 1.0; break; }
      }
    }
  }
  return hits / static_cast<double>(rows * k);
}

std::pair<double, double> pilot_row_quality(
    const int* truth, const float* truth_dist,
    const int* approx, const float* approx_dist, int rows, int k) {
  double min_recall = 1.0;
  double max_distance_ratio = 1.0;
  for (int i = 0; i < rows; ++i) {
    const std::size_t base = static_cast<std::size_t>(i) * k;
    int hits = 0;
    for (int a = 0; a < k; ++a) {
      for (int t = 0; t < k; ++t) {
        if (approx[base + a] == truth[base + t]) {
          ++hits;
          break;
        }
      }
    }
    min_recall = std::min(min_recall, static_cast<double>(hits) / k);
    const double exact_k = truth_dist[base + k - 1];
    const double approx_k = approx_dist[base + k - 1];
    const double ratio = exact_k > 0.0 ?
      std::sqrt(std::max(0.0, approx_k / exact_k)) :
      (approx_k == 0.0 ? 1.0 : std::numeric_limits<double>::infinity());
    max_distance_ratio = std::max(max_distance_ratio, ratio);
  }
  return {min_recall, max_distance_ratio};
}

int projection_dim(int p) {
  int q = 1;
  while (q * 2 <= p && q * 2 <= kProjectionDim) q *= 2;
  return std::max(1, q);
}

double metal_current_allocated_bytes(id<MTLDevice> device) {
  if (device == nil ||
      ![device respondsToSelector:@selector(currentAllocatedSize)]) {
    return NA_REAL;
  }
  return static_cast<double>([device currentAllocatedSize]);
}

double metal_live_buffer_bytes(
    std::initializer_list<id<MTLBuffer>> buffers) {
  double bytes = 0.0;
  for (id<MTLBuffer> buffer : buffers) {
    if (buffer != nil) bytes += static_cast<double>([buffer allocatedSize]);
  }
  return bytes;
}

id<MTLBuffer> metal_shared_buffer(id<MTLDevice> device, std::size_t bytes,
                                  const void* values = nullptr) {
  const auto limit = [device maxBufferLength];
  if (bytes > limit) {
    Rcpp::stop("Metal KNN buffer requires %.0f bytes; device limit is %.0f.",
      static_cast<double>(bytes), static_cast<double>(limit));
  }
  id<MTLBuffer> buffer = values == nullptr ?
    [device newBufferWithLength:bytes options:MTLResourceStorageModeShared] :
    [device newBufferWithBytes:values length:bytes
      options:MTLResourceStorageModeShared];
  if (buffer == nil) {
    Rcpp::stop("Metal KNN could not allocate a %.0f-byte shared buffer.",
      static_cast<double>(bytes));
  }
  return [buffer autorelease];
}

struct MetalCagraIndex {
  id<MTLBuffer> data = nil, graph = nil, visits = nil;
  id<MTLBuffer> ids = nil, distances = nil;
  id<MTLComputePipelineState> search = nil;
  std::uint32_t n, p, k, width, pool, steps;
  std::uint32_t degree, visit_slots;
  static constexpr std::uint32_t capacity = 1024;

  ~MetalCagraIndex() {
    [search release];
    [distances release];
    [ids release];
    [visits release];
    [graph release];
    [data release];
  }
};

struct MetalCagraSearchProfile {
  std::uint32_t queue;
  std::uint32_t steps;
};

MetalCagraSearchProfile metal_cagra_search_profile(const MetalCagraIndex& index) {
  SEXP option = Rf_GetOption1(Rf_install("faissR.metal_cagra_search_profile"));
  if (Rf_isNull(option)) return {index.pool, index.steps};
  if ((TYPEOF(option) != INTSXP && TYPEOF(option) != REALSXP) ||
      Rf_xlength(option) != 2) {
    Rcpp::stop("Metal CAGRA search profile needs two integers: queue size and steps");
  }
  const double queue = TYPEOF(option) == INTSXP ? INTEGER(option)[0] : REAL(option)[0];
  const double steps = TYPEOF(option) == INTSXP ? INTEGER(option)[1] : REAL(option)[1];
  // The shader has a 512-entry queue. Each step can visit at most
  // width * degree new vertices, in addition to the starting vertex.
  constexpr std::uint32_t max_queue = 512;
  const auto max_steps = (index.visit_slots - 1) / (index.width * index.degree);
  if (!std::isfinite(queue) || queue != std::floor(queue) ||
      queue <= index.k || queue > max_queue || !std::isfinite(steps) ||
      steps != std::floor(steps) || steps < 1 || steps > max_steps) {
    Rcpp::stop("Metal CAGRA search profile exceeds the queue or visited-table limits");
  }
  return {static_cast<std::uint32_t>(queue), static_cast<std::uint32_t>(steps)};
}

void cagra_add_reverse_edges(std::uint32_t* graph, std::uint32_t n,
    std::uint32_t degree) {
  const auto half = degree / 2;
  std::vector<std::uint32_t> reverse(static_cast<std::size_t>(n) * half);
  std::vector<std::uint8_t> counts(n, 0);
  for (std::uint32_t rank = 0; rank < degree; ++rank) {
    for (std::uint32_t row = 0; row < n; ++row) {
      const auto to = graph[static_cast<std::size_t>(row) * degree + rank];
      if (to >= n || to == row || counts[to] >= half) continue;
      reverse[static_cast<std::size_t>(to) * half + counts[to]++] = row;
    }
  }
  for (std::uint32_t row = 0; row < n; ++row) {
    auto* out = graph + static_cast<std::size_t>(row) * degree;
    std::array<std::uint32_t, faissr_metal::kCagraDegree> forward;
    std::copy_n(out, degree, forward.data());
    const auto* incoming = reverse.data() + static_cast<std::size_t>(row) * half;
    std::uint32_t filled = 0;
    auto add = [&](std::uint32_t id) {
      if (filled < degree && id < n && id != row &&
          std::find(out, out + filled, id) == out + filled) {
        out[filled++] = id;
      }
    };
    for (std::uint32_t j = 0; j < half; ++j) add(forward[j]);
    for (std::uint32_t j = 0; j < counts[row]; ++j) add(incoming[j]);
    for (std::uint32_t j = half; j < degree; ++j) add(forward[j]);
    std::fill(out + filled, out + degree, n);
  }
}

Rcpp::List metal_cagra_search(MetalCagraIndex& index, std::uint32_t first,
    std::uint32_t count) {
  if (first >= index.n || count == 0 || count > index.capacity ||
      count > index.n - first) Rcpp::stop("Invalid Metal CAGRA query batch");
  const auto profile = metal_cagra_search_profile(index);
  using Clock = std::chrono::steady_clock;
  const auto started = Clock::now();
  @autoreleasepool {
    MetalKnnState& state = metal_knn_state();
    const std::uint32_t params[] = {index.n, index.p, index.k, index.degree,
      profile.queue, index.width, profile.steps, first, index.visit_slots};
    id<MTLCommandBuffer> command = [state.queue commandBuffer];
    id<MTLComputeCommandEncoder> encoder = [command computeCommandEncoder];
    [encoder setComputePipelineState:index.search];
    [encoder setBuffer:index.data offset:0 atIndex:0];
    [encoder setBuffer:index.graph offset:0 atIndex:1];
    [encoder setBuffer:index.ids offset:0 atIndex:2];
    [encoder setBuffer:index.distances offset:0 atIndex:3];
    [encoder setBuffer:index.visits offset:0 atIndex:4];
    [encoder setBytes:params length:sizeof(params) atIndex:5];
    const auto scratch = index.width * index.degree *
      (sizeof(float) + sizeof(std::uint32_t));
    [encoder setThreadgroupMemoryLength:scratch atIndex:0];
    [encoder dispatchThreadgroups:MTLSizeMake(count, 1, 1)
      threadsPerThreadgroup:MTLSizeMake(128, 1, 1)];
    [encoder endEncoding];
    run_and_wait(command);
    const double search_seconds = std::chrono::duration<double>(
      Clock::now() - started).count();
    const auto* ids = static_cast<const int*>([index.ids contents]);
    const auto* values = static_cast<const float*>([index.distances contents]);
    Rcpp::IntegerMatrix out_ids(count, index.k);
    Rcpp::NumericMatrix out_values(count, index.k);
    for (std::uint32_t row = 0; row < count; ++row) {
      for (std::uint32_t j = 0; j < index.k; ++j) {
        const auto pos = static_cast<std::size_t>(row) * index.k + j;
        if (ids[pos] < 0 || static_cast<std::uint32_t>(ids[pos]) >= index.n ||
            !std::isfinite(values[pos])) {
          Rcpp::stop("Metal CAGRA did not return k finite non-self neighbors");
        }
        out_ids(row, j) = ids[pos] + 1;
        out_values(row, j) = std::sqrt(std::max(0.0f, values[pos]));
      }
    }
    return Rcpp::List::create(Rcpp::Named("indices") = out_ids,
      Rcpp::Named("distances") = out_values, Rcpp::Named("exact") = false,
      Rcpp::Named("search_seconds") = search_seconds,
      Rcpp::Named("queue") = profile.queue, Rcpp::Named("steps") = profile.steps,
      Rcpp::Named("backend_used") = "faissr_native_metal_cagra_file");
  }
}

SEXP metal_cagra_tag() {
  return Rf_install("faissR_metal_cagra_index_v1");
}

MetalCagraIndex* metal_cagra_pointer(SEXP pointer) {
  if (TYPEOF(pointer) != EXTPTRSXP || R_ExternalPtrTag(pointer) != metal_cagra_tag()
      || !R_ExternalPtrAddr(pointer)) Rcpp::stop("Invalid Metal CAGRA index");
  return static_cast<MetalCagraIndex*>(R_ExternalPtrAddr(pointer));
}

Rcpp::List metal_cagra_collect(Rcpp::List built, double target) {
  using Clock = std::chrono::steady_clock;
  SEXP pointer = built["pointer"];
  std::unique_ptr<MetalCagraIndex> index(metal_cagra_pointer(pointer));
  R_ClearExternalPtr(pointer);
  Rcpp::IntegerMatrix ids(index->n, index->k);
  Rcpp::NumericMatrix distances(index->n, index->k);
  const auto started = Clock::now();
  for (std::uint32_t first = 0; first < index->n;) {
    Rcpp::checkUserInterrupt();
    const auto count = std::min(index->capacity, index->n - first);
    Rcpp::List batch = metal_cagra_search(*index, first, count);
    const Rcpp::IntegerMatrix batch_ids(batch["indices"]);
    const Rcpp::NumericMatrix batch_distances(batch["distances"]);
    for (std::uint32_t j = 0; j < index->k; ++j) {
      std::copy_n(&batch_ids(0, j), count, &ids(first, j));
      std::copy_n(&batch_distances(0, j), count, &distances(first, j));
    }
    first += count;
  }
  return Rcpp::List::create(Rcpp::Named("indices") = ids,
    Rcpp::Named("distances") = distances, Rcpp::Named("backend") = "metal",
    Rcpp::Named("method") = "native_metal_cagra",
    Rcpp::Named("metric") = "euclidean", Rcpp::Named("target_recall") = target,
    Rcpp::Named("target_met") = NA_LOGICAL,
    Rcpp::Named("cagra_settings") = built["params"],
    Rcpp::Named("metal_live_buffer_bytes_after_search") =
      built["owned_metal_bytes"],
    Rcpp::Named("observed_metal_owned_buffer_peak_bytes") =
      built["observed_metal_owned_buffer_peak_bytes"],
    Rcpp::Named("metal_memory_measurement_scope") =
      built["metal_memory_measurement_scope"],
    Rcpp::Named("index_build_seconds") = built["build_seconds"],
    Rcpp::Named("build_timing") = built["build_timing"],
    Rcpp::Named("search_seconds") =
      std::chrono::duration<double>(Clock::now() - started).count());
}

struct MetalCagraSeedBuffers {
  id<MTLBuffer> points, projected, centroids, offsets, members;
  id<MTLBuffer> ids, distances, shortlist;
};

void metal_cagra_seed_batch(MetalKnnState& state,
    const MetalCagraSeedBuffers& buffers, const SearchParamsHost& params,
    int count) {
  const auto id_offset =
    static_cast<std::size_t>(params.query_offset) * params.k * sizeof(int);
  id<MTLCommandBuffer> command = [state.queue commandBuffer];
  const auto groups = MTLSizeMake(count, 1, 1);
  const auto threads = MTLSizeMake(128, 1, 1);
  if (buffers.shortlist != nil) {
    id<MTLComputeCommandEncoder> shortlist = [command computeCommandEncoder];
    [shortlist setComputePipelineState:state.shortlist_pipeline];
    [shortlist setBuffer:buffers.projected offset:0 atIndex:0];
    [shortlist setBuffer:buffers.centroids offset:0 atIndex:1];
    [shortlist setBuffer:buffers.offsets offset:0 atIndex:2];
    [shortlist setBuffer:buffers.members offset:0 atIndex:3];
    [shortlist setBuffer:buffers.shortlist offset:0 atIndex:4];
    [shortlist setBytes:&params length:sizeof(params) atIndex:5];
    [shortlist setThreadgroupMemoryLength:projected_shortlist_scratch(params)
                              atIndex:0];
    [shortlist dispatchThreadgroups:groups threadsPerThreadgroup:threads];
    [shortlist endEncoding];

    id<MTLComputeCommandEncoder> rerank = [command computeCommandEncoder];
    [rerank setComputePipelineState:state.rerank_pipeline];
    [rerank setBuffer:buffers.points offset:0 atIndex:0];
    [rerank setBuffer:buffers.shortlist offset:0 atIndex:1];
    [rerank setBuffer:buffers.ids offset:id_offset atIndex:2];
    [rerank setBuffer:buffers.distances offset:0 atIndex:3];
    [rerank setBytes:&params length:sizeof(params) atIndex:4];
    [rerank dispatchThreadgroups:groups threadsPerThreadgroup:threads];
    [rerank endEncoding];
  } else {
    id<MTLComputeCommandEncoder> encoder = [command computeCommandEncoder];
    [encoder setComputePipelineState:state.ivf_pipeline];
    [encoder setBuffer:buffers.points offset:0 atIndex:0];
    [encoder setBuffer:buffers.projected offset:0 atIndex:1];
    [encoder setBuffer:buffers.centroids offset:0 atIndex:2];
    [encoder setBuffer:buffers.offsets offset:0 atIndex:3];
    [encoder setBuffer:buffers.members offset:0 atIndex:4];
    [encoder setBuffer:buffers.ids offset:id_offset atIndex:5];
    [encoder setBuffer:buffers.distances offset:0 atIndex:6];
    [encoder setBytes:&params length:sizeof(params) atIndex:7];
    [encoder dispatchThreadgroups:groups threadsPerThreadgroup:threads];
    [encoder endEncoding];
  }
  run_and_wait(command);
}

int metal_cagra_shortlist_per_group(int n, int p, int qdim, double target) {
  if (n < 20000 || p < 2 * qdim) return 0;
  return target == 0.99 ? kMaxShortlistPerGroup : kInitialShortlistPerGroup;
}

struct MetalNndProfile {
  std::uint32_t seed_passes = 0, pivots = 0, iterations = 0;
};

MetalNndProfile metal_nnd_profile(double target) {
  SEXP option = Rf_GetOption1(Rf_install("faissR.metal_cagra_nn_descent"));
  if (Rf_isNull(option) || (TYPEOF(option) == LGLSXP &&
      Rf_xlength(option) == 1 && LOGICAL(option)[0] == FALSE)) return {};
  if (TYPEOF(option) == LGLSXP && Rf_xlength(option) == 1 &&
      LOGICAL(option)[0] == TRUE) {
    if (target == 0.90) return {4, 8, 6};
    if (target == 0.95) return {4, 12, 10};
    return {8, 16, 20};
  }
  if ((TYPEOF(option) != INTSXP && TYPEOF(option) != REALSXP) ||
      Rf_xlength(option) != 3) {
    Rcpp::stop("Metal NN-descent profile needs three integers: seed passes, pivots, iterations");
  }
  const auto limits = std::array<int, 3>{16, 16, 24};
  std::uint32_t value[3]{};
  for (int i = 0; i < 3; ++i) {
    const double x = TYPEOF(option) == INTSXP ? INTEGER(option)[i] : REAL(option)[i];
    if (!std::isfinite(x) || x < 1 || x > limits[i] || x != std::floor(x)) {
      Rcpp::stop("Metal NN-descent profile exceeds the seed, pivot, or iteration limits");
    }
    value[i] = static_cast<std::uint32_t>(x);
  }
  return {value[0], value[1], value[2]};
}

struct MetalNndParams {
  std::uint32_t n, p, degree, offset, round, pivots, last;
  std::uint32_t multiplier, inverse, shift, claim_slots, partition_ranked;
};

constexpr auto kNndReverseWidth = faissr_metal::kCagraNndReverseWidth;
constexpr std::uint32_t kNndRowsPerBatch = 8192;

bool metal_nnd_partition_seed(int columns) {
  return columns > 0 && columns <= 128 &&
    Rf_asLogical(Rf_GetOption1(Rf_install("faissR.metal_cagra_partition_seed"))) == TRUE;
}

double metal_nnd_workspace(int rows, int columns, int degree) {
  const double partition = metal_nnd_partition_seed(columns) ? 12.0 * rows : 0.0;
  return faissr_metal::cagra_nnd_workspace_bytes(rows, columns, degree) + partition;
}

void metal_nnd_check_capacity(id<MTLDevice> device, int rows, int columns,
    int k, double target) {
  const auto degree = faissr_metal::cagra_graph_degree(rows, columns, k, target, true);
  const double budget = static_cast<double>([device recommendedMaxWorkingSetSize]);
  const double biggest_buffer = 4.0 * rows *
    std::max(static_cast<std::uint32_t>(columns), 2u * degree);
  if (biggest_buffer > static_cast<double>([device maxBufferLength]) ||
      metal_nnd_workspace(rows, columns, degree) +
      metal_current_allocated_bytes(device) > budget) {
    Rcpp::stop("Metal NN-descent exceeds the unified memory budget or buffer limit");
  }
}

// Extended Euclid. The multiplier and n are coprime, and both fit int32.
std::uint32_t metal_nnd_inverse(std::uint32_t multiplier, std::uint32_t n) {
  std::int64_t r = n, next_r = multiplier, t = 0, next_t = 1;
  while (next_r != 0) {
    const auto q = r / next_r;
    const auto remainder = r - q * next_r;
    r = next_r;
    next_r = remainder;
    const auto coefficient = t - q * next_t;
    t = next_t;
    next_t = coefficient;
  }
  return static_cast<std::uint32_t>(t < 0 ? t + n : t);
}

struct MetalNndBufferRelease {
  using pointer = id<MTLBuffer>;
  void operator()(id<MTLBuffer> buffer) const { [buffer release]; }
};

using MetalNndBuffer = std::unique_ptr<void, MetalNndBufferRelease>;

struct MetalNndPartition {
  MetalNndBuffer signatures, order, position;
};

MetalNndBuffer metal_nnd_private_buffer(id<MTLDevice> device,
                                       std::size_t bytes) {
  MetalNndBuffer buffer([device newBufferWithLength:bytes
    options:MTLResourceStorageModePrivate]);
  if (!buffer) {
    Rcpp::stop("Metal NN-descent could not allocate a %.0f-byte buffer.",
      static_cast<double>(bytes));
  }
  return buffer;
}

void metal_nnd_rank_partitions(MetalKnnState& state,
    id<MTLComputePipelineState> pipeline, id<MTLBuffer> data,
    const MetalNndPartition& partition, const MetalNndParams& params) {
  const auto n = params.n;
  const auto columns = params.p;
  const auto* matrix = static_cast<const float*>([data contents]);
  const auto sample = std::min(n, 2048u);
  std::array<double, 128> mean{};
  for (std::uint32_t i = 0; i < sample; ++i) {
    const auto* point = matrix + (static_cast<std::size_t>(i) * n / sample) * columns;
    for (std::uint32_t d = 0; d < columns; ++d) mean[d] += point[d];
  }
  std::uint32_t bits = 1;
  while (bits < 20 && (std::uint64_t(256) << bits) < n) ++bits;
  std::vector<float> planes(bits * columns), centers(bits);
  std::mt19937 random(params.shift ^ (0x9e3779b9u * (params.round + 1u)));
  for (std::uint32_t bit = 0; bit < bits; ++bit) {
    double center = 0;
    for (std::uint32_t d = 0; d < columns; ++d) {
      const float weight = (random() & 1u) == 0 ? -1.f : 1.f;
      planes[bit * columns + d] = weight;
      center += mean[d] * weight;
    }
    centers[bit] = static_cast<float>(center / sample);
  }
  @autoreleasepool {
    id<MTLBuffer> weights = metal_shared_buffer(state.device,
      planes.size() * sizeof(float), planes.data());
    id<MTLBuffer> offsets = metal_shared_buffer(state.device,
      centers.size() * sizeof(float), centers.data());
    for (std::uint32_t first = 0; first < n;) {
      Rcpp::checkUserInterrupt();
      const auto count = std::min(262144u, n - first);
      @autoreleasepool {
        const std::uint32_t spec[]{n, columns, bits, first};
        auto command = [state.queue commandBuffer];
        auto encoder = [command computeCommandEncoder];
        [encoder setComputePipelineState:pipeline];
        [encoder setBuffer:data offset:0 atIndex:0];
        [encoder setBuffer:weights offset:0 atIndex:1];
        [encoder setBuffer:offsets offset:0 atIndex:2];
        [encoder setBuffer:partition.signatures.get() offset:0 atIndex:3];
        [encoder setBytes:spec length:sizeof(spec) atIndex:4];
        [encoder dispatchThreadgroups:MTLSizeMake((count + 3u) / 4u, 1, 1)
          threadsPerThreadgroup:MTLSizeMake(128, 1, 1)];
        [encoder endEncoding];
        run_and_wait(command);
      }
      first += count;
    }
  }

  const auto* keys = static_cast<const std::uint32_t*>([partition.signatures.get() contents]);
  auto* order = static_cast<std::uint32_t*>([partition.order.get() contents]);
  auto* position = static_cast<std::uint32_t*>([partition.position.get() contents]);
  std::vector<std::uint32_t> offset(std::size_t(1) << bits, 0u);
  for (std::uint32_t i = 0; i < n; ++i) {
    if ((i & 1048575u) == 0) Rcpp::checkUserInterrupt();
    ++offset[keys[i]];
  }
  std::uint32_t start = 0;
  for (auto& count : offset) {
    const auto size = count;
    count = start;
    start += size;
  }
  // An affine permutation breaks up an oversized bucket reproducibly.
  auto row = params.shift;
  for (std::uint32_t i = 0; i < n; ++i) {
    if ((i & 1048575u) == 0) Rcpp::checkUserInterrupt();
    const auto slot = offset[keys[row]]++;
    order[slot] = row;
    position[row] = slot;
    row += params.multiplier;
    if (row >= n) row -= n;
  }
}

void metal_nnd_update(MetalKnnState& state, id<MTLComputePipelineState> pipeline,
    id<MTLBuffer> data, id<MTLBuffer> previous, id<MTLBuffer> next,
    id<MTLBuffer> reverse, MetalNndParams params,
    const MetalNndPartition* partition = nullptr) {
  const auto candidates = params.degree + (params.pivots == 0 ? 256u :
    (params.pivots + kNndReverseWidth) * (params.degree + 1u));
  params.claim_slots = candidates <= 512u ? 1024u :
    candidates <= 1536u ? 2048u : 4096u;
  const auto query_bytes = (params.p * sizeof(float) + 15u) & ~std::size_t(15u);
  for (std::uint32_t first = 0; first < params.n;) {
    Rcpp::checkUserInterrupt();
    const auto count = std::min(kNndRowsPerBatch, params.n - first);
    @autoreleasepool {
      params.offset = first;
      auto command = [state.queue commandBuffer];
      auto encoder = [command computeCommandEncoder];
      [encoder setComputePipelineState:pipeline];
      [encoder setBuffer:data offset:0 atIndex:0];
      [encoder setBuffer:previous offset:0 atIndex:1];
      [encoder setBuffer:next offset:0 atIndex:2];
      [encoder setBuffer:reverse offset:0 atIndex:3];
      [encoder setBytes:&params length:sizeof(params) atIndex:4];
      [encoder setBuffer:partition == nullptr ? reverse : partition->order.get()
                   offset:0 atIndex:5];
      [encoder setBuffer:partition == nullptr ? reverse : partition->position.get()
                   offset:0 atIndex:6];
      [encoder setThreadgroupMemoryLength:params.claim_slots * sizeof(std::uint32_t)
                                  atIndex:0];
      [encoder setThreadgroupMemoryLength:query_bytes atIndex:1];
      [encoder dispatchThreadgroups:MTLSizeMake(count, 1, 1)
        threadsPerThreadgroup:MTLSizeMake(128, 1, 1)];
      [encoder endEncoding];
      run_and_wait(command);
    }
    first += count;
  }
}

void metal_nnd_reverse(MetalKnnState& state, id<MTLComputePipelineState> pipeline,
    id<MTLBuffer> previous, id<MTLBuffer> reverse, MetalNndParams params) {
  @autoreleasepool {
    auto command = [state.queue commandBuffer];
    auto blit = [command blitCommandEncoder];
    [blit fillBuffer:reverse range:NSMakeRange(0, [reverse length]) value:0xff];
    [blit endEncoding];
    run_and_wait(command);
  }
  constexpr std::uint32_t batch = 262144;
  for (std::uint32_t first = 0; first < params.n;) {
    Rcpp::checkUserInterrupt();
    const auto count = std::min(batch, params.n - first);
    @autoreleasepool {
      params.offset = first;
      auto command = [state.queue commandBuffer];
      auto encoder = [command computeCommandEncoder];
      [encoder setComputePipelineState:pipeline];
      [encoder setBuffer:previous offset:0 atIndex:0];
      [encoder setBuffer:reverse offset:0 atIndex:1];
      [encoder setBytes:&params length:sizeof(params) atIndex:2];
      [encoder dispatchThreadgroups:MTLSizeMake(1, count, 1)
        threadsPerThreadgroup:MTLSizeMake(params.degree, 1, 1)];
      [encoder endEncoding];
      run_and_wait(command);
    }
    first += count;
  }
}

void metal_cagra_reverse_dispatch(MetalKnnState& state,
    id<MTLComputePipelineState> pipeline, const MetalCagraIndex& index,
    std::initializer_list<id<MTLBuffer>> buffers,
    std::uint32_t first_rank, std::uint32_t ranks) {
  constexpr std::uint32_t batch_rows = 65536;
  const auto threads_x = std::min(8u, ranks);
  const auto threads = MTLSizeMake(threads_x, 128u / threads_x, 1);
  for (std::uint32_t first = 0; first < index.n;) {
    Rcpp::checkUserInterrupt();
    const auto count = std::min(batch_rows, index.n - first);
    @autoreleasepool {
      const std::uint32_t spec[] = {index.n, index.degree, first_rank, first};
      auto command = [state.queue commandBuffer];
      auto encoder = [command computeCommandEncoder];
      if (encoder == nil) Rcpp::stop("Cannot encode Metal CAGRA reverse pass");
      [encoder setComputePipelineState:pipeline];
      NSUInteger slot = 0;
      for (auto buffer : buffers) [encoder setBuffer:buffer offset:0 atIndex:slot++];
      [encoder setBytes:spec length:sizeof(spec) atIndex:slot];
      [encoder dispatchThreads:MTLSizeMake(ranks, count, 1)
        threadsPerThreadgroup:threads];
      [encoder endEncoding];
      run_and_wait(command);
    }
    first += count;
  }
}

double metal_cagra_reverse_edges(MetalKnnState& state,
    const MetalCagraIndex& index, std::uint32_t rank_batch) {
  @autoreleasepool {
    const auto bytes = static_cast<std::size_t>(index.n) *
      (index.degree / 2u) * sizeof(std::uint32_t);
    const auto keys = metal_nnd_private_buffer(state.device, bytes);
    const auto incoming = metal_nnd_private_buffer(state.device, bytes);
    const auto counts = metal_nnd_private_buffer(state.device,
      static_cast<std::size_t>(index.n) * sizeof(std::uint32_t));
    auto select = [make_pipeline(state.device, state.library,
      @"cagra_reverse_select") autorelease];
    auto collect = [make_pipeline(state.device, state.library,
      @"cagra_reverse_collect") autorelease];
    auto merge = [make_pipeline(state.device, state.library,
      @"cagra_reverse_merge") autorelease];
    for (std::uint32_t first = 0; first < index.degree; first += rank_batch) {
      @autoreleasepool {
        auto command = [state.queue commandBuffer];
        auto blit = [command blitCommandEncoder];
        if (blit == nil) Rcpp::stop("Cannot clear Metal CAGRA reverse buffers");
        [blit fillBuffer:keys.get() range:NSMakeRange(0, bytes) value:0xff];
        if (first == 0) {
          [blit fillBuffer:counts.get()
            range:NSMakeRange(0, [counts.get() length]) value:0];
        }
        [blit endEncoding];
        run_and_wait(command);
      }
      const auto ranks = std::min(rank_batch, index.degree - first);
      metal_cagra_reverse_dispatch(state, select, index,
        {index.graph, keys.get(), counts.get()}, first, ranks);
      metal_cagra_reverse_dispatch(state, collect, index,
        {keys.get(), incoming.get(), counts.get()}, 0, 1);
    }
    metal_cagra_reverse_dispatch(state, merge, index,
      {index.graph, incoming.get(), counts.get()}, 0, 1);
    return metal_live_buffer_bytes({keys.get(), incoming.get(), counts.get()});
  }
}

void metal_cagra_prune(MetalKnnState& state, id<MTLBuffer> initial,
    const MetalCagraIndex& index, std::uint32_t initial_degree, bool batched) {
  auto pipeline = [make_pipeline(state.device, state.library, @"cagra_rank_prune")
    autorelease];
  for (std::uint32_t first = 0; first < index.n;) {
    Rcpp::checkUserInterrupt();
    const auto count = std::min(batched ? 65536u : index.n, index.n - first);
    @autoreleasepool {
      auto command = [state.queue commandBuffer];
      auto encoder = [command computeCommandEncoder];
      const std::uint32_t params[]{index.n, initial_degree, index.degree, first};
      [encoder setComputePipelineState:pipeline];
      [encoder setBuffer:initial offset:0 atIndex:0];
      [encoder setBuffer:index.graph offset:0 atIndex:1];
      [encoder setBytes:params length:sizeof(params) atIndex:2];
      [encoder dispatchThreadgroups:MTLSizeMake(count, 1, 1)
        threadsPerThreadgroup:MTLSizeMake(128, 1, 1)];
      [encoder endEncoding];
      run_and_wait(command);
    }
    first += count;
  }
}

Rcpp::List metal_cagra_finish_call(Rcpp::List index, bool file, double target,
    double build_seconds, double upload_seconds) {
  index["build_seconds"] = build_seconds;
  if (file) {
    index["source_read_and_upload_seconds"] = upload_seconds;
    index["backend_used"] = "faissr_native_metal_cagra_file";
    index["device_ids"] = Rcpp::IntegerVector::create(0);
    return index;
  }
  return metal_cagra_collect(index, target);
}

Rcpp::List metal_cagra_build(MetalKnnState& state, id<MTLBuffer> points,
    id<MTLBuffer> projected, id<MTLBuffer> centroids,
    id<MTLBuffer> offsets, id<MTLBuffer> members, int n, int p, int qdim,
    int nlist, int k, double target, double live_bytes,
    MetalNndProfile nnd = {}) {
  using Clock = std::chrono::steady_clock;
  const auto started = Clock::now();
  auto index = std::make_unique<MetalCagraIndex>();
  index->n = n;
  index->p = p;
  index->k = k;
  const bool balanced = faissr_metal::cagra_balanced_shape(n, p, k, target);
  const bool nn_descent = nnd.seed_passes > 0;
  const bool partition_seed = nn_descent && metal_nnd_partition_seed(p);
  index->degree = faissr_metal::cagra_graph_degree(n, p, k, target, nn_descent);
  const std::uint32_t initial_degree = 2u * index->degree;
  // Linear-probing masks and the shader hash require a power of two.
  index->visit_slots = 16384u;
  index->width = target == 0.90 ? 1 : target == 0.95 ? 2 : 4;
  index->pool = target == 0.90 ? 128 : target == 0.95 ? 256 :
    balanced ? 384 : 512;
  index->pool = std::max(index->pool, static_cast<std::uint32_t>(k + 1));
  index->steps = nn_descent && target == 0.90 ? 36 : balanced ? 60 : 48;
  const auto search_profile = metal_cagra_search_profile(*index);
  index->data = [points retain];
  const int nprobe = n < 20000 ? std::min(nlist, kMaxProbe) :
    std::min(nlist, target == 0.90 ? 8 : target == 0.95 ? 16 : 24);
  const int shortlist_per_group = nn_descent ? 0 :
    metal_cagra_shortlist_per_group(n, p, qdim, target);
  double seed_seconds = 0.0;
  double partition_seconds = 0.0;
  double refine_seconds = 0.0;
  double prune_seconds = 0.0;
  double seed_peak_bytes = 0.0;
  const auto graph_bytes = static_cast<std::size_t>(n) * index->degree *
    sizeof(std::uint32_t);
  if (nnd.seed_passes > 0) {
    @autoreleasepool {
      const auto bytes = static_cast<std::size_t>(n) * initial_degree *
        sizeof(std::uint32_t);
      auto previous = metal_nnd_private_buffer(state.device, bytes);
      auto next = metal_nnd_private_buffer(state.device, bytes);
      auto reverse = metal_nnd_private_buffer(state.device,
        static_cast<std::size_t>(n) * kNndReverseWidth * sizeof(std::uint32_t));
      seed_peak_bytes = live_bytes + metal_live_buffer_bytes(
        {previous.get(), next.get(), reverse.get()});
      auto update = [make_pipeline(state.device, state.library,
        @"cagra_nnd_update") autorelease];
      auto incoming = [make_pipeline(state.device, state.library,
        @"cagra_nnd_reverse") autorelease];
      MetalNndParams params{index->n, index->p, initial_degree, 0, 0, 0, 0,
        0, 0, 0, 0, 0};
      std::mt19937 generator(42);
      std::uniform_int_distribution<std::uint32_t> number(1, index->n - 1);
      const auto seeding = Clock::now();
      @autoreleasepool {
        MetalNndPartition partition;
        id<MTLComputePipelineState> signatures = nil;
        if (partition_seed) {
          const auto row_bytes = static_cast<std::size_t>(index->n) * sizeof(std::uint32_t);
          partition.signatures.reset([metal_shared_buffer(state.device, row_bytes) retain]);
          partition.order.reset([metal_shared_buffer(state.device, row_bytes) retain]);
          partition.position.reset([metal_shared_buffer(state.device, row_bytes) retain]);
          signatures = [make_pipeline(state.device, state.library,
            @"cagra_nnd_seed_signature") autorelease];
          seed_peak_bytes += metal_live_buffer_bytes(
            {partition.signatures.get(), partition.order.get(), partition.position.get()});
          params.partition_ranked = 1;
        }
        for (params.round = 0; params.round < nnd.seed_passes; ++params.round) {
          do {
            params.multiplier = number(generator);
          } while (std::gcd(params.multiplier, index->n) != 1u);
          params.inverse = metal_nnd_inverse(params.multiplier, index->n);
          params.shift = number(generator);
          if (partition_seed) {
            const auto partition_started = Clock::now();
            metal_nnd_rank_partitions(state, signatures, points, partition, params);
            partition_seconds += std::chrono::duration<double>(
              Clock::now() - partition_started).count();
          }
          metal_nnd_update(state, update, points, previous.get(), next.get(),
            reverse.get(), params, partition_seed ? &partition : nullptr);
          std::swap(previous, next);
        }
      }
      const auto refining = Clock::now();
      seed_seconds = std::chrono::duration<double>(refining - seeding).count();
      params.pivots = nnd.pivots;
      params.partition_ranked = 0;
      for (params.round = 0; params.round < nnd.iterations; ++params.round) {
        params.shift = generator() & 0x7fffffffu;
        params.last = params.round + 1 == nnd.iterations;
        metal_nnd_reverse(state, incoming, previous.get(), reverse.get(),
          params);
        metal_nnd_update(state, update, points, previous.get(), next.get(),
          reverse.get(), params);
        std::swap(previous, next);
      }
      const auto pruning = Clock::now();
      refine_seconds = std::chrono::duration<double>(pruning - refining).count();
      // Only the final snapshot is read by pruning.
      next.reset();
      reverse.reset();
      index->graph = [metal_shared_buffer(state.device, graph_bytes) retain];
      seed_peak_bytes = std::max(seed_peak_bytes, live_bytes +
        metal_live_buffer_bytes({previous.get(), index->graph}));
      metal_cagra_prune(state, previous.get(), *index, initial_degree, true);
      prune_seconds = std::chrono::duration<double>(Clock::now() - pruning).count();
    }
  } else {
    @autoreleasepool {
      index->graph = [metal_shared_buffer(state.device, graph_bytes) retain];
      id<MTLBuffer> initial = metal_shared_buffer(state.device,
        static_cast<std::size_t>(n) * initial_degree * sizeof(std::uint32_t));
      id<MTLBuffer> seed_distances = metal_shared_buffer(state.device,
        index->capacity * initial_degree * sizeof(float));
      id<MTLBuffer> shortlist = nil;
      if (shortlist_per_group != 0) {
        shortlist = metal_shared_buffer(state.device, index->capacity *
          kMetalSimdGroups * shortlist_per_group * sizeof(int));
      }
      seed_peak_bytes = live_bytes + metal_live_buffer_bytes(
        {index->graph, initial, seed_distances, shortlist});
      const MetalCagraSeedBuffers buffers{points, projected, centroids,
        offsets, members, initial, seed_distances, shortlist};
      const auto seeding = Clock::now();
      for (int first = 0; first < n;) {
        Rcpp::checkUserInterrupt();
        const int count = std::min(static_cast<int>(index->capacity), n - first);
        @autoreleasepool {
          SearchParamsHost params{static_cast<std::uint32_t>(n),
            static_cast<std::uint32_t>(p), static_cast<std::uint32_t>(qdim),
            static_cast<std::uint32_t>(nlist), static_cast<std::uint32_t>(nprobe),
            initial_degree, static_cast<std::uint32_t>(first),
            static_cast<std::uint32_t>(shortlist_per_group)};
          metal_cagra_seed_batch(state, buffers, params, count);
        }
        first += count;
      }
      const auto pruning = Clock::now();
      seed_seconds = std::chrono::duration<double>(pruning - seeding).count();
      metal_cagra_prune(state, initial, *index, initial_degree, false);
      prune_seconds =
        std::chrono::duration<double>(Clock::now() - pruning).count();
    }
  }
  const auto reversing = Clock::now();
  if (nnd.seed_passes > 0) {
    const auto ranks = faissr_metal::cagra_reverse_rank_batch(n, index->degree);
    const double reverse_bytes = metal_cagra_reverse_edges(state, *index, ranks);
    seed_peak_bytes = std::max(seed_peak_bytes, live_bytes + reverse_bytes +
      metal_live_buffer_bytes({index->graph}));
  } else {
    cagra_add_reverse_edges(
      static_cast<std::uint32_t*>([index->graph contents]), index->n,
      index->degree);
  }
  const auto finished = Clock::now();
  index->search = make_pipeline(state.device, state.library, @"cagra_search_self");
  index->ids = [metal_shared_buffer(state.device,
    index->capacity * index->k * sizeof(int)) retain];
  index->distances = [metal_shared_buffer(state.device,
    index->capacity * index->k * sizeof(float)) retain];
  index->visits = [state.device newBufferWithLength:
    index->capacity * index->visit_slots * sizeof(std::uint32_t)
    options:MTLResourceStorageModePrivate];
  if (index->visits == nil) Rcpp::stop("Metal CAGRA could not allocate visited tables");
  const double owned = metal_live_buffer_bytes({index->data, index->graph,
    index->ids, index->distances, index->visits});
  const double search_peak_bytes = live_bytes + owned -
    metal_live_buffer_bytes({points});
  auto params = Rcpp::List::create(
    Rcpp::Named("width") = index->width, Rcpp::Named("queue") = search_profile.queue,
    Rcpp::Named("steps") = search_profile.steps,
    Rcpp::Named("initial_degree") = initial_degree,
    Rcpp::Named("graph_degree") = index->degree,
    Rcpp::Named("visit_slots") = index->visit_slots,
    Rcpp::Named("nlist") = nlist,
    Rcpp::Named("projection_dim") = qdim,
    Rcpp::Named("initial_nprobe") = nprobe,
    Rcpp::Named("initial_shortlist") =
      kMetalSimdGroups * shortlist_per_group,
    Rcpp::Named("builder") = shortlist_per_group == 0 ?
      "metal_ivf" : "metal_ivf_projected_rerank");
  params["search_queue_update"] = "sorted_frontier";
  auto timing = Rcpp::List::create(
    Rcpp::Named("seed_seconds") = seed_seconds,
    Rcpp::Named("rank_prune_seconds") = prune_seconds,
    Rcpp::Named("reverse_edges_seconds") =
      std::chrono::duration<double>(finished - reversing).count());
  if (nnd.seed_passes > 0) {
    params["builder"] = "metal_nn_descent";
    params["nn_descent_seed_passes"] = nnd.seed_passes;
    params["nn_descent_pivots"] = nnd.pivots;
    params["nn_descent_iterations"] = nnd.iterations;
    params["nn_descent_pivot_refill"] = true;
    params["nn_descent_reciprocal_slots"] = kNndReverseWidth;
    params["nn_descent_retained_membership"] = "candidate_hash";
    params["nn_descent_threadgroup_workspace"] = "shape_sized";
    params["nn_descent_seed_order"] = partition_seed ? "projection_hash" : "permuted_blocks";
    params["reverse_edges_backend"] = "metal";
    timing["nn_descent_refinement_seconds"] = refine_seconds;
    if (partition_seed) timing["seed_partition_seconds"] = partition_seconds;
  }
  Rcpp::XPtr<MetalCagraIndex> pointer(index.release(), true, metal_cagra_tag());
  return Rcpp::List::create(Rcpp::Named("pointer") = pointer,
    Rcpp::Named("params") = params, Rcpp::Named("owned_metal_bytes") = owned,
    Rcpp::Named("observed_metal_owned_buffer_peak_bytes") =
      std::max(seed_peak_bytes, search_peak_bytes),
    Rcpp::Named("metal_memory_measurement_scope") = "peak_owned_knn_buffers",
    Rcpp::Named("build_timing") = timing,
    Rcpp::Named("graph_build_seconds") =
      std::chrono::duration<double>(finished - started).count());
}

} // namespace

bool faissr_metal_knn_available_impl() {
  @autoreleasepool {
    id<MTLDevice> device = MTLCreateSystemDefaultDevice();
    const bool available = device != nil;
    if (device != nil) [device release];
    return available;
  }
}

Rcpp::List faissr_metal_knn_float_impl(
    faissr_metal::FloatMatrix input, int k,
    const std::string& requested_method,
    const std::string& metric_name, double target,
    std::chrono::steady_clock::time_point t0,
    const std::function<void(float*)>& read_file = {}) {
  using Clock = std::chrono::steady_clock;
  const faissr_metal::KnnMetric metric = faissr_metal::parse_knn_metric(metric_name);
  std::vector<float>& data = input.values;
  const int n = input.nrow;
  const int p = input.ncol;
  const auto t_convert = Clock::now();
  if (n < 2 || p < 1 || p > kMaxGlobalP ||
      k < 1 || k > kMaxK || k >= n) {
    Rcpp::stop(
      "Native Metal KNN supports 1-%d dimensions and k <= %d.",
      kMaxGlobalP, kMaxK
    );
  }
  std::string method = requested_method;
  const bool ivf_supported = faissr_metal::ivf_shape_supported(n, p, k);
  const bool cagra = method == "cagra";
  const bool cagra_supported = faissr_metal::cagra_shape_supported(n, p, k);
  if (cagra && (!cagra_supported || n <= 128 ||
      metric != faissr_metal::KnnMetric::Euclidean ||
      (target != 0.90 && target != 0.95 && target != 0.99))) {
    Rcpp::stop("Metal CAGRA requires Euclidean self KNN and at least 129 rows");
  }
  if (method == "auto") {
    method = n < 4096 || !ivf_supported ? "exact" : "ivf";
  }
  if (method != "exact" && method != "ivf" && !cagra) {
    Rcpp::stop("Native Metal KNN needs `auto`, `exact`, `ivf`, or `cagra`.");
  }
  if (method == "ivf" && !ivf_supported) {
    Rcpp::stop(
      "Native Metal IVF KNN requires at most %d dimensions and 32-bit "
      "buffer offsets; use exact search for this input.", kMaxP
    );
  }
  const MetalNndProfile nnd = cagra ? metal_nnd_profile(target) : MetalNndProfile{};
  const bool balanced = cagra &&
    faissr_metal::cagra_balanced_shape(n, p, k, target);
  const int qdim = faissr_metal::ivf_projection_dimensions(p, balanced);
  const int limit = balanced ? 4096 : kMaxLists;
  const int nlist = std::max(16, std::min(limit,
    static_cast<int>(std::ceil(4.0 * std::sqrt(static_cast<double>(n))))));

  std::vector<std::uint32_t> feature_offsets(static_cast<std::size_t>(qdim) + 1u, 0u);
  std::vector<std::vector<std::pair<std::uint32_t, std::int8_t>>> buckets(qdim);
  for (int d = 0; d < p; ++d) {
    std::uint32_t h = static_cast<std::uint32_t>(d + 1) * 2654435761u;
    int bucket = static_cast<int>(h & static_cast<std::uint32_t>(qdim - 1));
    std::int8_t sign = ((h >> 17u) & 1u) ? std::int8_t(1) : std::int8_t(-1);
    buckets[bucket].push_back({static_cast<std::uint32_t>(d), sign});
  }
  std::vector<std::uint32_t> feature_ids;
  std::vector<std::int8_t> feature_signs;
  feature_ids.reserve(p); feature_signs.reserve(p);
  for (int b = 0; b < qdim; ++b) {
    feature_offsets[b] = static_cast<std::uint32_t>(feature_ids.size());
    for (const auto& item : buckets[b]) { feature_ids.push_back(item.first); feature_signs.push_back(item.second); }
  }
  feature_offsets[qdim] = static_cast<std::uint32_t>(feature_ids.size());

  @autoreleasepool {
    MetalKnnState& state = metal_knn_state();
    id<MTLDevice> device = state.device;
    id<MTLCommandQueue> queue = state.queue;
    id<MTLComputePipelineState> project_pipeline = state.project_pipeline;
    id<MTLComputePipelineState> assign_pipeline = state.assign_pipeline;
    id<MTLComputePipelineState> clear_centroids_pipeline = state.clear_centroids_pipeline;
    id<MTLComputePipelineState> accumulate_centroids_pipeline = state.accumulate_centroids_pipeline;
    id<MTLComputePipelineState> finalize_centroids_pipeline = state.finalize_centroids_pipeline;
    id<MTLComputePipelineState> exact_pipeline = state.exact_pipeline;
    id<MTLComputePipelineState> exact_global_pipeline =
      state.exact_global_pipeline;
    id<MTLComputePipelineState> ivf_pipeline = state.ivf_pipeline;
    id<MTLComputePipelineState> shortlist_pipeline = state.shortlist_pipeline;
    id<MTLComputePipelineState> rerank_pipeline = state.rerank_pipeline;
    const auto t_setup = Clock::now();
    const double metal_allocated_before_bytes =
      metal_current_allocated_bytes(device);

    const auto load_start = Clock::now();
    if (nnd.seed_passes > 0) metal_nnd_check_capacity(device, n, p, k, target);
    id<MTLBuffer> data_buffer = metal_shared_buffer(device,
      static_cast<std::size_t>(n) * p * sizeof(float),
      read_file ? nullptr : data.data());
    if (read_file) read_file(static_cast<float*>([data_buffer contents]));
    if (cagra) std::vector<float>().swap(data);
    const auto loaded = Clock::now();
    if (nnd.seed_passes > 0) {
      Rcpp::List index = metal_cagra_build(state, data_buffer,
        nil, nil, nil, nil, n, p, 0, 0, k, target,
        metal_live_buffer_bytes({data_buffer}), nnd);
      return metal_cagra_finish_call(index, static_cast<bool>(read_file), target,
        std::chrono::duration<double>(Clock::now() - loaded).count(),
        std::chrono::duration<double>(loaded - load_start).count());
    }
    if (method == "exact") {
      const auto output_items = static_cast<std::size_t>(n) * k;
      id<MTLBuffer> out_id_buffer = metal_shared_buffer(
        device, output_items * sizeof(int));
      id<MTLBuffer> out_dist_buffer = metal_shared_buffer(
        device, output_items * sizeof(float));
      SearchParamsHost params{static_cast<std::uint32_t>(n), static_cast<std::uint32_t>(p), 0u, 0u, 0u, static_cast<std::uint32_t>(k), 0u, 0u};
      id<MTLBuffer> params_buffer = metal_shared_buffer(
        device, sizeof(params), &params);
      id<MTLCommandBuffer> command = [queue commandBuffer];
      id<MTLComputeCommandEncoder> encoder = [command computeCommandEncoder];
      [encoder setComputePipelineState:
        p <= kMaxP ? exact_pipeline : exact_global_pipeline];
      [encoder setBuffer:data_buffer offset:0 atIndex:0];
      [encoder setBuffer:out_id_buffer offset:0 atIndex:1];
      [encoder setBuffer:out_dist_buffer offset:0 atIndex:2];
      [encoder setBuffer:params_buffer offset:0 atIndex:3];
      [encoder dispatchThreadgroups:MTLSizeMake(n, 1, 1) threadsPerThreadgroup:MTLSizeMake(128, 1, 1)];
      [encoder endEncoding];
      run_and_wait(command);
      const double metal_allocated_after_search_bytes =
        metal_current_allocated_bytes(device);
      const double metal_live_buffer_bytes_after_search =
        metal_live_buffer_bytes({data_buffer, out_id_buffer,
          out_dist_buffer, params_buffer});
      const auto searched = Clock::now();
      const int* ids = static_cast<const int*>([out_id_buffer contents]);
      const float* internal_distances = static_cast<const float*>([out_dist_buffer contents]);
      Rcpp::IntegerMatrix indices(n, k);
      Rcpp::NumericMatrix distances(n, k);
      for (int i = 0; i < n; ++i) for (int j = 0; j < k; ++j) {
        std::size_t pos = static_cast<std::size_t>(i) * k + j;
        indices(i, j) = ids[pos] + 1;
        distances(i, j) = faissr_metal::output_distance(internal_distances[pos], metric);
      }
      Rcpp::List result = Rcpp::List::create(
        Rcpp::Named("indices") = indices,
        Rcpp::Named("distances") = distances,
        Rcpp::Named("backend") = "metal",
        Rcpp::Named("method") = "native_metal_exact",
        Rcpp::Named("metric") = metric_name,
        Rcpp::Named("target_recall") = target,
        Rcpp::Named("index_build_seconds") = 0.0,
        Rcpp::Named("index_build_seconds_scope") =
          "no_index_exact_search",
        Rcpp::Named("search_seconds") =
          std::chrono::duration<double>(searched - t_setup).count(),
        Rcpp::Named("search_seconds_scope") =
          "metal_buffer_setup_and_exact_search",
        Rcpp::Named("metal_allocated_before_bytes") =
          metal_allocated_before_bytes,
        Rcpp::Named("metal_allocated_after_search_bytes") =
          metal_allocated_after_search_bytes,
        Rcpp::Named("metal_live_buffer_bytes_after_search") =
          metal_live_buffer_bytes_after_search,
        Rcpp::Named("device_memory_measurement_scope") =
          "process_current_allocated_after_search_before_output_release",
        Rcpp::Named("device_memory_peak_measured") = false,
        Rcpp::Named("timing") = Rcpp::NumericVector::create(
          Rcpp::Named("convert") = std::chrono::duration<double>(t_convert - t0).count(),
          Rcpp::Named("metal_setup") = std::chrono::duration<double>(t_setup - t_convert).count(),
          Rcpp::Named("full_search") = std::chrono::duration<double>(searched - t_setup).count()
        )
      );
      result.attr("backend") = "metal";
      result.attr("method") = "native_metal_exact";
      result.attr("metric") = metric_name;
      result.attr("target_recall") = target;
      return result;
    }
    id<MTLBuffer> offset_map_buffer = [[device newBufferWithBytes:feature_offsets.data() length:feature_offsets.size() * sizeof(std::uint32_t) options:MTLResourceStorageModeShared] autorelease];
    id<MTLBuffer> feature_buffer = [[device newBufferWithBytes:feature_ids.data() length:feature_ids.size() * sizeof(std::uint32_t) options:MTLResourceStorageModeShared] autorelease];
    id<MTLBuffer> sign_buffer = [[device newBufferWithBytes:feature_signs.data() length:feature_signs.size() * sizeof(std::int8_t) options:MTLResourceStorageModeShared] autorelease];
    id<MTLBuffer> projected_buffer = [[device newBufferWithLength:static_cast<std::size_t>(n) * qdim * sizeof(float) options:MTLResourceStorageModeShared] autorelease];
    ProjectParamsHost project_params{static_cast<std::uint32_t>(n), static_cast<std::uint32_t>(p), static_cast<std::uint32_t>(qdim)};
    id<MTLBuffer> project_params_buffer = [[device newBufferWithBytes:&project_params length:sizeof(project_params) options:MTLResourceStorageModeShared] autorelease];
    {
      id<MTLCommandBuffer> command = [queue commandBuffer];
      id<MTLComputeCommandEncoder> encoder = [command computeCommandEncoder];
      [encoder setComputePipelineState:project_pipeline];
      [encoder setBuffer:data_buffer offset:0 atIndex:0]; [encoder setBuffer:offset_map_buffer offset:0 atIndex:1];
      [encoder setBuffer:feature_buffer offset:0 atIndex:2]; [encoder setBuffer:sign_buffer offset:0 atIndex:3];
      [encoder setBuffer:projected_buffer offset:0 atIndex:4]; [encoder setBuffer:project_params_buffer offset:0 atIndex:5];
      [encoder dispatchThreadgroups:MTLSizeMake(n, 1, 1) threadsPerThreadgroup:MTLSizeMake(qdim, 1, 1)];
      [encoder endEncoding]; run_and_wait(command);
    }
    const auto t_project = Clock::now();

    const float* projected = static_cast<const float*>([projected_buffer contents]);
    std::mt19937 rng(4u);
    std::vector<int> order(n);
    std::iota(order.begin(), order.end(), 0);
    std::shuffle(order.begin(), order.end(), rng);
    std::vector<float> centroids(static_cast<std::size_t>(nlist) * qdim);
    for (int c = 0; c < nlist; ++c) {
      std::memcpy(centroids.data() + static_cast<std::size_t>(c) * qdim,
                  projected + static_cast<std::size_t>(order[c]) * qdim,
                  static_cast<std::size_t>(qdim) * sizeof(float));
    }
    id<MTLBuffer> centroid_buffer = [[device newBufferWithBytes:centroids.data() length:centroids.size() * sizeof(float) options:MTLResourceStorageModeShared] autorelease];
    id<MTLBuffer> assignment_buffer = [[device newBufferWithLength:static_cast<std::size_t>(n) * sizeof(int) options:MTLResourceStorageModeShared] autorelease];
    id<MTLBuffer> centroid_sum_buffer = [[device newBufferWithLength:static_cast<std::size_t>(nlist) * qdim * sizeof(float) options:MTLResourceStorageModePrivate] autorelease];
    id<MTLBuffer> centroid_count_buffer = [[device newBufferWithLength:static_cast<std::size_t>(nlist) * sizeof(std::uint32_t) options:MTLResourceStorageModePrivate] autorelease];
    IndexParamsHost index_params{static_cast<std::uint32_t>(n), static_cast<std::uint32_t>(p), static_cast<std::uint32_t>(qdim), static_cast<std::uint32_t>(nlist)};
    id<MTLBuffer> index_params_buffer = [[device newBufferWithBytes:&index_params length:sizeof(index_params) options:MTLResourceStorageModeShared] autorelease];

    for (int iteration = 0; iteration < 4; ++iteration) {
      id<MTLCommandBuffer> command = [queue commandBuffer];
      id<MTLComputeCommandEncoder> encoder = [command computeCommandEncoder];
      [encoder setComputePipelineState:assign_pipeline];
      [encoder setBuffer:projected_buffer offset:0 atIndex:0]; [encoder setBuffer:centroid_buffer offset:0 atIndex:1];
      [encoder setBuffer:assignment_buffer offset:0 atIndex:2]; [encoder setBuffer:index_params_buffer offset:0 atIndex:3];
      [encoder dispatchThreadgroups:MTLSizeMake(n, 1, 1) threadsPerThreadgroup:MTLSizeMake(128, 1, 1)];
      [encoder endEncoding];
      if (iteration < 3) {
        const std::size_t centroid_items = static_cast<std::size_t>(nlist) * qdim;
        id<MTLComputeCommandEncoder> clear_encoder = [command computeCommandEncoder];
        [clear_encoder setComputePipelineState:clear_centroids_pipeline];
        [clear_encoder setBuffer:centroid_sum_buffer offset:0 atIndex:0];
        [clear_encoder setBuffer:centroid_count_buffer offset:0 atIndex:1];
        [clear_encoder setBuffer:index_params_buffer offset:0 atIndex:2];
        [clear_encoder dispatchThreads:MTLSizeMake(std::max<std::size_t>(centroid_items, nlist), 1, 1)
                           threadsPerThreadgroup:MTLSizeMake(256, 1, 1)];
        [clear_encoder endEncoding];

        const auto batch_rows = faissr_metal::cagra_centroid_batch_rows(n, qdim);
        const auto vertices = static_cast<std::uint32_t>(n);
        const bool split = batch_rows < vertices;
        for (std::uint32_t first = 0; first < vertices;) {
          const auto rows = std::min(batch_rows, vertices - first);
          IndexParamsHost block{rows, index_params.p, index_params.qdim,
            index_params.nlist};
          id<MTLComputeCommandEncoder> accum = [command computeCommandEncoder];
          [accum setComputePipelineState:accumulate_centroids_pipeline];
          [accum setBuffer:projected_buffer
                    offset:static_cast<std::size_t>(first) * qdim * sizeof(float)
                   atIndex:0];
          [accum setBuffer:assignment_buffer
                    offset:static_cast<std::size_t>(first) * sizeof(int)
                   atIndex:1];
          [accum setBuffer:centroid_sum_buffer offset:0 atIndex:2];
          [accum setBuffer:centroid_count_buffer offset:0 atIndex:3];
          [accum setBytes:&block length:sizeof(block) atIndex:4];
          [accum dispatchThreads:MTLSizeMake(
              static_cast<std::size_t>(rows) * qdim, 1, 1)
              threadsPerThreadgroup:MTLSizeMake(256, 1, 1)];
          [accum endEncoding];
          if (split) {
            run_and_wait(command);
            Rcpp::checkUserInterrupt();
            command = [queue commandBuffer];
          }
          first += rows;
        }

        id<MTLComputeCommandEncoder> finalize_encoder = [command computeCommandEncoder];
        [finalize_encoder setComputePipelineState:finalize_centroids_pipeline];
        [finalize_encoder setBuffer:centroid_sum_buffer offset:0 atIndex:0];
        [finalize_encoder setBuffer:centroid_count_buffer offset:0 atIndex:1];
        [finalize_encoder setBuffer:centroid_buffer offset:0 atIndex:2];
        [finalize_encoder setBuffer:index_params_buffer offset:0 atIndex:3];
        [finalize_encoder dispatchThreads:MTLSizeMake(centroid_items, 1, 1)
                              threadsPerThreadgroup:MTLSizeMake(256, 1, 1)];
        [finalize_encoder endEncoding];
      }
      run_and_wait(command);
    }
    const auto t_train = Clock::now();

    const int* assignment = static_cast<const int*>([assignment_buffer contents]);
    std::vector<std::uint32_t> list_offsets(static_cast<std::size_t>(nlist) + 1u, 0u);
    for (int i = 0; i < n; ++i) if (assignment[i] >= 0 && assignment[i] < nlist) ++list_offsets[static_cast<std::size_t>(assignment[i]) + 1u];
    for (int c = 0; c < nlist; ++c) list_offsets[c + 1] += list_offsets[c];
    std::vector<std::uint32_t> cursor = list_offsets;
    std::vector<int> list_ids(n, -1);
    for (int i = 0; i < n; ++i) {
      int c = assignment[i];
      if (c >= 0 && c < nlist) list_ids[cursor[c]++] = i;
    }
    id<MTLBuffer> list_offset_buffer = [[device newBufferWithBytes:list_offsets.data() length:list_offsets.size() * sizeof(std::uint32_t) options:MTLResourceStorageModeShared] autorelease];
    id<MTLBuffer> list_id_buffer = [[device newBufferWithBytes:list_ids.data() length:list_ids.size() * sizeof(int) options:MTLResourceStorageModeShared] autorelease];
    const auto t_pack = Clock::now();

    if (cagra) {
      const double live_bytes = metal_live_buffer_bytes({data_buffer,
        offset_map_buffer, feature_buffer, sign_buffer, projected_buffer,
        project_params_buffer, centroid_buffer, assignment_buffer,
        centroid_sum_buffer, centroid_count_buffer, index_params_buffer,
        list_offset_buffer, list_id_buffer});
      Rcpp::List index = metal_cagra_build(state, data_buffer, projected_buffer,
        centroid_buffer, list_offset_buffer, list_id_buffer,
        n, p, qdim, nlist, k, target, live_bytes);
      const double build_seconds = std::chrono::duration<double>(
        Clock::now() - loaded).count();
      Rcpp::List timing = index["build_timing"];
      timing["project_seconds"] =
        std::chrono::duration<double>(t_project - loaded).count();
      timing["train_seconds"] =
        std::chrono::duration<double>(t_train - t_project).count();
      timing["pack_seconds"] =
        std::chrono::duration<double>(t_pack - t_train).count();
      index["build_timing"] = timing;
      return metal_cagra_finish_call(index, static_cast<bool>(read_file), target,
        build_seconds, std::chrono::duration<double>(loaded - load_start).count());
    }

    const int pilot_block_size = std::min(64, n);
    const int pilot_blocks = std::min(4, std::max(1, n / pilot_block_size));
    const int pilot_n = pilot_block_size * pilot_blocks;
    std::vector<int> pilot_offsets(pilot_blocks, 0);
    for (int block = 0; block < pilot_blocks; ++block) {
      pilot_offsets[block] = pilot_blocks == 1 ? 0 : static_cast<int>(
        std::llround(static_cast<double>(block) * (n - pilot_block_size) /
                     static_cast<double>(pilot_blocks - 1))
      );
    }
    id<MTLBuffer> exact_id_buffer = [device newBufferWithLength:static_cast<std::size_t>(pilot_n) * k * sizeof(int) options:MTLResourceStorageModeShared];
    id<MTLBuffer> exact_dist_buffer = [device newBufferWithLength:static_cast<std::size_t>(pilot_n) * k * sizeof(float) options:MTLResourceStorageModeShared];
    for (int block = 0; block < pilot_blocks; ++block) {
      SearchParamsHost exact_params{
        static_cast<std::uint32_t>(n), static_cast<std::uint32_t>(p),
        static_cast<std::uint32_t>(qdim), static_cast<std::uint32_t>(nlist),
        0u, static_cast<std::uint32_t>(k),
        static_cast<std::uint32_t>(pilot_offsets[block]), 0u
      };
      id<MTLBuffer> exact_params_buffer = [device newBufferWithBytes:&exact_params length:sizeof(exact_params) options:MTLResourceStorageModeShared];
      id<MTLCommandBuffer> command = [queue commandBuffer];
      id<MTLComputeCommandEncoder> encoder = [command computeCommandEncoder];
      [encoder setComputePipelineState:exact_pipeline];
      [encoder setBuffer:data_buffer offset:0 atIndex:0];
      [encoder setBuffer:exact_id_buffer
                   offset:static_cast<NSUInteger>(block) * pilot_block_size * k * sizeof(int)
                  atIndex:1];
      [encoder setBuffer:exact_dist_buffer
                   offset:static_cast<NSUInteger>(block) * pilot_block_size * k * sizeof(float)
                  atIndex:2];
      [encoder setBuffer:exact_params_buffer offset:0 atIndex:3];
      [encoder dispatchThreadgroups:MTLSizeMake(pilot_block_size, 1, 1)
                       threadsPerThreadgroup:MTLSizeMake(128, 1, 1)];
      [encoder endEncoding]; run_and_wait(command);
      [exact_params_buffer release];
    }
    const auto t_exact = Clock::now();

    bool use_projected_shortlist = n >= 20000 && p >= 256;
    int shortlist_per_group = kInitialShortlistPerGroup;
    int shortlist_size = kMetalSimdGroups * shortlist_per_group;
    int nprobe = std::min(nlist, 8);
    double measured = 0.0;
    const double pilot_trials = static_cast<double>(pilot_n) * k;
    const double sampling_margin = 2.58 * std::sqrt(
      target * (1.0 - target) / pilot_trials);
    const double tune_target = std::min(1.0,
      target + std::max(0.003, sampling_margin));
    std::vector<int> probe_trace;
    std::vector<double> recall_trace;
    id<MTLBuffer> pilot_id_buffer = [device newBufferWithLength:static_cast<std::size_t>(pilot_n) * k * sizeof(int) options:MTLResourceStorageModeShared];
    id<MTLBuffer> pilot_dist_buffer = [device newBufferWithLength:static_cast<std::size_t>(pilot_n) * k * sizeof(float) options:MTLResourceStorageModeShared];
    id<MTLBuffer> pilot_candidate_buffer = [device newBufferWithLength:static_cast<std::size_t>(pilot_n) * kMetalSimdGroups * kMaxShortlistPerGroup * sizeof(int) options:MTLResourceStorageModePrivate];
    auto evaluate_probe = [&](int probe_count) {
      for (int block = 0; block < pilot_blocks; ++block) {
        SearchParamsHost search_params{
          static_cast<std::uint32_t>(n), static_cast<std::uint32_t>(p),
          static_cast<std::uint32_t>(qdim), static_cast<std::uint32_t>(nlist),
          static_cast<std::uint32_t>(probe_count), static_cast<std::uint32_t>(k),
          static_cast<std::uint32_t>(pilot_offsets[block]),
          static_cast<std::uint32_t>(shortlist_per_group)
        };
        id<MTLBuffer> pilot_params_buffer = [device newBufferWithBytes:&search_params length:sizeof(search_params) options:MTLResourceStorageModeShared];
        const NSUInteger candidate_offset = static_cast<NSUInteger>(block) * pilot_block_size * shortlist_size * sizeof(int);
        const NSUInteger id_offset = static_cast<NSUInteger>(block) * pilot_block_size * k * sizeof(int);
        const NSUInteger distance_offset = static_cast<NSUInteger>(block) * pilot_block_size * k * sizeof(float);
        id<MTLCommandBuffer> command = [queue commandBuffer];
        if (use_projected_shortlist) {
          id<MTLComputeCommandEncoder> shortlist_encoder = [command computeCommandEncoder];
          [shortlist_encoder setComputePipelineState:shortlist_pipeline];
          [shortlist_encoder setBuffer:projected_buffer offset:0 atIndex:0];
          [shortlist_encoder setBuffer:centroid_buffer offset:0 atIndex:1];
          [shortlist_encoder setBuffer:list_offset_buffer offset:0 atIndex:2];
          [shortlist_encoder setBuffer:list_id_buffer offset:0 atIndex:3];
          [shortlist_encoder setBuffer:pilot_candidate_buffer offset:candidate_offset atIndex:4];
          [shortlist_encoder setBuffer:pilot_params_buffer offset:0 atIndex:5];
          [shortlist_encoder
            setThreadgroupMemoryLength:projected_shortlist_scratch(search_params)
                                atIndex:0];
          [shortlist_encoder dispatchThreadgroups:MTLSizeMake(pilot_block_size, 1, 1)
                                     threadsPerThreadgroup:MTLSizeMake(128, 1, 1)];
          [shortlist_encoder endEncoding];

          id<MTLComputeCommandEncoder> rerank_encoder = [command computeCommandEncoder];
          [rerank_encoder setComputePipelineState:rerank_pipeline];
          [rerank_encoder setBuffer:data_buffer offset:0 atIndex:0];
          [rerank_encoder setBuffer:pilot_candidate_buffer offset:candidate_offset atIndex:1];
          [rerank_encoder setBuffer:pilot_id_buffer offset:id_offset atIndex:2];
          [rerank_encoder setBuffer:pilot_dist_buffer offset:distance_offset atIndex:3];
          [rerank_encoder setBuffer:pilot_params_buffer offset:0 atIndex:4];
          [rerank_encoder dispatchThreadgroups:MTLSizeMake(pilot_block_size, 1, 1)
                                  threadsPerThreadgroup:MTLSizeMake(128, 1, 1)];
          [rerank_encoder endEncoding];
        } else {
          id<MTLComputeCommandEncoder> encoder = [command computeCommandEncoder];
          [encoder setComputePipelineState:ivf_pipeline];
          [encoder setBuffer:data_buffer offset:0 atIndex:0];
          [encoder setBuffer:projected_buffer offset:0 atIndex:1];
          [encoder setBuffer:centroid_buffer offset:0 atIndex:2];
          [encoder setBuffer:list_offset_buffer offset:0 atIndex:3];
          [encoder setBuffer:list_id_buffer offset:0 atIndex:4];
          [encoder setBuffer:pilot_id_buffer offset:id_offset atIndex:5];
          [encoder setBuffer:pilot_dist_buffer offset:distance_offset atIndex:6];
          [encoder setBuffer:pilot_params_buffer offset:0 atIndex:7];
          [encoder dispatchThreadgroups:MTLSizeMake(pilot_block_size, 1, 1)
                           threadsPerThreadgroup:MTLSizeMake(128, 1, 1)];
          [encoder endEncoding];
        }
        run_and_wait(command);
        [pilot_params_buffer release];
      }
      double value = recall_at_k(static_cast<const int*>([exact_id_buffer contents]), static_cast<const int*>([pilot_id_buffer contents]), pilot_n, k);
      probe_trace.push_back(probe_count);
      recall_trace.push_back(value);
      return value;
    };
    auto tune_nprobe = [&]() {
      nprobe = std::min(nlist, 8);
      int low_fail = 0;
      int high_pass = -1;
      double high_recall = 0.0;
      while (true) {
        measured = evaluate_probe(nprobe);
        if (measured >= tune_target) { high_pass = nprobe; high_recall = measured; break; }
        low_fail = nprobe;
        if (nprobe >= std::min(nlist, kMaxProbe)) { high_pass = nprobe; high_recall = measured; break; }
        nprobe = std::min(std::min(nlist, kMaxProbe), std::max(nprobe + 1, static_cast<int>(std::ceil(nprobe * 1.5))));
      }
      if (high_recall >= tune_target) {
        while (high_pass - low_fail > 2) {
          int mid = low_fail + (high_pass - low_fail) / 2;
          double value = evaluate_probe(mid);
          if (value >= tune_target) { high_pass = mid; high_recall = value; }
          else low_fail = mid;
        }
      }
      nprobe = high_pass;
      measured = high_recall;
    };
    std::vector<int> shortlist_attempts;
    shortlist_attempts.push_back(shortlist_size);
    tune_nprobe();
    for (int expanded_per_group : {96, 128}) {
      if (!use_projected_shortlist || measured >= tune_target) break;
      shortlist_per_group = expanded_per_group;
      shortlist_size = kMetalSimdGroups * shortlist_per_group;
      shortlist_attempts.push_back(shortlist_size);
      probe_trace.clear();
      recall_trace.clear();
      tune_nprobe();
    }
    if (use_projected_shortlist && measured < tune_target) {
      use_projected_shortlist = false;
      probe_trace.clear();
      recall_trace.clear();
      tune_nprobe();
    }
    // Re-evaluate the selected configuration because the final search of the
    // tuning loop may have tested a different probe count.
    measured = evaluate_probe(nprobe);
    const auto pilot_quality = pilot_row_quality(
      static_cast<const int*>([exact_id_buffer contents]),
      static_cast<const float*>([exact_dist_buffer contents]),
      static_cast<const int*>([pilot_id_buffer contents]),
      static_cast<const float*>([pilot_dist_buffer contents]), pilot_n, k);
    const auto t_tune = Clock::now();

    SearchParamsHost full_params{
      static_cast<std::uint32_t>(n), static_cast<std::uint32_t>(p),
      static_cast<std::uint32_t>(qdim), static_cast<std::uint32_t>(nlist),
      static_cast<std::uint32_t>(nprobe), static_cast<std::uint32_t>(k), 0u,
      static_cast<std::uint32_t>(use_projected_shortlist ? shortlist_per_group : 0)
    };
    id<MTLBuffer> search_params_buffer = [device newBufferWithBytes:&full_params length:sizeof(full_params) options:MTLResourceStorageModeShared];
    id<MTLBuffer> out_id_buffer = [device newBufferWithLength:static_cast<std::size_t>(n) * k * sizeof(int) options:MTLResourceStorageModeShared];
    id<MTLBuffer> out_dist_buffer = [device newBufferWithLength:static_cast<std::size_t>(n) * k * sizeof(float) options:MTLResourceStorageModeShared];
    if (use_projected_shortlist) {
      const int query_batch = std::min(n, 4096);
      id<MTLBuffer> candidate_buffer = [device newBufferWithLength:static_cast<std::size_t>(query_batch) * shortlist_size * sizeof(int) options:MTLResourceStorageModePrivate];
      for (int query_offset = 0; query_offset < n; query_offset += query_batch) {
        const int batch_rows = std::min(query_batch, n - query_offset);
        SearchParamsHost search_params{
          static_cast<std::uint32_t>(n), static_cast<std::uint32_t>(p),
          static_cast<std::uint32_t>(qdim), static_cast<std::uint32_t>(nlist),
          static_cast<std::uint32_t>(nprobe), static_cast<std::uint32_t>(k),
          static_cast<std::uint32_t>(query_offset),
          static_cast<std::uint32_t>(shortlist_per_group)
        };
        std::memcpy([search_params_buffer contents], &search_params, sizeof(search_params));
        id<MTLCommandBuffer> command = [queue commandBuffer];
        id<MTLComputeCommandEncoder> shortlist_encoder = [command computeCommandEncoder];
        [shortlist_encoder setComputePipelineState:shortlist_pipeline];
        [shortlist_encoder setBuffer:projected_buffer offset:0 atIndex:0];
        [shortlist_encoder setBuffer:centroid_buffer offset:0 atIndex:1];
        [shortlist_encoder setBuffer:list_offset_buffer offset:0 atIndex:2];
        [shortlist_encoder setBuffer:list_id_buffer offset:0 atIndex:3];
        [shortlist_encoder setBuffer:candidate_buffer offset:0 atIndex:4];
        [shortlist_encoder setBuffer:search_params_buffer offset:0 atIndex:5];
        [shortlist_encoder
          setThreadgroupMemoryLength:projected_shortlist_scratch(search_params)
                              atIndex:0];
        [shortlist_encoder dispatchThreadgroups:MTLSizeMake(batch_rows, 1, 1)
                                   threadsPerThreadgroup:MTLSizeMake(128, 1, 1)];
        [shortlist_encoder endEncoding];

        id<MTLComputeCommandEncoder> rerank_encoder = [command computeCommandEncoder];
        [rerank_encoder setComputePipelineState:rerank_pipeline];
        [rerank_encoder setBuffer:data_buffer offset:0 atIndex:0];
        [rerank_encoder setBuffer:candidate_buffer offset:0 atIndex:1];
        [rerank_encoder setBuffer:out_id_buffer
                           offset:static_cast<NSUInteger>(query_offset) * k * sizeof(int)
                          atIndex:2];
        [rerank_encoder setBuffer:out_dist_buffer
                           offset:static_cast<NSUInteger>(query_offset) * k * sizeof(float)
                          atIndex:3];
        [rerank_encoder setBuffer:search_params_buffer offset:0 atIndex:4];
        [rerank_encoder dispatchThreadgroups:MTLSizeMake(batch_rows, 1, 1)
                                threadsPerThreadgroup:MTLSizeMake(128, 1, 1)];
        [rerank_encoder endEncoding];
        run_and_wait(command);
      }
      [candidate_buffer release];
    } else {
      SearchParamsHost search_params{
        static_cast<std::uint32_t>(n), static_cast<std::uint32_t>(p),
        static_cast<std::uint32_t>(qdim), static_cast<std::uint32_t>(nlist),
        static_cast<std::uint32_t>(nprobe), static_cast<std::uint32_t>(k), 0u, 0u
      };
      std::memcpy([search_params_buffer contents], &search_params, sizeof(search_params));
      id<MTLCommandBuffer> command = [queue commandBuffer];
      id<MTLComputeCommandEncoder> encoder = [command computeCommandEncoder];
      [encoder setComputePipelineState:ivf_pipeline];
      [encoder setBuffer:data_buffer offset:0 atIndex:0]; [encoder setBuffer:projected_buffer offset:0 atIndex:1];
      [encoder setBuffer:centroid_buffer offset:0 atIndex:2]; [encoder setBuffer:list_offset_buffer offset:0 atIndex:3];
      [encoder setBuffer:list_id_buffer offset:0 atIndex:4]; [encoder setBuffer:out_id_buffer offset:0 atIndex:5];
      [encoder setBuffer:out_dist_buffer offset:0 atIndex:6]; [encoder setBuffer:search_params_buffer offset:0 atIndex:7];
      [encoder dispatchThreadgroups:MTLSizeMake(n, 1, 1) threadsPerThreadgroup:MTLSizeMake(128, 1, 1)];
      [encoder endEncoding]; run_and_wait(command);
    }
    const auto t_search = Clock::now();
    const double metal_allocated_after_search_bytes =
      metal_current_allocated_bytes(device);
    const double metal_live_buffer_bytes_after_search =
      metal_live_buffer_bytes({data_buffer, offset_map_buffer,
        feature_buffer, sign_buffer, projected_buffer,
        project_params_buffer, centroid_buffer, assignment_buffer,
        centroid_sum_buffer, centroid_count_buffer, index_params_buffer,
        list_offset_buffer, list_id_buffer, exact_id_buffer,
        exact_dist_buffer, pilot_id_buffer, pilot_dist_buffer,
        pilot_candidate_buffer, search_params_buffer, out_id_buffer,
        out_dist_buffer});

    const int* ids = static_cast<const int*>([out_id_buffer contents]);
    const float* d2 = static_cast<const float*>([out_dist_buffer contents]);
    Rcpp::IntegerMatrix indices(n, k);
    Rcpp::NumericMatrix distances(n, k);
    for (int i = 0; i < n; ++i) for (int j = 0; j < k; ++j) {
      std::size_t pos = static_cast<std::size_t>(i) * k + j;
      indices(i, j) = ids[pos] + 1;
      distances(i, j) = faissr_metal::output_distance(d2[pos], metric);
    }
    Rcpp::List result = Rcpp::List::create(
      Rcpp::Named("indices") = indices,
      Rcpp::Named("distances") = distances,
      Rcpp::Named("backend") = "metal",
      Rcpp::Named("method") = "native_metal_ivf",
      Rcpp::Named("metric") = metric_name,
      Rcpp::Named("target_recall") = target,
      Rcpp::Named("nlist") = nlist,
      Rcpp::Named("nprobe") = nprobe,
      Rcpp::Named("projection_dim") = qdim,
      Rcpp::Named("search_strategy") = use_projected_shortlist ?
        "projected_shortlist_exact_rerank" : "direct_exact_rerank",
      Rcpp::Named("shortlist_size") = use_projected_shortlist ? shortlist_size : 0,
      Rcpp::Named("shortlist_attempts") = shortlist_attempts,
      Rcpp::Named("pilot_recall") = measured,
      Rcpp::Named("pilot_guard_recall") = tune_target,
      Rcpp::Named("pilot_rows") = pilot_n,
      Rcpp::Named("pilot_min_recall") = pilot_quality.first,
      Rcpp::Named("pilot_max_k_distance_ratio") = pilot_quality.second,
      Rcpp::Named("target_met") = measured >= target,
      Rcpp::Named("index_build_seconds") =
        std::chrono::duration<double>(t_pack - t_setup).count(),
      Rcpp::Named("index_build_seconds_scope") =
        "metal_projection_training_and_list_pack",
      Rcpp::Named("search_seconds") =
        std::chrono::duration<double>(t_search - t_tune).count(),
      Rcpp::Named("search_seconds_scope") = "metal_full_search",
      Rcpp::Named("metal_allocated_before_bytes") =
        metal_allocated_before_bytes,
      Rcpp::Named("metal_allocated_after_search_bytes") =
        metal_allocated_after_search_bytes,
      Rcpp::Named("metal_live_buffer_bytes_after_search") =
        metal_live_buffer_bytes_after_search,
      Rcpp::Named("device_memory_measurement_scope") =
        "process_current_allocated_after_search_before_output_release",
      Rcpp::Named("device_memory_peak_measured") = false,
      Rcpp::Named("probe_trace") = probe_trace,
      Rcpp::Named("recall_trace") = recall_trace,
      Rcpp::Named("timing") = Rcpp::NumericVector::create(
        Rcpp::Named("convert") = std::chrono::duration<double>(t_convert - t0).count(),
        Rcpp::Named("metal_setup") = std::chrono::duration<double>(t_setup - t_convert).count(),
        Rcpp::Named("projection") = std::chrono::duration<double>(t_project - t_setup).count(),
        Rcpp::Named("ivf_training") = std::chrono::duration<double>(t_train - t_project).count(),
        Rcpp::Named("list_pack") = std::chrono::duration<double>(t_pack - t_train).count(),
        Rcpp::Named("pilot_exact") = std::chrono::duration<double>(t_exact - t_pack).count(),
        Rcpp::Named("pilot_tune") = std::chrono::duration<double>(t_tune - t_exact).count(),
        Rcpp::Named("full_search") = std::chrono::duration<double>(t_search - t_tune).count()
      )
    );
    result.attr("backend") = "metal";
    result.attr("method") = "native_metal_ivf";
    result.attr("metric") = metric_name;
    result.attr("target_recall") = target;
    result.attr("target_met") = measured >= target;

    [out_dist_buffer release]; [out_id_buffer release]; [search_params_buffer release];
    [pilot_candidate_buffer release];
    [pilot_dist_buffer release]; [pilot_id_buffer release];
    [exact_dist_buffer release]; [exact_id_buffer release];
    return result;
  }
}

Rcpp::List faissr_metal_knn_impl(SEXP data_sexp, int k,
    const std::string& requested_method,
    const std::string& metric_name, double target) {
  const auto started = std::chrono::steady_clock::now();
  const auto metric = faissr_metal::parse_knn_metric(metric_name);
  auto input = faissr_metal::matrix_to_row_major_float(
    data_sexp, metric);
  return faissr_metal_knn_float_impl(std::move(input), k,
    requested_method, metric_name, target, started);
}

Rcpp::List faissr_metal_knn_file_float(std::vector<float> values,
    int rows, int columns, int k, double target) {
  faissr_metal::FloatMatrix input;
  input.values = std::move(values);
  input.nrow = rows;
  input.ncol = columns;
  return faissr_metal_knn_float_impl(std::move(input), k,
    "ivf", "euclidean", target, std::chrono::steady_clock::now());
}

bool faissr_metal_file_capacity(double bytes) {
  @autoreleasepool {
    id<MTLDevice> device = MTLCreateSystemDefaultDevice();
    if (device == nil) return false;
    const double working_set = static_cast<double>(
      [device recommendedMaxWorkingSetSize]);
    const double allocated = metal_current_allocated_bytes(device);
    [device release];
    return std::isfinite(bytes) && bytes > 0 &&
      std::isfinite(working_set) && working_set > 0 &&
      std::isfinite(allocated) && allocated >= 0 &&
      bytes + allocated <= working_set;
  }
}

bool faissr_metal_cagra_uses_nn_descent(double target) {
  return metal_nnd_profile(target).seed_passes > 0;
}

double faissr_metal_cagra_workspace(int rows, int columns, int qdim,
    double shortlist_bytes, int degree, bool nn_descent) {
  return nn_descent ?
    metal_nnd_workspace(rows, columns, degree) :
    faissr_metal::cagra_workspace_bytes(rows, columns, qdim, shortlist_bytes, degree);
}

Rcpp::List faissr_metal_file_cagra_build_impl(int rows, int columns, int k,
    double target, double limit, const std::function<void(float*)>& read) {
  const double reference = 4.0 * rows * columns;
  const bool nn_descent = faissr_metal_cagra_uses_nn_descent(target);
  const bool balanced =
    faissr_metal::cagra_balanced_shape(rows, columns, k, target);
  const int qdim = faissr_metal::ivf_projection_dimensions(columns, balanced);
  const auto degree = faissr_metal::cagra_graph_degree(rows, columns, k, target, nn_descent);
  const int shortlist = metal_cagra_shortlist_per_group(
    rows, columns, qdim, target);
  const double shortlist_bytes = static_cast<double>(MetalCagraIndex::capacity) *
    kMetalSimdGroups * shortlist * sizeof(int);
  const double estimate = faissr_metal_cagra_workspace(
    rows, columns, qdim, shortlist_bytes, degree, nn_descent);
  if (!std::isfinite(limit) || estimate > limit ||
      !faissr_metal_file_capacity(estimate)) {
    Rcpp::stop("File-backed Metal CAGRA exceeds the unified memory budget");
  }
  faissr_metal::FloatMatrix input;
  input.nrow = rows;
  input.ncol = columns;
  Rcpp::List out = faissr_metal_knn_float_impl(std::move(input), k,
    "cagra", "euclidean", target, std::chrono::steady_clock::now(), read);
  out["reference_bytes"] = reference;
  out["device_bytes_estimate"] = estimate;
  out["host_batch_bytes_estimate"] =
    static_cast<double>(MetalCagraIndex::capacity) * k * 12;
  return out;
}

Rcpp::List faissr_metal_file_cagra_search_impl(SEXP pointer, int first, int count) {
  if (first < 1 || count < 1) Rcpp::stop("Invalid Metal CAGRA query range");
  return metal_cagra_search(*metal_cagra_pointer(pointer), first - 1, count);
}

void faissr_metal_file_cagra_release_impl(SEXP pointer) {
  std::unique_ptr<MetalCagraIndex> index(metal_cagra_pointer(pointer));
  R_ClearExternalPtr(pointer);
}

Rcpp::List faissr_metal_query_knn_impl(SEXP data_sexp,
                                       SEXP query_sexp,
                                       int k,
                                       const std::string& requested_method,
                                       const std::string& metric_name,
                                       double target) {
  using Clock = std::chrono::steady_clock;
  const auto t0 = Clock::now();
  const faissr_metal::KnnMetric metric =
    faissr_metal::parse_knn_metric(metric_name);
  faissr_metal::FloatMatrix reference =
    faissr_metal::matrix_to_row_major_float(data_sexp, metric);
  faissr_metal::FloatMatrix query =
    faissr_metal::matrix_to_row_major_float(query_sexp, metric);
  const auto t_convert = Clock::now();
  if (reference.nrow < 1 || query.nrow < 1 ||
      reference.ncol < 1 || reference.ncol != query.ncol ||
      reference.ncol > kMaxGlobalP || k < 1 || k > kMaxK ||
      k > reference.nrow) {
    Rcpp::stop(
      "Native Metal query KNN requires matching 1-%d dimensional matrices "
      "and k <= min(%d, nrow(reference)).",
      kMaxGlobalP, kMaxK
    );
  }
  std::string method = requested_method;
  const bool ivf_supported = faissr_metal::ivf_shape_supported(
    reference.nrow, reference.ncol, k) &&
    faissr_metal::ivf_shape_supported(query.nrow, query.ncol, k);
  if (method == "auto") {
    method = reference.nrow < 4096 || !ivf_supported ? "exact" : "ivf";
  }
  if (method != "exact" && method != "ivf") {
    Rcpp::stop(
      "Native Metal reference-query KNN supports `exact`, `ivf`, or `auto`."
    );
  }
  if (method == "ivf" && !ivf_supported) {
    Rcpp::stop(
      "Native Metal IVF query KNN requires at most %d dimensions and "
      "32-bit buffer offsets; use exact search for this input.", kMaxP
    );
  }
  const int qdim = projection_dim(reference.ncol);
  const int nlist = std::max(
    16,
    std::min(
      kMaxLists,
      static_cast<int>(
        std::ceil(4.0 * std::sqrt(static_cast<double>(reference.nrow)))
      )
    )
  );

  std::vector<std::uint32_t> feature_offsets(
    static_cast<std::size_t>(qdim) + 1u, 0u
  );
  std::vector<std::vector<std::pair<std::uint32_t, std::int8_t>>> buckets(
    qdim
  );
  for (int d = 0; d < reference.ncol; ++d) {
    const std::uint32_t h =
      static_cast<std::uint32_t>(d + 1) * 2654435761u;
    const int bucket = static_cast<int>(
      h & static_cast<std::uint32_t>(qdim - 1)
    );
    const std::int8_t sign =
      ((h >> 17u) & 1u) ? std::int8_t(1) : std::int8_t(-1);
    buckets[bucket].push_back(
      {static_cast<std::uint32_t>(d), sign}
    );
  }
  std::vector<std::uint32_t> feature_ids;
  std::vector<std::int8_t> feature_signs;
  feature_ids.reserve(reference.ncol);
  feature_signs.reserve(reference.ncol);
  for (int bucket = 0; bucket < qdim; ++bucket) {
    feature_offsets[bucket] =
      static_cast<std::uint32_t>(feature_ids.size());
    for (const auto& item : buckets[bucket]) {
      feature_ids.push_back(item.first);
      feature_signs.push_back(item.second);
    }
  }
  feature_offsets[qdim] =
    static_cast<std::uint32_t>(feature_ids.size());

  @autoreleasepool {
    MetalKnnState& state = metal_knn_state();
    id<MTLDevice> device = state.device;
    const auto t_setup = Clock::now();
    const double metal_allocated_before_bytes =
      metal_current_allocated_bytes(device);
    id<MTLBuffer> reference_buffer = metal_shared_buffer(device,
      reference.values.size() * sizeof(float), reference.values.data());
    id<MTLBuffer> query_buffer = metal_shared_buffer(device,
      query.values.size() * sizeof(float), query.values.data());
    const std::size_t output_items =
      static_cast<std::size_t>(query.nrow) * k;
    id<MTLBuffer> out_id_buffer = metal_shared_buffer(
      device, output_items * sizeof(int));
    id<MTLBuffer> out_dist_buffer = metal_shared_buffer(
      device, output_items * sizeof(float));

    auto exact_search = [&](id<MTLBuffer> queries,
                            int n_queries,
                            id<MTLBuffer> output_ids,
                            id<MTLBuffer> output_distances) {
      QuerySearchParamsHost params{
        static_cast<std::uint32_t>(reference.nrow),
        static_cast<std::uint32_t>(n_queries),
        static_cast<std::uint32_t>(reference.ncol),
        static_cast<std::uint32_t>(k),
        static_cast<std::uint32_t>(reference.nrow)
      };
      id<MTLBuffer> params_buffer = [device
        newBufferWithBytes:&params
        length:sizeof(params)
        options:MTLResourceStorageModeShared];
      if (params_buffer == nil) {
        Rcpp::stop("Metal KNN could not allocate its search parameters.");
      }
      id<MTLCommandBuffer> command = [state.queue commandBuffer];
      id<MTLComputeCommandEncoder> encoder = [command computeCommandEncoder];
      [encoder setComputePipelineState:
        reference.ncol <= kMaxP
          ? state.exact_query_pipeline
          : state.exact_query_global_pipeline];
      [encoder setBuffer:reference_buffer offset:0 atIndex:0];
      [encoder setBuffer:queries offset:0 atIndex:1];
      [encoder setBuffer:output_ids offset:0 atIndex:2];
      [encoder setBuffer:output_distances offset:0 atIndex:3];
      [encoder setBuffer:params_buffer offset:0 atIndex:4];
      [encoder
        dispatchThreadgroups:MTLSizeMake(n_queries, 1, 1)
        threadsPerThreadgroup:MTLSizeMake(128, 1, 1)];
      [encoder endEncoding];
      run_and_wait(command);
      [params_buffer release];
    };

    if (method == "exact") {
      exact_search(
        query_buffer, query.nrow, out_id_buffer, out_dist_buffer
      );
      const double metal_allocated_after_search_bytes =
        metal_current_allocated_bytes(device);
      const double metal_live_buffer_bytes_after_search =
        metal_live_buffer_bytes({reference_buffer, query_buffer,
          out_id_buffer, out_dist_buffer});
      const auto t_search = Clock::now();
      const int* ids =
        static_cast<const int*>([out_id_buffer contents]);
      const float* internal_distances =
        static_cast<const float*>([out_dist_buffer contents]);
      Rcpp::IntegerMatrix indices(query.nrow, k);
      Rcpp::NumericMatrix distances(query.nrow, k);
      for (int i = 0; i < query.nrow; ++i) {
        for (int j = 0; j < k; ++j) {
          const std::size_t pos = static_cast<std::size_t>(i) * k + j;
          indices(i, j) = ids[pos] + 1;
          distances(i, j) =
            faissr_metal::output_distance(internal_distances[pos], metric);
        }
      }
      const auto t_copy = Clock::now();
      Rcpp::List result = Rcpp::List::create(
        Rcpp::Named("indices") = indices,
        Rcpp::Named("distances") = distances,
        Rcpp::Named("backend") = "metal",
        Rcpp::Named("method") = "native_metal_exact_query",
        Rcpp::Named("metric") = metric_name,
        Rcpp::Named("target_recall") = target,
        Rcpp::Named("pilot_recall") = 1.0,
        Rcpp::Named("target_met") = true,
        Rcpp::Named("exact") = true,
        Rcpp::Named("exclude_self") = false,
        Rcpp::Named("n_reference") = reference.nrow,
        Rcpp::Named("n_query") = query.nrow,
        Rcpp::Named("index_build_seconds") = 0.0,
        Rcpp::Named("index_build_seconds_scope") =
          "no_index_exact_search",
        Rcpp::Named("search_seconds") =
          std::chrono::duration<double>(t_search - t_setup).count(),
        Rcpp::Named("search_seconds_scope") =
          "metal_buffer_setup_and_exact_search",
        Rcpp::Named("metal_allocated_before_bytes") =
          metal_allocated_before_bytes,
        Rcpp::Named("metal_allocated_after_search_bytes") =
          metal_allocated_after_search_bytes,
        Rcpp::Named("metal_live_buffer_bytes_after_search") =
          metal_live_buffer_bytes_after_search,
        Rcpp::Named("device_memory_measurement_scope") =
          "process_current_allocated_after_search_before_output_release",
        Rcpp::Named("device_memory_peak_measured") = false,
        Rcpp::Named("timing") = Rcpp::NumericVector::create(
          Rcpp::Named("convert") =
            std::chrono::duration<double>(t_convert - t0).count(),
          Rcpp::Named("metal_setup") =
            std::chrono::duration<double>(t_setup - t_convert).count(),
          Rcpp::Named("search") =
            std::chrono::duration<double>(t_search - t_setup).count(),
          Rcpp::Named("copy_to_R") =
            std::chrono::duration<double>(t_copy - t_search).count()
        )
      );
      result.attr("backend") = "metal";
      result.attr("method") = "native_metal_exact_query";
      result.attr("metric") = metric_name;
      result.attr("exact") = true;
      result.attr("target_met") = true;
      result.attr("exclude_self") = false;
      return result;
    }

    id<MTLBuffer> offset_map_buffer = [device
      newBufferWithBytes:feature_offsets.data()
      length:feature_offsets.size() * sizeof(std::uint32_t)
      options:MTLResourceStorageModeShared];
    id<MTLBuffer> feature_buffer = [device
      newBufferWithBytes:feature_ids.data()
      length:feature_ids.size() * sizeof(std::uint32_t)
      options:MTLResourceStorageModeShared];
    id<MTLBuffer> sign_buffer = [device
      newBufferWithBytes:feature_signs.data()
      length:feature_signs.size() * sizeof(std::int8_t)
      options:MTLResourceStorageModeShared];
    id<MTLBuffer> reference_projected_buffer = [device
      newBufferWithLength:
        static_cast<std::size_t>(reference.nrow) * qdim * sizeof(float)
      options:MTLResourceStorageModeShared];
    id<MTLBuffer> query_projected_buffer = [device
      newBufferWithLength:
        static_cast<std::size_t>(query.nrow) * qdim * sizeof(float)
      options:MTLResourceStorageModeShared];

    auto project = [&](id<MTLBuffer> input_buffer,
                       id<MTLBuffer> projected_buffer,
                       int n_rows) {
      ProjectParamsHost params{
        static_cast<std::uint32_t>(n_rows),
        static_cast<std::uint32_t>(reference.ncol),
        static_cast<std::uint32_t>(qdim)
      };
      id<MTLBuffer> params_buffer = [device
        newBufferWithBytes:&params
        length:sizeof(params)
        options:MTLResourceStorageModeShared];
      id<MTLCommandBuffer> command = [state.queue commandBuffer];
      id<MTLComputeCommandEncoder> encoder = [command computeCommandEncoder];
      [encoder setComputePipelineState:state.project_pipeline];
      [encoder setBuffer:input_buffer offset:0 atIndex:0];
      [encoder setBuffer:offset_map_buffer offset:0 atIndex:1];
      [encoder setBuffer:feature_buffer offset:0 atIndex:2];
      [encoder setBuffer:sign_buffer offset:0 atIndex:3];
      [encoder setBuffer:projected_buffer offset:0 atIndex:4];
      [encoder setBuffer:params_buffer offset:0 atIndex:5];
      [encoder
        dispatchThreadgroups:MTLSizeMake(n_rows, 1, 1)
        threadsPerThreadgroup:MTLSizeMake(qdim, 1, 1)];
      [encoder endEncoding];
      run_and_wait(command);
      [params_buffer release];
    };
    project(
      reference_buffer, reference_projected_buffer, reference.nrow
    );
    project(query_buffer, query_projected_buffer, query.nrow);
    const auto t_project = Clock::now();

    const float* reference_projected =
      static_cast<const float*>([reference_projected_buffer contents]);
    std::mt19937 rng(4u);
    std::vector<int> order(reference.nrow);
    std::iota(order.begin(), order.end(), 0);
    std::shuffle(order.begin(), order.end(), rng);
    std::vector<float> centroids(
      static_cast<std::size_t>(nlist) * qdim
    );
    for (int centroid = 0; centroid < nlist; ++centroid) {
      std::memcpy(
        centroids.data() + static_cast<std::size_t>(centroid) * qdim,
        reference_projected +
          static_cast<std::size_t>(order[centroid]) * qdim,
        static_cast<std::size_t>(qdim) * sizeof(float)
      );
    }
    id<MTLBuffer> centroid_buffer = [device
      newBufferWithBytes:centroids.data()
      length:centroids.size() * sizeof(float)
      options:MTLResourceStorageModeShared];
    id<MTLBuffer> assignment_buffer = [device
      newBufferWithLength:
        static_cast<std::size_t>(reference.nrow) * sizeof(int)
      options:MTLResourceStorageModeShared];
    id<MTLBuffer> centroid_sum_buffer = [device
      newBufferWithLength:
        static_cast<std::size_t>(nlist) * qdim * sizeof(float)
      options:MTLResourceStorageModePrivate];
    id<MTLBuffer> centroid_count_buffer = [device
      newBufferWithLength:
        static_cast<std::size_t>(nlist) * sizeof(std::uint32_t)
      options:MTLResourceStorageModePrivate];
    IndexParamsHost index_params{
      static_cast<std::uint32_t>(reference.nrow),
      static_cast<std::uint32_t>(reference.ncol),
      static_cast<std::uint32_t>(qdim),
      static_cast<std::uint32_t>(nlist)
    };
    id<MTLBuffer> index_params_buffer = [device
      newBufferWithBytes:&index_params
      length:sizeof(index_params)
      options:MTLResourceStorageModeShared];

    for (int iteration = 0; iteration < 4; ++iteration) {
      id<MTLCommandBuffer> command = [state.queue commandBuffer];
      id<MTLComputeCommandEncoder> assignment_encoder =
        [command computeCommandEncoder];
      [assignment_encoder setComputePipelineState:state.assign_pipeline];
      [assignment_encoder
        setBuffer:reference_projected_buffer offset:0 atIndex:0];
      [assignment_encoder setBuffer:centroid_buffer offset:0 atIndex:1];
      [assignment_encoder setBuffer:assignment_buffer offset:0 atIndex:2];
      [assignment_encoder setBuffer:index_params_buffer offset:0 atIndex:3];
      [assignment_encoder
        dispatchThreadgroups:MTLSizeMake(reference.nrow, 1, 1)
        threadsPerThreadgroup:MTLSizeMake(128, 1, 1)];
      [assignment_encoder endEncoding];
      if (iteration < 3) {
        const std::size_t centroid_items =
          static_cast<std::size_t>(nlist) * qdim;
        id<MTLComputeCommandEncoder> clear_encoder =
          [command computeCommandEncoder];
        [clear_encoder
          setComputePipelineState:state.clear_centroids_pipeline];
        [clear_encoder setBuffer:centroid_sum_buffer offset:0 atIndex:0];
        [clear_encoder setBuffer:centroid_count_buffer offset:0 atIndex:1];
        [clear_encoder setBuffer:index_params_buffer offset:0 atIndex:2];
        [clear_encoder
          dispatchThreads:
            MTLSizeMake(std::max<std::size_t>(centroid_items, nlist), 1, 1)
          threadsPerThreadgroup:MTLSizeMake(256, 1, 1)];
        [clear_encoder endEncoding];

        id<MTLComputeCommandEncoder> accumulate_encoder =
          [command computeCommandEncoder];
        [accumulate_encoder
          setComputePipelineState:state.accumulate_centroids_pipeline];
        [accumulate_encoder
          setBuffer:reference_projected_buffer offset:0 atIndex:0];
        [accumulate_encoder setBuffer:assignment_buffer offset:0 atIndex:1];
        [accumulate_encoder setBuffer:centroid_sum_buffer offset:0 atIndex:2];
        [accumulate_encoder
          setBuffer:centroid_count_buffer offset:0 atIndex:3];
        [accumulate_encoder setBuffer:index_params_buffer offset:0 atIndex:4];
        [accumulate_encoder
          dispatchThreads:
            MTLSizeMake(
              static_cast<std::size_t>(reference.nrow) * qdim, 1, 1
            )
          threadsPerThreadgroup:MTLSizeMake(256, 1, 1)];
        [accumulate_encoder endEncoding];

        id<MTLComputeCommandEncoder> finalize_encoder =
          [command computeCommandEncoder];
        [finalize_encoder
          setComputePipelineState:state.finalize_centroids_pipeline];
        [finalize_encoder setBuffer:centroid_sum_buffer offset:0 atIndex:0];
        [finalize_encoder
          setBuffer:centroid_count_buffer offset:0 atIndex:1];
        [finalize_encoder setBuffer:centroid_buffer offset:0 atIndex:2];
        [finalize_encoder setBuffer:index_params_buffer offset:0 atIndex:3];
        [finalize_encoder
          dispatchThreads:MTLSizeMake(centroid_items, 1, 1)
          threadsPerThreadgroup:MTLSizeMake(256, 1, 1)];
        [finalize_encoder endEncoding];
      }
      run_and_wait(command);
    }
    const auto t_train = Clock::now();

    const int* assignment =
      static_cast<const int*>([assignment_buffer contents]);
    std::vector<std::uint32_t> list_offsets(
      static_cast<std::size_t>(nlist) + 1u, 0u
    );
    for (int row = 0; row < reference.nrow; ++row) {
      if (assignment[row] >= 0 && assignment[row] < nlist) {
        ++list_offsets[static_cast<std::size_t>(assignment[row]) + 1u];
      }
    }
    for (int list = 0; list < nlist; ++list) {
      list_offsets[list + 1] += list_offsets[list];
    }
    std::vector<std::uint32_t> cursor = list_offsets;
    std::vector<int> list_ids(reference.nrow, -1);
    for (int row = 0; row < reference.nrow; ++row) {
      const int list = assignment[row];
      if (list >= 0 && list < nlist) {
        list_ids[cursor[list]++] = row;
      }
    }
    id<MTLBuffer> list_offset_buffer = [device
      newBufferWithBytes:list_offsets.data()
      length:list_offsets.size() * sizeof(std::uint32_t)
      options:MTLResourceStorageModeShared];
    id<MTLBuffer> list_id_buffer = [device
      newBufferWithBytes:list_ids.data()
      length:list_ids.size() * sizeof(int)
      options:MTLResourceStorageModeShared];
    const auto t_pack = Clock::now();

    auto ivf_search = [&](id<MTLBuffer> queries,
                          id<MTLBuffer> projected_queries,
                          int n_queries,
                          int nprobe,
                          id<MTLBuffer> output_ids,
                          id<MTLBuffer> output_distances) {
      QueryIvfParamsHost params{
        static_cast<std::uint32_t>(reference.nrow),
        static_cast<std::uint32_t>(n_queries),
        static_cast<std::uint32_t>(reference.ncol),
        static_cast<std::uint32_t>(qdim),
        static_cast<std::uint32_t>(nlist),
        static_cast<std::uint32_t>(nprobe),
        static_cast<std::uint32_t>(k)
      };
      id<MTLBuffer> params_buffer = [device
        newBufferWithBytes:&params
        length:sizeof(params)
        options:MTLResourceStorageModeShared];
      id<MTLCommandBuffer> command = [state.queue commandBuffer];
      id<MTLComputeCommandEncoder> encoder = [command computeCommandEncoder];
      [encoder setComputePipelineState:state.ivf_query_pipeline];
      [encoder setBuffer:reference_buffer offset:0 atIndex:0];
      [encoder setBuffer:queries offset:0 atIndex:1];
      [encoder setBuffer:projected_queries offset:0 atIndex:2];
      [encoder setBuffer:centroid_buffer offset:0 atIndex:3];
      [encoder setBuffer:list_offset_buffer offset:0 atIndex:4];
      [encoder setBuffer:list_id_buffer offset:0 atIndex:5];
      [encoder setBuffer:output_ids offset:0 atIndex:6];
      [encoder setBuffer:output_distances offset:0 atIndex:7];
      [encoder setBuffer:params_buffer offset:0 atIndex:8];
      [encoder
        dispatchThreadgroups:MTLSizeMake(n_queries, 1, 1)
        threadsPerThreadgroup:MTLSizeMake(128, 1, 1)];
      [encoder endEncoding];
      run_and_wait(command);
      [params_buffer release];
    };

    const int pilot_n = std::min(query.nrow, 128);
    id<MTLBuffer> exact_pilot_ids = [device
      newBufferWithLength:
        static_cast<std::size_t>(pilot_n) * k * sizeof(int)
      options:MTLResourceStorageModeShared];
    id<MTLBuffer> exact_pilot_distances = [device
      newBufferWithLength:
        static_cast<std::size_t>(pilot_n) * k * sizeof(float)
      options:MTLResourceStorageModeShared];
    id<MTLBuffer> ivf_pilot_ids = [device
      newBufferWithLength:
        static_cast<std::size_t>(pilot_n) * k * sizeof(int)
      options:MTLResourceStorageModeShared];
    id<MTLBuffer> ivf_pilot_distances = [device
      newBufferWithLength:
        static_cast<std::size_t>(pilot_n) * k * sizeof(float)
      options:MTLResourceStorageModeShared];
    exact_search(
      query_buffer, pilot_n, exact_pilot_ids, exact_pilot_distances
    );
    const auto t_exact = Clock::now();

    int nprobe = std::min(nlist, 8);
    int low_fail = 0;
    int high_pass = 0;
    double measured = 0.0;
    const double pilot_trials = static_cast<double>(pilot_n) * k;
    const double sampling_margin = 2.58 * std::sqrt(
      target * (1.0 - target) / pilot_trials);
    const double tune_target = std::min(1.0,
      target + std::max(0.003, sampling_margin));
    std::vector<int> probe_trace;
    std::vector<double> recall_trace;
    while (true) {
      ivf_search(
        query_buffer, query_projected_buffer, pilot_n, nprobe,
        ivf_pilot_ids, ivf_pilot_distances
      );
      measured = recall_at_k(
        static_cast<const int*>([exact_pilot_ids contents]),
        static_cast<const int*>([ivf_pilot_ids contents]),
        pilot_n,
        k
      );
      probe_trace.push_back(nprobe);
      recall_trace.push_back(measured);
      if (measured >= tune_target) {
        high_pass = nprobe;
        break;
      }
      low_fail = nprobe;
      if (nprobe >= std::min(nlist, kMaxProbe)) {
        break;
      }
      nprobe = std::min(
        std::min(nlist, kMaxProbe),
        std::max(nprobe + 1, static_cast<int>(std::ceil(nprobe * 1.5)))
      );
    }
    while (high_pass > 0 && high_pass - low_fail > 1) {
      const int candidate = low_fail + (high_pass - low_fail) / 2;
      ivf_search(
        query_buffer, query_projected_buffer, pilot_n, candidate,
        ivf_pilot_ids, ivf_pilot_distances
      );
      const double candidate_recall = recall_at_k(
        static_cast<const int*>([exact_pilot_ids contents]),
        static_cast<const int*>([ivf_pilot_ids contents]),
        pilot_n,
        k
      );
      probe_trace.push_back(candidate);
      recall_trace.push_back(candidate_recall);
      if (candidate_recall >= tune_target) {
        high_pass = candidate;
        measured = candidate_recall;
      } else {
        low_fail = candidate;
      }
    }
    if (high_pass > 0) {
      nprobe = high_pass;
    }
    const auto t_tune = Clock::now();
    ivf_search(
      query_buffer, query_projected_buffer, query.nrow, nprobe,
      out_id_buffer, out_dist_buffer
    );
    const auto t_search = Clock::now();
    const double metal_allocated_after_search_bytes =
      metal_current_allocated_bytes(device);
    const double metal_live_buffer_bytes_after_search =
      metal_live_buffer_bytes({reference_buffer, query_buffer,
        out_id_buffer, out_dist_buffer, offset_map_buffer,
        feature_buffer, sign_buffer, reference_projected_buffer,
        query_projected_buffer, centroid_buffer, assignment_buffer,
        centroid_sum_buffer, centroid_count_buffer, index_params_buffer,
        list_offset_buffer, list_id_buffer, exact_pilot_ids,
        exact_pilot_distances, ivf_pilot_ids, ivf_pilot_distances});

    const int* ids =
      static_cast<const int*>([out_id_buffer contents]);
    const float* internal_distances =
      static_cast<const float*>([out_dist_buffer contents]);
    Rcpp::IntegerMatrix indices(query.nrow, k);
    Rcpp::NumericMatrix distances(query.nrow, k);
    for (int i = 0; i < query.nrow; ++i) {
      for (int j = 0; j < k; ++j) {
        const std::size_t pos = static_cast<std::size_t>(i) * k + j;
        indices(i, j) = ids[pos] + 1;
        distances(i, j) =
          faissr_metal::output_distance(internal_distances[pos], metric);
      }
    }
    const auto t_copy = Clock::now();
    Rcpp::List result = Rcpp::List::create(
      Rcpp::Named("indices") = indices,
      Rcpp::Named("distances") = distances,
      Rcpp::Named("backend") = "metal",
      Rcpp::Named("method") = "native_metal_ivf_query",
      Rcpp::Named("metric") = metric_name,
      Rcpp::Named("target_recall") = target,
      Rcpp::Named("pilot_recall") = measured,
      Rcpp::Named("pilot_guard_recall") = tune_target,
      Rcpp::Named("pilot_rows") = pilot_n,
      Rcpp::Named("target_met") = measured >= target,
      Rcpp::Named("exact") = false,
      Rcpp::Named("exclude_self") = false,
      Rcpp::Named("n_reference") = reference.nrow,
      Rcpp::Named("n_query") = query.nrow,
      Rcpp::Named("index_build_seconds") =
        std::chrono::duration<double>(t_pack - t_setup).count(),
      Rcpp::Named("index_build_seconds_scope") =
        "metal_projection_training_and_list_pack",
      Rcpp::Named("search_seconds") =
        std::chrono::duration<double>(t_search - t_tune).count(),
      Rcpp::Named("search_seconds_scope") = "metal_full_search",
      Rcpp::Named("metal_allocated_before_bytes") =
        metal_allocated_before_bytes,
      Rcpp::Named("metal_allocated_after_search_bytes") =
        metal_allocated_after_search_bytes,
      Rcpp::Named("metal_live_buffer_bytes_after_search") =
        metal_live_buffer_bytes_after_search,
      Rcpp::Named("device_memory_measurement_scope") =
        "process_current_allocated_after_search_before_output_release",
      Rcpp::Named("device_memory_peak_measured") = false,
      Rcpp::Named("nlist") = nlist,
      Rcpp::Named("nprobe") = nprobe,
      Rcpp::Named("projection_dim") = qdim,
      Rcpp::Named("probe_trace") = probe_trace,
      Rcpp::Named("recall_trace") = recall_trace,
      Rcpp::Named("timing") = Rcpp::NumericVector::create(
        Rcpp::Named("convert") =
          std::chrono::duration<double>(t_convert - t0).count(),
        Rcpp::Named("metal_setup") =
          std::chrono::duration<double>(t_setup - t_convert).count(),
        Rcpp::Named("projection") =
          std::chrono::duration<double>(t_project - t_setup).count(),
        Rcpp::Named("ivf_training") =
          std::chrono::duration<double>(t_train - t_project).count(),
        Rcpp::Named("list_pack") =
          std::chrono::duration<double>(t_pack - t_train).count(),
        Rcpp::Named("pilot_exact") =
          std::chrono::duration<double>(t_exact - t_pack).count(),
        Rcpp::Named("pilot_tune") =
          std::chrono::duration<double>(t_tune - t_exact).count(),
        Rcpp::Named("search") =
          std::chrono::duration<double>(t_search - t_tune).count(),
        Rcpp::Named("copy_to_R") =
          std::chrono::duration<double>(t_copy - t_search).count()
      )
    );
    result.attr("backend") = "metal";
    result.attr("method") = "native_metal_ivf_query";
    result.attr("metric") = metric_name;
    result.attr("exact") = false;
    result.attr("target_met") = measured >= target;
    result.attr("exclude_self") = false;

    [ivf_pilot_distances release];
    [ivf_pilot_ids release];
    [exact_pilot_distances release];
    [exact_pilot_ids release];
    [list_id_buffer release];
    [list_offset_buffer release];
    [index_params_buffer release];
    [centroid_count_buffer release];
    [centroid_sum_buffer release];
    [assignment_buffer release];
    [centroid_buffer release];
    [query_projected_buffer release];
    [reference_projected_buffer release];
    [sign_buffer release];
    [feature_buffer release];
    [offset_map_buffer release];
    return result;
  }
}

namespace {

void merge_exact_tiles(const int* tile_ids, const float* tile_distances,
    int n_queries, int k, int tiles, int* ids, float* distances) {
  const auto stride = static_cast<std::size_t>(n_queries) * k;
  for (int query = 0; query < n_queries; ++query) {
    const auto offset = static_cast<std::size_t>(query) * k;
    int heads[16] = {};
    for (int rank = 0; rank < k; ++rank) {
      std::pair<float, int> best{std::numeric_limits<float>::infinity(), -1};
      int best_tile = -1;
      for (int tile = 0; tile < tiles; ++tile) {
        if (heads[tile] == k) continue;
        const auto index = tile * stride + offset + heads[tile];
        const std::pair<float, int> candidate{
          tile_distances[index], tile_ids[index]};
        if (candidate.second >= 0 && candidate < best) {
          best = candidate;
          best_tile = tile;
        }
      }
      if (best_tile >= 0) ++heads[best_tile];
      ids[offset + rank] = best.second;
      distances[offset + rank] = best.first;
    }
  }
}

}  // namespace

struct FaissrMetalFlatBatch {
  int query_capacity;
  int p;
  int reference_capacity;
  int max_k;
  id<MTLBuffer> reference = nil;
  id<MTLBuffer> query = nil;
  id<MTLBuffer> ids = nil;
  id<MTLBuffer> distances = nil;
  id<MTLBuffer> params = nil;
  double owned_bytes = 0.0;

  ~FaissrMetalFlatBatch() {
    [params release];
    [distances release];
    [ids release];
    [query release];
    [reference release];
  }
};

FaissrMetalFlatBatch* faissr_metal_flat_batch_prepare(const float* query,
    int query_capacity, int p, int reference_capacity, int max_k) {
  @autoreleasepool {
    MetalKnnState& state = metal_knn_state();
    id<MTLDevice> device = state.device;
    auto batch = std::make_unique<FaissrMetalFlatBatch>();
    batch->query_capacity = query_capacity;
    batch->p = p;
    batch->reference_capacity = reference_capacity;
    batch->max_k = max_k;
    const int max_tiles = query_capacity <= 1024 && reference_capacity >= 65536 ?
      16 : 1;
    const auto output_items = static_cast<std::size_t>(query_capacity) *
      max_k * max_tiles;
    batch->reference = [metal_shared_buffer(device,
      static_cast<std::size_t>(reference_capacity) * p * sizeof(float))
      retain];
    batch->query = [metal_shared_buffer(device,
      static_cast<std::size_t>(query_capacity) * p * sizeof(float), query) retain];
    batch->ids = [metal_shared_buffer(
      device, output_items * sizeof(int)) retain];
    batch->distances = [metal_shared_buffer(
      device, output_items * sizeof(float)) retain];
    batch->params = [metal_shared_buffer(
      device, sizeof(QuerySearchParamsHost)) retain];
    batch->owned_bytes = metal_live_buffer_bytes({batch->reference,
      batch->query, batch->ids, batch->distances, batch->params});
    return batch.release();
  }
}

void faissr_metal_flat_batch_release(FaissrMetalFlatBatch* batch) {
  delete batch;
}

float* faissr_metal_flat_batch_reference(FaissrMetalFlatBatch& batch) {
  return static_cast<float*>([batch.reference contents]);
}

float* faissr_metal_flat_batch_query(FaissrMetalFlatBatch& batch) {
  return static_cast<float*>([batch.query contents]);
}

double faissr_metal_flat_batch_owned_bytes(const FaissrMetalFlatBatch& batch) {
  return batch.owned_bytes;
}

void faissr_metal_flat_batch_search(FaissrMetalFlatBatch& batch,
    int n_query, int n_reference, int k,
    int* ids, float* distances, double* owned_buffer_bytes) {
  if (n_query < 1 || n_query > batch.query_capacity ||
      n_reference < 1 || n_reference > batch.reference_capacity ||
      k < 1 || k > std::min(n_reference, batch.max_k)) {
    Rcpp::stop("Metal Flat shard exceeds its staging capacity");
  }
  @autoreleasepool {
    MetalKnnState& state = metal_knn_state();
    const int p = batch.p;
    // More independent threadgroups keep the device busy with few queries.
    const auto tile_rows = batch.query_capacity <= 1024 && n_reference >= 65536 ?
      std::max(16384, (n_reference - 1) / 16 + 1) : n_reference;
    const auto tiles = (n_reference - 1) / tile_rows + 1;
    const std::size_t output_items =
      static_cast<std::size_t>(n_query) * k;
    QuerySearchParamsHost params{
      static_cast<std::uint32_t>(n_reference),
      static_cast<std::uint32_t>(n_query),
      static_cast<std::uint32_t>(p),
      static_cast<std::uint32_t>(k),
      static_cast<std::uint32_t>(tile_rows)
    };
    std::memcpy([batch.params contents], &params, sizeof(params));
    id<MTLCommandBuffer> command = [state.queue commandBuffer];
    id<MTLComputeCommandEncoder> encoder =
      [command computeCommandEncoder];
    [encoder setComputePipelineState:p <= kMaxP ?
      state.exact_query_pipeline : state.exact_query_global_pipeline];
    [encoder setBuffer:batch.reference offset:0 atIndex:0];
    [encoder setBuffer:batch.query offset:0 atIndex:1];
    [encoder setBuffer:batch.ids offset:0 atIndex:2];
    [encoder setBuffer:batch.distances offset:0 atIndex:3];
    [encoder setBuffer:batch.params offset:0 atIndex:4];
    [encoder dispatchThreadgroups:MTLSizeMake(n_query * tiles, 1, 1)
      threadsPerThreadgroup:MTLSizeMake(128, 1, 1)];
    [encoder endEncoding];
    run_and_wait(command);
    *owned_buffer_bytes = batch.owned_bytes;
    if (tiles == 1) {
      std::memcpy(ids, [batch.ids contents], output_items * sizeof(int));
      std::memcpy(distances, [batch.distances contents],
        output_items * sizeof(float));
    } else {
      merge_exact_tiles(static_cast<const int*>([batch.ids contents]),
        static_cast<const float*>([batch.distances contents]),
        n_query, k, tiles, ids, distances);
    }
  }
}
