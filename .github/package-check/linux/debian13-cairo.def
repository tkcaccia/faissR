Bootstrap: localimage
From: @UBUNTU_BASE@

# Complete the minimal bundled-BLAS R image for rendered-vignette checks.
# UBUNTU_BASE_IMAGE is the build.sh local-image placeholder, here a Debian SIF.
%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends devscripts qpdf libcairo2-dev libxt-dev libjpeg-dev libpng-dev libtiff-dev
    curl -fsSL https://cran.r-project.org/src/base/R-4/R-4.6.0.tar.gz -o /tmp/R.tar.gz
    tar -xzf /tmp/R.tar.gz -C /tmp
    cd /tmp/R-4.6.0
    ./configure --prefix=/opt/R --enable-R-shlib --with-x=no --with-cairo=yes --with-readline=no --without-recommended-packages --without-blas --without-lapack
    make -j4
    make install
    cd /
    rm -rf /tmp/R-4.6.0 /tmp/R.tar.gz /var/lib/apt/lists/*

%test
    /opt/R/bin/Rscript -e 'stopifnot(capabilities("cairo")); stopifnot(all(vapply(c("Rcpp","gpuinfo","testthat","rmarkdown"),requireNamespace,logical(1),quietly=TRUE))); print(sessionInfo())'
